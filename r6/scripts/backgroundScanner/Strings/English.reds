        this.Text("Kdsp-Npc-JohnQuaid-ThreatAssessment", "MODERATE | May be armed");
        this.Text("Kdsp-Npc-DariusMiles-Classification", "CRIMINAL - NCPD TARGET");
        this.Text("Kdsp-Npc-DariusMiles-Background", "NCPD scanner target. Known criminal operating in Night City streets.");
        this.Text("Kdsp-Npc-DariusMiles-CriminalRecord", "NCPD PRIORITY | Gang activity suspected | Violent crimes");
        this.Text("Kdsp-Npc-DariusMiles-ThreatAssessment", "HIGH | Armed | Street-level criminal");
        this.Text("Kdsp-Npc-PaulCraven-Classification", "CRIMINAL - NCPD TARGET");
        this.Text("Kdsp-Npc-PaulCraven-Background", "Criminal subject in NCPD database. Outstanding warrants.");
        this.Text("Kdsp-Npc-PaulCraven-CriminalRecord", "NCPD WARRANT | Criminal charges pending");
        this.Text("Kdsp-Npc-PaulCraven-ThreatAssessment", "MODERATE | Standard threat level");
        this.Text("Kdsp-Npc-OlgaLongmead-Classification", "CRIMINAL - NCPD TARGET");
        this.Text("Kdsp-Npc-OlgaLongmead-Background", "Female criminal flagged during NCPD operation. Full name: Olga Elisabeth Longmead.");
        this.Text("Kdsp-Npc-OlgaLongmead-CriminalRecord", "NCPD WARRANT | Criminal activity");
        this.Text("Kdsp-Npc-OlgaLongmead-ThreatAssessment", "MODERATE | Armed female suspect | Approach cautiously");
        this.Text("Kdsp-Npc-MikeKowalsky-Classification", "CRIMINAL - NCPD TARGET");
        this.Text("Kdsp-Npc-MikeKowalsky-Background", "NCPD scanner target. Polish-American background. Night City criminal.");
        this.Text("Kdsp-Npc-MikeKowalsky-CriminalRecord", "NCPD PRIORITY | Violent offenses");
        this.Text("Kdsp-Npc-MikeKowalsky-ThreatAssessment", "HIGH | Armed and dangerous");
        this.Text("Kdsp-Npc-SamanthaSamu-Classification", "CRIMINAL - NCPD TARGET");
        this.Text("Kdsp-Npc-SamanthaSamu-Background", "Female criminal in NCPD database. Active in Night City underworld.");
        this.Text("Kdsp-Npc-SamanthaSamu-CriminalRecord", "NCPD WARRANT | Outstanding charges");
        this.Text("Kdsp-Npc-SamanthaSamu-ThreatAssessment", "MODERATE | Suspect may be armed");
        this.Text("Kdsp-Npc-BarryAlken-Classification", "CRIMINAL - NCPD TARGET");
        this.Text("Kdsp-Npc-BarryAlken-Background", "Criminal flagged in NCPD scanner system. Not to be confused with NCPD Officer Barry.");
        this.Text("Kdsp-Npc-BarryAlken-CriminalRecord", "NCPD WARRANT | Criminal activity");
        this.Text("Kdsp-Npc-BarryAlken-ThreatAssessment", "MODERATE | Armed suspect");
        this.Text("Kdsp-Npc-MokomichiYamada-Classification", "CRIMINAL - NCPD TARGET");
        this.Text("Kdsp-Npc-MokomichiYamada-Background", "Japanese male flagged in NCPD scanner. Criminal operations potentially linked to Tyger Claws territory.");
        this.Text("Kdsp-Npc-MokomichiYamada-CriminalRecord", "NCPD PRIORITY | Gang affiliation suspected | Criminal enterprise");
        this.Text("Kdsp-Npc-MokomichiYamada-ThreatAssessment", "HIGH | Possible Tyger Claws connection | Armed | Melee weapons likely");
        this.Text("Kdsp-Npc-BigPete-Classification", "TECHIE - WRAITH AFFILIATE");
        this.Text("Kdsp-Npc-BigPete-Background", "Pete Kowalski, known as Big Pete. Manager of New American Autoworks garage in the southern Badlands near the border. Former Night City technician who made powerful enemies and fled to the desert. Now survives by keeping Wraith vehicles running.");
        this.Text("Kdsp-Npc-BigPete-EarlyLife", "Started as street-level techie in Night City. Had a knack for electronics and signal equipment. Made a name selling custom jammers and tech to mercs and fixers. Career ended badly when a faulty signal jammer he sold got someone important killed.");
        this.Text("Kdsp-Npc-BigPete-Affiliation", "Wraiths (Raffen Shiv)");
        this.Text("Kdsp-Npc-BigPete-CriminalRecord", "WANTED IN NC | Fraud | Negligent homicide (equipment failure) | Multiple civil suits | Fled jurisdiction");
        this.Text("Kdsp-Npc-BigPete-Relationships", "Tiny Mike (Brother - merc operating in Night City, estranged)");
        this.Text("Kdsp-Npc-BigPete-Notes", "Cowardly | Self-preservation focused | Will say anything to survive | Not built for violence");
        this.Text("Kdsp-Npc-BigPete-FinancialStatus", "Desperate | Constantly begging brother for eddies | Living paycheck to paycheck on Wraith mechanic work");
        this.Text("Kdsp-Npc-BigPete-ThreatAssessment", "LOW | Non-combatant | Mechanic, not fighter | No cyberware of note | Will negotiate and beg under pressure");
        this.Text("Kdsp-Npc-BruceWelby-Classification", "SMUGGLER - BADLANDS");
        this.Text("Kdsp-Npc-BruceWelby-Background", "Career smuggler who has been moving cargo across the Night City-SoCal border for over a decade. Specializes in 'hot' goods - items too dangerous or illegal to move through official channels. Known for reliability and discretion.");
        this.Text("Kdsp-Npc-BruceWelby-EarlyLife", "Grew up in the Badlands. Learned smuggling routes from family. Built network of contacts on both sides of the border and both sides of the law. Reputation for always delivering, no matter the cargo.");
        this.Text("Kdsp-Npc-BruceWelby-CriminalRecord", "EXTENSIVE | Smuggling | Border violations | Contraband transport | Tax evasion | Multiple arrests, few convictions");
        this.Text("Kdsp-Npc-BruceWelby-Relationships", "Archibald Crane (Close friend - Militech employee who occasionally helps with border crossings)");
        this.Text("Kdsp-Npc-BruceWelby-Notes", "Professional | Calm under pressure | Loyal to friends | Knows when to keep his mouth shut");
    }

    private func DefineTexts9() -> Void {
        this.Text("Kdsp-Npc-BruceWelby-FinancialStatus", "Comfortable | Good income from smuggling work | Invests in maintaining border contacts");
        this.Text("Kdsp-Npc-BruceWelby-ThreatAssessment", "LOW | Smuggler, not fighter | Prefers to run rather than fight | Value in border knowledge and contacts");
        this.Text("Kdsp-Npc-BenedictMcAdams-Classification", "MERCENARY - PROFESSIONAL");
        this.Text("Kdsp-Npc-BenedictMcAdams-Background", "Reliable, professional mercenary who built his reputation in the Badlands. Known for clean, efficient work and absolute discretion. Unusual practice of installing GPS tracker in his own biomon to prove accountability to clients.");
        this.Text("Kdsp-Npc-BenedictMcAdams-EarlyLife", "Military background suspected but unconfirmed. Transitioned to mercenary work in his thirties. Built reputation through consistent, professional performance. Never takes jobs he can't complete.");
        this.Text("Kdsp-Npc-BenedictMcAdams-Affiliation", "Independent operator");
        this.Text("Kdsp-Npc-BenedictMcAdams-CriminalRecord", "CLASSIFIED | Records sealed | Multiple suspected contract killings | No convictions | Professional enough to avoid evidence");
        this.Text("Kdsp-Npc-BenedictMcAdams-Notes", "Disciplined | Methodical | Zero ego | Treats killing as profession, not passion");
        this.Text("Kdsp-Npc-BenedictMcAdams-CyberwareStatus", "Standard combat suite | GPS biomon (voluntary) | Neural processor | Sandevistan suspected");
        this.Text("Kdsp-Npc-BenedictMcAdams-ThreatAssessment", "EXTREME | Professional killer | Combat trained | Disciplined operator | Do not engage without preparation");
        this.Text("Kdsp-Npc-IrisTanner-Classification", "TECHIE - BADLANDS SPECIALIST");
        this.Text("Kdsp-Npc-IrisTanner-Background", "Considered the best technical specialist in the Badlands. Can fix anything mechanical - vehicles, water filters, generators, solar arrays, you name it. Has saved entire communities during equipment failures. Unfortunately, her skill with machines doesn't extend to reading people.");
        this.Text("Kdsp-Npc-IrisTanner-EarlyLife", "Self-taught mechanical genius. Grew up taking apart and rebuilding anything she could find. Built reputation by keeping Badlands communities running when corporate repair was too expensive or too far away.");
        this.Text("Kdsp-Npc-IrisTanner-CriminalRecord", "CLEAN | Legitimate technician | No criminal history");
        this.Text("Kdsp-Npc-IrisTanner-Notes", "Brilliant with machines | Naive with people | Trusts too easily | Cannot read ulterior motives | Gets taken advantage of");
        this.Text("Kdsp-Npc-IrisTanner-FinancialStatus", "Modest | Undercharges for work | Often paid in trade or favors");
        this.Text("Kdsp-Npc-IrisTanner-ThreatAssessment", "NONE | Civilian | Non-combatant | Absolutely no combat training | Valuable for technical skills only");
        this.Text("Kdsp-Npc-JackMausser-Classification", "MERCENARY - CLUB OWNER");
        this.Text("Kdsp-Npc-JackMausser-Background", "Solo turned club owner who couldn't leave the violence behind. Became addicted to the adrenaline of killing - not for money, but for the rush. Recently purchased 7th Hell, a seedy club in City Center, and hired Animals for security. Still takes jobs, but they've become increasingly brutal.");
        this.Text("Kdsp-Npc-JackMausser-EarlyLife", "Started as competent merc. Over time, developed taste for violence that went beyond professional necessity. Prefers making targets scream rather than quick, clean kills. Reputation shifted from 'effective' to 'psychotic'.");
        this.Text("Kdsp-Npc-JackMausser-Affiliation", "Independent | Animals (security arrangement for his club)");
        this.Text("Kdsp-Npc-JackMausser-CriminalRecord", "MULTIPLE HOMICIDES | Excessive force | Property destruction | Decapitations | Made enemies of multiple corporations through brutality");
        this.Text("Kdsp-Npc-JackMausser-Notes", "Adrenaline junkie | Addicted to violence | Cannot control impulses | Knows he's making enemies | Doesn't care");
        this.Text("Kdsp-Npc-JackMausser-FinancialStatus", "Wealthy | Club ownership | Mercenary income | Spending heavily on Animals protection");
        this.Text("Kdsp-Npc-JackMausser-CyberwareStatus", "Extensive combat augmentation | Reflex boosters | Sandevistan likely | Pain editors");
        this.Text("Kdsp-Npc-JackMausser-ThreatAssessment", "EXTREME | Combat specialist | Animals backup on premises | Unpredictable | Psychotic tendencies | Owns 7th Hell club in City Center");
        this.Text("Kdsp-Npc-JoanneKoch-Classification", "BIOTECHNICA EXECUTIVE");
        this.Text("Kdsp-Npc-JoanneKoch-Background", "Dr. Joanne Koch. Regional Director for Technology and Development at Biotechnica. Genetics engineer whose 'unscrupulous' reputation stands out even among corporate scientists. Responsible for Project Nightingale - an experimental program that killed over 70 nomads from the Red Ocher clan during unauthorized field testing.");
        this.Text("Kdsp-Npc-JoanneKoch-EarlyLife", "Rose through Biotechnica ranks by delivering results regardless of ethical cost. Uses citizens as test subjects. Has ordered hits on employees who threatened her position. No moral boundaries in pursuit of scientific breakthrough.");
        this.Text("Kdsp-Npc-JoanneKoch-Affiliation", "Biotechnica (Executive level)");
        this.Text("Kdsp-Npc-JoanneKoch-CriminalRecord", "CORPORATE PROTECTED | Human experimentation | 70+ deaths (Red Ocher clan) | Test subject coercion | Evidence suppression | Protected by Biotechnica legal");
        this.Text("Kdsp-Npc-JoanneKoch-Notes", "Sociopathic | No moral reservations | Views human life as expendable research material | Trail of bodies rivals professional killers");
        this.Text("Kdsp-Npc-JoanneKoch-FinancialStatus", "Extremely wealthy | Corporate executive salary | Biotechnica Hotel penthouse residence | Extensive security budget");
        this.Text("Kdsp-Npc-JoanneKoch-ThreatAssessment", "LOW personally | HIGH via corporate security | Robotics and armed guards | 19th floor penthouse | Biotechnica response team on call");
        this.Text("Kdsp-Npc-EvaCole-Classification", "POLITICIAN - NIGHT CITY");
        this.Text("Kdsp-Npc-EvaCole-Background", "Night City politician who has made powerful enemies by actually trying to enforce regulations against corporate illegal activities. One of the few politicians who hasn't been completely bought. This has made her both admired and endangered.");
        this.Text("Kdsp-Npc-EvaCole-CriminalRecord", "CLEAN | No criminal history | Anti-corruption stance");
        this.Text("Kdsp-Npc-EvaCole-Notes", "Idealistic | Genuinely believes in rule of law | Willing to challenge corporations | Naive about depth of corruption");
        this.Text("Kdsp-Npc-EvaCole-FinancialStatus", "Modest for politician | Refuses most 'contributions' | Limited security budget");
        this.Text("Kdsp-Npc-EvaCole-ThreatAssessment", "NONE personally | Politician with limited security | Multiple corporate enemies");
        this.Text("Kdsp-Npc-TuckerAlbach-Classification", "CORPORATE - KIROSHI OPTICS");
        this.Text("Kdsp-Npc-TuckerAlbach-Background", "Lucy Montgomery Tucker Albach. Former Vice Managing Director at Kiroshi Optics. Removed from the board by CEO Jacob Lan following a hit-and-run incident. Lives in an apartment in The Glen, Heywood. Her corporate insurance has protected her from prosecution despite clear evidence of guilt.");
        this.Text("Kdsp-Npc-TuckerAlbach-EarlyLife", "Rose to VP level at Kiroshi Optics through competence and connections. Lived the corpo lifestyle - fast cars, expensive tastes, complete disconnection from consequences.");
        this.Text("Kdsp-Npc-TuckerAlbach-Affiliation", "Kiroshi Optics (Former executive - removed from board but still protected)");
        this.Text("Kdsp-Npc-TuckerAlbach-CriminalRecord", "VEHICULAR MANSLAUGHTER | Hit and run while intoxicated | Victim: Rosita Fuscino, age 17 | Left victim to die | NCPD investigation blocked by corporate insurance | No prosecution");
        this.Text("Kdsp-Npc-TuckerAlbach-Notes", "Entitled | Believes money can solve any problem | Zero remorse | Completely detached from consequences of actions");
        this.Text("Kdsp-Npc-TuckerAlbach-FinancialStatus", "Wealthy | Corporate severance | Maintains expensive lifestyle | Safe containing valuables");
        this.Text("Kdsp-Npc-TuckerAlbach-ThreatAssessment", "NONE personally | Non-combatant | Will attempt to bribe her way out of any situation | Some security in building");
        this.Text("Kdsp-Npc-RebecaPrice-Classification", "SHOP OWNER - COERCED");
        this.Text("Kdsp-Npc-RebecaPrice-Background", "Runs Data Inc. store in Wellsprings, Heywood. On the surface, a legitimate cyberware retailer. In reality, being forced to sell stolen Militech equipment through unofficial channels. Not a willing criminal - operating under extreme duress.");
        this.Text("Kdsp-Npc-RebecaPrice-Affiliation", "Animals (Coerced - not voluntary)");
        this.Text("Kdsp-Npc-RebecaPrice-CriminalRecord", "CYBERWARE TRAFFICKING | Selling stolen Militech goods | Operating as fence | All under duress");
        this.Text("Kdsp-Npc-RebecaPrice-Relationships", "Family member (Identity protected - held as leverage by Animals)");
        this.Text("Kdsp-Npc-RebecaPrice-Notes", "Terrified | Desperate | Trapped | Only cooperating because family member's life at stake");
        this.Text("Kdsp-Npc-RebecaPrice-FinancialStatus", "Store provides income | Most profit goes to Animals | Living in fear");
        this.Text("Kdsp-Npc-RebecaPrice-ThreatAssessment", "NONE | Shop owner | Non-combatant | Victim of circumstances | No combat capability");
        this.Text("Kdsp-Npc-KaruboBairei-Classification", "CRIMINAL - JAPANTOWN");
        this.Text("Kdsp-Npc-KaruboBairei-Background", "Japanese criminal operating in Japantown. Suspected ties to Tyger Claws operations, though affiliation unconfirmed. Involved in protection rackets and illegal gambling.");
        this.Text("Kdsp-Npc-KaruboBairei-Affiliation", "Tyger Claws (Suspected)");
        this.Text("Kdsp-Npc-KaruboBairei-CriminalRecord", "EXTORTION | Illegal gambling | Protection rackets | Assault | Japantown operations");
        this.Text("Kdsp-Npc-KaruboBairei-Notes", "Traditional values | Honor-focused | Violent when disrespected");
        this.Text("Kdsp-Npc-KaruboBairei-ThreatAssessment", "MODERATE | Possible gang backup | Likely melee specialist | Tyger Claw combat training probable");
        this.Text("Kdsp-Npc-JakeEstevez-Classification", "CRIMINAL - STREET LEVEL");
        this.Text("Kdsp-Npc-JakeEstevez-Background", "Street-level criminal operating in Night City. Small-time operator who handles various illegal jobs - theft, smuggling, occasional muscle work. Not affiliated with major gangs, prefers to stay independent.");
        this.Text("Kdsp-Npc-JakeEstevez-CriminalRecord", "MULTIPLE OFFENSES | Theft | Smuggling | Assault | Operates independently");
        this.Text("Kdsp-Npc-JakeEstevez-Notes", "Opportunistic | Self-interested | Avoids major gang conflicts | Knows his limits");
        this.Text("Kdsp-Npc-JakeEstevez-ThreatAssessment", "MODERATE | Armed | Street-smart | Will fight if cornered");
        this.Text("Kdsp-Npc-JoseLuis-Classification", "VALENTINOS - ROGELIO'S CREW");
        this.Text("Kdsp-Npc-JoseLuis-Background", "José Luis. Valentino gang member, part of Rogelio's crew in Heywood. Shot and killed an NCPD officer during a confrontation. Investigation was mysteriously dropped and officers told to back off - suggesting powerful protection from outside the gang.");
        this.Text("Kdsp-Npc-JoseLuis-EarlyLife", "Grew up in Heywood. Joined Valentinos young. Rose through Rogelio's crew. Developed connections that extend beyond typical gang networks.");
        this.Text("Kdsp-Npc-JoseLuis-Affiliation", "Valentinos (Rogelio's crew)");
        this.Text("Kdsp-Npc-JoseLuis-CriminalRecord", "COP KILLER | Shot NCPD officer | Investigation dropped | Protected by unknown high-level contacts");
        this.Text("Kdsp-Npc-JoseLuis-Relationships", "Roberto Luis (Grandfather - elderly, requires care) | Rogelio (Crew leader)");
        this.Text("Kdsp-Npc-JoseLuis-Notes", "Loyal to crew | Cares for grandfather | Cold when necessary | Has connections above his station");
        this.Text("Kdsp-Npc-JoseLuis-ThreatAssessment", "HIGH | Valentino combat training | Armed | Gang backup | Powerful protectors");
        this.Text("Kdsp-Npc-GustavoOrta-Classification", "VALENTINOS - LEADERSHIP");
        this.Text("Kdsp-Npc-GustavoOrta-Background", "High-ranking Valentino, blood relative of imprisoned gang leader Campo Orta. Built reputation as one of the most ruthless enforcers in Heywood - known for systematically eliminating rival gang presence. Recently, something changed. He's become more contemplative, less quick to violence.");
        this.Text("Kdsp-Npc-GustavoOrta-EarlyLife", "Grew up in Heywood alongside Jackie Welles. Both were Valentinos as teenagers. While Jackie eventually left gang life, Gustavo embraced it fully and climbed to the top through brutal efficiency. Childhood friendship with Jackie remained despite different paths.");
        this.Text("Kdsp-Npc-GustavoOrta-Affiliation", "Valentinos (Leadership tier)");
        this.Text("Kdsp-Npc-GustavoOrta-CriminalRecord", "VALENTINO ENFORCER | Multiple homicides | Gang warfare | Rival elimination | Recently inactive");
        this.Text("Kdsp-Npc-GustavoOrta-Relationships", "Campo Orta (Blood relative - gang leader, imprisoned) | Jackie Welles (Childhood friend - paths diverged) | Martha Frakes (Girlfriend - complicated)");
        this.Text("Kdsp-Npc-GustavoOrta-Notes", "Formerly ruthless | Recently changed | More thoughtful | Spends time contemplating rather than killing | Love may have softened him");
        this.Text("Kdsp-Npc-GustavoOrta-ThreatAssessment", "EXTREME | Veteran killer | Gang leadership | Armed guards | But recently non-violent");
        this.Text("Kdsp-Npc-MarthaFrakes-Classification", "CIVILIAN - DIVIDED LOYALTIES");
        this.Text("Kdsp-Npc-MarthaFrakes-Background", "Daughter of Nolan Frakes, senior member of 6th Street. Defected from her family and gang to pursue a relationship with Valentino leader Gustavo Orta. Living between two rival gang worlds that would normally kill each other on sight.");
        this.Text("Kdsp-Npc-MarthaFrakes-EarlyLife", "Raised in 6th Street culture. Father is senior gang member. Expected to marry within the gang. Rebelled against everything by falling for a Valentino leader - the worst possible choice from her family's perspective.");
        this.Text("Kdsp-Npc-MarthaFrakes-Affiliation", "6th Street (Family) | Valentinos (Through relationship)");
        this.Text("Kdsp-Npc-MarthaFrakes-CriminalRecord", "CLEAN | No personal charges | Family gang connections only");
        this.Text("Kdsp-Npc-MarthaFrakes-Relationships", "Nolan Frakes (Father - 6th Street, furious about relationship) | Gustavo Orta (Boyfriend - Valentinos)");
        this.Text("Kdsp-Npc-MarthaFrakes-Notes", "Rebellious | Strong-willed | Chose love over family | Living in constant danger from both sides");
        this.Text("Kdsp-Npc-MarthaFrakes-ThreatAssessment", "NONE | Civilian | No combat training | Value only as leverage");
        this.Text("Kdsp-Npc-AnthonyAnderson-Classification", "CRIMINAL");
        this.Text("Kdsp-Npc-AnthonyAnderson-Background", "Criminal operator in Night City. Involved in various illegal enterprises. Keeps low profile, avoids major gang territories.");
        this.Text("Kdsp-Npc-AnthonyAnderson-CriminalRecord", "MULTIPLE CHARGES | Theft | Fencing | Minor assault");
        this.Text("Kdsp-Npc-AnthonyAnderson-ThreatAssessment", "MODERATE | Potentially armed | Street-level threat");
        this.Text("Kdsp-Npc-MilkoAlexis-Classification", "CRIMINAL - EASTERN EUROPEAN");
        this.Text("Kdsp-Npc-MilkoAlexis-Background", "Eastern European criminal with suspected connections to Scavenger operations. May be involved in cyberware trafficking given known associates and operational patterns.");
        this.Text("Kdsp-Npc-MilkoAlexis-Affiliation", "Scavengers (Suspected)");
        this.Text("Kdsp-Npc-MilkoAlexis-CriminalRecord", "TRAFFICKING suspected | Cyberware theft | Eastern European criminal network ties");
        this.Text("Kdsp-Npc-MilkoAlexis-ThreatAssessment", "MODERATE | Armed | Potentially Scavenger tactics | Ruthless if cornered");
        this.Text("Kdsp-Npc-LeonRinder-Classification", "BARGHEST - FORMER TRIGGERMAN");
        this.Text("Kdsp-Npc-LeonRinder-Background", "Leon Rinder. One of Kurt Hansen's former triggermen. Discharged from BARGHEST under unclear circumstances. Responsible for the massacre of eight civilians in the Longshore Stacks, including a young man named Jason Foreman. Currently hiding in an abandoned motel in Pacifica, guarded by a single elite bodyguard.");
        this.Text("Kdsp-Npc-LeonRinder-EarlyLife", "Military background funneled into BARGHEST private military service. Rose through Hansen's ranks as a reliable enforcer. Something broke — the massacre in the Stacks was not an ordered hit. The question is what caused him to snap.");
        this.Text("Kdsp-Npc-LeonRinder-Affiliation", "BARGHEST (Former — discharged)");
        this.Text("Kdsp-Npc-LeonRinder-CriminalRecord", "MASS MURDER | Eight civilian deaths in Longshore Stacks | Former BARGHEST enforcement operations | Possible cyberpsychosis-related violence");
        this.Text("Kdsp-Npc-LeonRinder-MedicalStatus", "CRITICAL — CYBERPSYCHOSIS INDICATORS | Memory gaps surrounding massacre | Cannot recall killing anyone | Classic dissociative symptoms consistent with advanced cyberware rejection");
        this.Text("Kdsp-Npc-LeonRinder-CyberwareStatus", "HEAVY MILITARY-GRADE | Extensive combat augmentation from BARGHEST service | Possible contributing factor to psychological deterioration");
        this.Text("Kdsp-Npc-LeonRinder-Relationships", "Kurt Hansen (Former commander — discharged him) | Yasha Ivanov (Bodyguard — loyal) | Briana Dolson (Community representative — wants him dead) | Longshore Stacks community (Victims' families — seeking justice)");
        this.Text("Kdsp-Npc-LeonRinder-Notes", "May not fully understand what he did | Offers his dog tags and stash location in exchange for his life | Stash contains Dezerter iconic shotgun | Can be referred to Regina Jones for cyberpsychosis treatment if identified");
        this.Text("Kdsp-Npc-LeonRinder-ThreatAssessment", "HIGH | Former military elite | Heavy cyberware | Bodyguard Yasha Ivanov must be defeated first | Unstable — cyberpsychosis makes behavior unpredictable");
        this.Text("Kdsp-Npc-JasmineDixon-Classification", "CIVILIAN");
        this.Text("Kdsp-Npc-JasmineDixon-Background", "Night City resident. Limited public information available.");
        this.Text("Kdsp-Npc-JasmineDixon-CriminalRecord", "CLEAN");
        this.Text("Kdsp-Npc-JasmineDixon-ThreatAssessment", "LOW | Non-combatant");
        this.Text("Kdsp-Npc-JulietHorrigan-Classification", "NETRUNNER");
        this.Text("Kdsp-Npc-JulietHorrigan-Background", "Skilled netrunner specializing in corporate data extraction, particularly from Zetatech systems. Lives with her sister Rose in their family home on Gibson Street, Rancho Coronado. Valued for reliable, clean data work.");
        this.Text("Kdsp-Npc-JulietHorrigan-EarlyLife", "Developed netrunning expertise through self-study and practice. Built reputation for Zetatech penetration specifically. Takes care of her sister Rose, who has been struggling with mental health issues.");
        this.Text("Kdsp-Npc-JulietHorrigan-CriminalRecord", "CORPORATE ESPIONAGE | Zetatech data theft | No violent crimes");
        this.Text("Kdsp-Npc-JulietHorrigan-Relationships", "Rose Horrigan (Sister - lives together, concerning behavior recently) | Viktor Vektor (Medical contact - consulted about sister)");
        this.Text("Kdsp-Npc-JulietHorrigan-MedicalStatus", "Healthy | No significant issues");
        this.Text("Kdsp-Npc-JulietHorrigan-Notes", "Caring | Devoted to sister | Professional in work | Worried about Rose's deteriorating condition");
        this.Text("Kdsp-Npc-JulietHorrigan-FinancialStatus", "Comfortable | Regular income from data work | Family home owner");
        this.Text("Kdsp-Npc-JulietHorrigan-ThreatAssessment", "LOW | Netrunner, not fighter | Value in data extraction skills");
        this.Text("Kdsp-Npc-LoganGarcia-Classification", "ANIMALS - FIGHT CLUB");
        this.Text("Kdsp-Npc-LoganGarcia-Background", "Runs the Tripple Xtreme Epic Workout Center - an Animals-backed underground fight club in an old paint factory in Rancho Coronado. Former fighter who still gets in the ring regularly. Known for not knowing when to stop - has beaten opponents long past the point of surrender.");
        this.Text("Kdsp-Npc-LoganGarcia-EarlyLife", "Started as fighter in underground circuit. Rose to run his own club with Animals gang backing. Fighting is his identity - he lives for the violence of the ring.");
        this.Text("Kdsp-Npc-LoganGarcia-Affiliation", "Animals");
        this.Text("Kdsp-Npc-LoganGarcia-CriminalRecord", "ASSAULT | Multiple ring deaths | Excessive force | Body disposal (suspected) | Protected by Animals");
        this.Text("Kdsp-Npc-LoganGarcia-Notes", "Cannot control aggression | No concept of 'too far' | Views weakness with contempt | Dangerous in any confrontation");
        this.Text("Kdsp-Npc-LoganGarcia-CyberwareStatus", "Animals-standard muscle and bone augmentation | Pain editor likely | Combat reflexes");
        this.Text("Kdsp-Npc-LoganGarcia-ThreatAssessment", "EXTREME | Animals combat augments | Professional fighter | Gang backup at club | Will not back down");
        this.Text("Kdsp-Npc-FlaviodosSantos-Classification", "6TH STREET - OUTCAST");
        this.Text("Kdsp-Npc-FlaviodosSantos-Background", "Former 6th Street member who backed the wrong side during Will Gunner's coup. Was loyal to the previous leadership and found himself on the losing team when Gunner took over. Known for reckless confidence and a belief in his own invincibility despite mounting evidence to the contrary.");
        this.Text("Kdsp-Npc-FlaviodosSantos-EarlyLife", "Rose through 6th Street ranks under old leadership. Loyal soldier, not a leader. When the coup happened, he was on the wrong list. Has survived through luck more than skill.");
        this.Text("Kdsp-Npc-FlaviodosSantos-Affiliation", "6th Street (Former - marked by current leadership)");
        this.Text("Kdsp-Npc-FlaviodosSantos-CriminalRecord", "GANG ACTIVITY | 6th Street operations | Currently hunted by own former gang");
        this.Text("Kdsp-Npc-FlaviodosSantos-Notes", "Reckless | Dangerously overconfident | Believes in his own luck | Throws parties while being hunted | Cannot take situations seriously");
        this.Text("Kdsp-Npc-FlaviodosSantos-FinancialStatus", "Unstable | Burning through savings | Spending on parties instead of security");
        this.Text("Kdsp-Npc-FlaviodosSantos-ThreatAssessment", "LOW | Non-combatant | Injured | More danger to himself than others");
        this.Text("Kdsp-Npc-VicVega-Classification", "CORPORATE SECURITY - C-TEAM");
        this.Text("Kdsp-Npc-VicVega-Background", "Head of C-Team, a private security company that specializes in corporate union-busting and worker intimidation. Has been terrorizing workers in Rancho Coronado on behalf of corporate clients. Lists 'cracking skulls' as a hobby on his employee profile.");
        this.Text("Kdsp-Npc-VicVega-EarlyLife", "Corporate security background. Rose to lead C-Team through willingness to do what others wouldn't. Found his calling in causing pain for pay.");
        this.Text("Kdsp-Npc-VicVega-Affiliation", "C-Team (Leadership) | Various corporate clients (confidential)");
        this.Text("Kdsp-Npc-VicVega-CriminalRecord", "ASSAULT | Union busting | Worker intimidation | Multiple injuries caused | All charges blocked by corporate legal backing");
        this.Text("Kdsp-Npc-VicVega-Notes", "Sadistic | Genuinely enjoys inflicting pain | No moral qualms | Views workers as subhuman | Violence is pleasure, not just business");
        this.Text("Kdsp-Npc-VicVega-CyberwareStatus", "Corporate security standard | Combat augments | Pain tolerance mods");
        this.Text("Kdsp-Npc-VicVega-ThreatAssessment", "HIGH | Corporate security training | Violent tendencies | C-Team backup available");
        this.Text("Kdsp-Npc-RohChiWon-Classification", "BOXING COACH - PROFESSIONAL");
        this.Text("Kdsp-Npc-RohChiWon-Background", "Roh Chi-Won (노지원). Former professional boxer with dozens of wins. Now works as personal boxing coach for high-profile clients, most notably Macidew Coolidge of N54's 'Boxathon' fame.");
        this.Text("Kdsp-Npc-RohChiWon-EarlyLife", "Successful competitive boxing career in youth. Transitioned to coaching after retirement from the ring. Developed reputation as trainer who could turn anyone into a fighter.");
        this.Text("Kdsp-Npc-RohChiWon-CriminalRecord", "CLEAN | No criminal history | Professional athlete background");
        this.Text("Kdsp-Npc-RohChiWon-Relationships", "Macidew Coolidge (Client - N54 sports commentator)");
        this.Text("Kdsp-Npc-RohChiWon-Notes", "Disciplined | Patient teacher | Dedicated to craft | Loyal to clients");
        this.Text("Kdsp-Npc-RohChiWon-ThreatAssessment", "MODERATE | Boxing skills | No longer in fighting shape | Non-combatant mindset");
        this.Text("Kdsp-Npc-TinyMike-Classification", "MERCENARY - INDEPENDENT");
        this.Text("Kdsp-Npc-TinyMike-Background", "Mike Kowalski, known as Tiny Mike. Street kid turned merc who built his reputation from nothing. Joined Tyger Claws at age 11, was dealing by 12, left at 15 to go independent. Now works for various fixers across Night City.");
        this.Text("Kdsp-Npc-TinyMike-EarlyLife", "Raised on Night City streets. Learned early that only two things matter: keeping your word and cold hard cash. Dozens of scars and close calls later, achieved recognition from fixers citywide.");
        this.Text("Kdsp-Npc-TinyMike-Affiliation", "Independent | Former Tyger Claws");
        this.Text("Kdsp-Npc-TinyMike-CriminalRecord", "EXTENSIVE | Drug dealing (juvenile) | Multiple assault charges | B&E | Survived numerous gang conflicts");
        this.Text("Kdsp-Npc-TinyMike-Relationships", "Big Pete (Brother - mechanic in Badlands) | Christine Markov (Ex-girlfriend - Cherry Blossom Market vendor)");
        this.Text("Kdsp-Npc-TinyMike-MedicalStatus", "Elbow joints repaired by Charles Bucks");
        this.Text("Kdsp-Npc-TinyMike-Notes", "Street smart | Loyal to family despite frustration | Keeps his word | Values cash");
        this.Text("Kdsp-Npc-TinyMike-ThreatAssessment", "HIGH | Combat experienced | Survived Tyger Claws | Quick reflexes");
        this.Text("Kdsp-Npc-BryceStone-Classification", "MEDIA - TELEVANGELIST");
        this.Text("Kdsp-Npc-BryceStone-Background", "Television minister with significant following in Night City. Public figure known for religious broadcasting. Has experienced personal tragedy that has driven him to seek justice outside official channels.");
        this.Text("Kdsp-Npc-BryceStone-EarlyLife", "Built career as televangelist. Accumulated wealth and influence through religious media programming.");
        this.Text("Kdsp-Npc-BryceStone-CriminalRecord", "CLEAN | Public figure | No criminal record");
        this.Text("Kdsp-Npc-BryceStone-Relationships", "Bobby Stone (Son - deceased)");
        this.Text("Kdsp-Npc-BryceStone-FinancialStatus", "Wealthy | Television ministry income | Willing to spend on personal matters");
        this.Text("Kdsp-Npc-BryceStone-Notes", "Grieving father | Driven by need for justice | Willing to work outside the law to find answers");
        this.Text("Kdsp-Npc-BryceStone-ThreatAssessment", "NONE | Non-combatant | Value in resources and connections");
        this.Text("Kdsp-Npc-HwangboDongGun-Classification", "CRIMINAL - FORMER TYGER CLAWS");
        this.Text("Kdsp-Npc-HwangboDongGun-Background", "Hwangbo Dong-Gun (황보동건). Korean male, former low-level Tyger Claws associate. Got greedy, got caught stealing from his superiors. Now marked for death by the gang he used to work for.");
        this.Text("Kdsp-Npc-HwangboDongGun-EarlyLife", "Did small-time work for Tyger Claws. Instead of keeping his head down and being patient, took a shortcut by stealing from his own gang. Left evidence that pointed directly to him.");
        this.Text("Kdsp-Npc-HwangboDongGun-Affiliation", "Tyger Claws (Former - marked for death)");
        this.Text("Kdsp-Npc-HwangboDongGun-CriminalRecord", "THEFT | Stole from Tyger Claws | Gang activity | Now hunted by former associates");
        this.Text("Kdsp-Npc-HwangboDongGun-Notes", "Reckless | Short-sighted | Surprisingly upbeat despite situation | Gives people nicknames");
        this.Text("Kdsp-Npc-HwangboDongGun-ThreatAssessment", "LOW | Non-combatant | More danger to himself | Tyger Claws actively hunting him");
        this.Text("Kdsp-Npc-MaxJones-Classification", "MEDIA - INVESTIGATIVE JOURNALIST");
        this.Text("Kdsp-Npc-MaxJones-Background", "Independent journalist specializing in exposing corporate scandals. Former colleague of Regina Jones from her muckraking days. Known for being stubborn as they come and thinking he's invincible.");
        this.Text("Kdsp-Npc-MaxJones-EarlyLife", "Built career as investigative journalist. Co-wrote podcast with Regina Jones about independent farmers put out of business by Biotechnica drones. Continued kicking hornet's nests after Regina moved on.");
        this.Text("Kdsp-Npc-MaxJones-CriminalRecord", "CLEAN | Journalist | Multiple corporate enemies");
        this.Text("Kdsp-Npc-MaxJones-Relationships", "Regina Jones (Old friend and former colleague - no longer takes her calls)");
        this.Text("Kdsp-Npc-MaxJones-Notes", "Stubborn | Lost touch with reality | Thinks he can manage on his own | Young male bravado");
        this.Text("Kdsp-Npc-MaxJones-ThreatAssessment", "NONE | Non-combatant | Multiple enemies want him dead | Doesn't realize the danger he's in");
        this.Text("Kdsp-Npc-AloisDaquin-Classification", "CORPORATE - KANG TAO");
        this.Text("Kdsp-Npc-AloisDaquin-Background", "Kang Tao employee who betrayed multiple people in Night City, including fixer Regina Jones. Known as a 'corpo megaprick' who cheated his way through business dealings. Made enough enemies that an entire city wants a piece of him.");
        this.Text("Kdsp-Npc-AloisDaquin-Affiliation", "Kang Tao");
        this.Text("Kdsp-Npc-AloisDaquin-CriminalRecord", "FRAUD | Corporate espionage | Betrayal | Multiple civil suits | Fled jurisdiction");
        this.Text("Kdsp-Npc-AloisDaquin-Notes", "Treacherous | Self-serving | No loyalty | Left gear behind when fleeing");
        this.Text("Kdsp-Npc-AloisDaquin-ThreatAssessment", "LOW | Non-combatant | Corporate suit | More enemies than friends");
        this.Text("Kdsp-Npc-HalCantos-Classification", "TECHIE - BD TUNER");
        this.Text("Kdsp-Npc-HalCantos-Background", "Freelance braindance tuner, considered a 'known quantity' in Watson. Former WNS news employee until he was terminated for fraud. Now does street gigs exclusively, tuning and editing braindances for various clients.");
        this.Text("Kdsp-Npc-HalCantos-EarlyLife", "Worked for WNS news as BD technician. Got caught committing fraud and was fired. Transitioned to street-level BD work.");
        this.Text("Kdsp-Npc-HalCantos-Affiliation", "Independent | Former WNS News");
        this.Text("Kdsp-Npc-HalCantos-CriminalRecord", "FRAUD | Terminated from WNS | Various street-level offenses");
        this.Text("Kdsp-Npc-HalCantos-Notes", "Skilled technician | Morally flexible | Works for whoever pays");
        this.Text("Kdsp-Npc-HalCantos-ThreatAssessment", "NONE | Non-combatant | Technical skills only | Value in BD expertise");
        this.Text("Kdsp-Npc-BlakeCroyle-Classification", "CRIMINAL - LOAN SHARK");
        this.Text("Kdsp-Npc-BlakeCroyle-Background", "Racketeering specialist operating in Kabuki. Uses debt schemes to trap victims - offers promising money deals, creates unpayable debts, then seizes ownership of their businesses. Currently has Animals muscle watching his back.");
        this.Text("Kdsp-Npc-BlakeCroyle-EarlyLife", "Built criminal enterprise on predatory lending and racketeering. NCPD badges in the area turn blind eye because of payoffs.");
        this.Text("Kdsp-Npc-BlakeCroyle-Affiliation", "Animals (Protection)");
        this.Text("Kdsp-Npc-BlakeCroyle-CriminalRecord", "RACKETEERING | Fraud | Extortion | Property seizure | Protected by corrupt NCPD");
        this.Text("Kdsp-Npc-BlakeCroyle-Relationships", "Roger Wang (Recent victim - store chain owner)");
        this.Text("Kdsp-Npc-BlakeCroyle-Notes", "Predatory | Calculated | No empathy for victims | Patient manipulator");
        this.Text("Kdsp-Npc-BlakeCroyle-FinancialStatus", "Wealthy | Income from seized businesses | Pays for Animals protection");
        this.Text("Kdsp-Npc-BlakeCroyle-ThreatAssessment", "HIGH via Animals | Personal combat ability unknown | Has muscle on site");
        this.Text("Kdsp-Npc-JaeHyunLee-Classification", "CRIMINAL - HUMAN TRAFFICKER");
        this.Text("Kdsp-Npc-JaeHyunLee-Background", "Jae-Hyun Lee (이재현). Human trafficker who preys on Night City's most vulnerable - outcasts, loners, rejects, people society has failed. Identifies targets, kidnaps them, delivers them to Scavengers for cyberware removal. Victims are stripped of their identities and sold as 'property'.");
        this.Text("Kdsp-Npc-JaeHyunLee-EarlyLife", "Unknown origins. Built network for acquiring and trafficking vulnerable people. Works with Scavengers and XBD producers like Jotaro Shobo.");
        this.Text("Kdsp-Npc-JaeHyunLee-CriminalRecord", "HUMAN TRAFFICKING | Kidnapping | Conspiracy | Works with Scavengers | Supplies victims to Jotaro Shobo");
        this.Text("Kdsp-Npc-JaeHyunLee-Relationships", "Jotaro Shobo (Client - receives 'product')");
        this.Text("Kdsp-Npc-JaeHyunLee-Notes", "Predatory | Targets society's forgotten | Views humans as merchandise | No empathy");
        this.Text("Kdsp-Npc-JaeHyunLee-ThreatAssessment", "MODERATE | Not a fighter | Has guards | Operates from Kabuki rooftops");
        this.Text("Kdsp-Npc-LucyThackery-Classification", "RIPPERDOC - LEGITIMATE");
        this.Text("Kdsp-Npc-LucyThackery-Background", "Licensed ripperdoc operating from Clean Cut clinic. Since childhood, dreamed of saving people's lives. Put herself through extensive training in anatomy, microanatomy, biochemistry, physiology and robotics. Installed long-term memory enhancement, hand stabilizer, and medical antibodies.");
        this.Text("Kdsp-Npc-LucyThackery-EarlyLife", "Held onto dream of becoming ripperdoc since childhood. Hundreds of hours of study. Brother Bertie got mixed up with Maelstrom.");
        this.Text("Kdsp-Npc-LucyThackery-CriminalRecord", "CLEAN | Licensed medical professional");
        this.Text("Kdsp-Npc-LucyThackery-Relationships", "Bertie Thackery (Brother - former Maelstrom associate)");
        this.Text("Kdsp-Npc-LucyThackery-MedicalStatus", "Self-installed medical cyberware for profession | Long-term memory | Hand stabilizer | Medical antibodies");
        this.Text("Kdsp-Npc-LucyThackery-Notes", "Compassionate | Dedicated to helping people | Worried about brother | Professional");
        this.Text("Kdsp-Npc-LucyThackery-ThreatAssessment", "NONE | Medical professional | Non-combatant | Value in ripperdoc skills");
        this.Text("Kdsp-Npc-NinaKraviz-Classification", "RIPPERDOC - LICENSED");
        this.Text("Kdsp-Npc-NinaKraviz-Background", "Nina Kraviz. Licensed ripperdoc operating from Kraviz's Clinic, Charter Hill, Westbrook. Soviet-born. Internationally experienced - previously ran clinics in Irkutsk, Leningrad, Vienna, and Glasgow before relocating to Night City.");
        this.Text("Kdsp-Npc-NinaKraviz-EarlyLife", "Trained in the Soviet Union. Former dental background before transitioning to cybersurgery. Earned full ripperdoc certification through extensive practical experience across multiple cities and countries.");
        this.Text("Kdsp-Npc-NinaKraviz-SignificantEvents", "Pattern of short-term clinic residencies across Europe and Asia. Relocates when 'bored' - her word. Current Night City clinic is operated from her uncle's premises in Charter Hill. Describes Night City as 'wonderful' - fascinated by the constant demand for medical services.");
        this.Text("Kdsp-Npc-NinaKraviz-Affiliation", "Independent | Kraviz's Clinic, Charter Hill, Westbrook");
        this.Text("Kdsp-Npc-NinaKraviz-CriminalRecord", "Status: CLEAN | Fully licensed | No complaints on file | NCPD: NO FILE");
        this.Text("Kdsp-Npc-NinaKraviz-CyberwareStatus", "Implants: 4 | Status: MODERATE | Surgical-grade optics, precision hand stabilizers, dental-to-cyber adapted toolset");
        this.Text("Kdsp-Npc-NinaKraviz-FinancialStatus", "Income: Ripperdoc services (Charter Hill rates) | Clinic leased from uncle | Westbrook clientele - above average income bracket");
        this.Text("Kdsp-Npc-NinaKraviz-MedicalStatus", "Blood: A RhD- | Health: GOOD | No conditions on file | Trauma Team: SILVER");
        this.Text("Kdsp-Npc-NinaKraviz-ThreatAssessment", "NONE (0/100) | Medical professional | Non-combatant | Valued community asset");
        this.Text("Kdsp-Npc-NinaKraviz-Relationships", "Uncle (Clinic owner, previous ripperdoc at this location) | Charter Hill client roster | No known gang affiliations");
        this.Text("Kdsp-Npc-NinaKraviz-Notes", "Well-traveled, restless personality. Moves on when a city stops being interesting. Currently content in Night City - finds the violence-driven demand for medical services 'fascinating.' Skilled practitioner with an unusual dental background. Blunt manner - speaks her mind regardless of patient feelings.");
        this.Text("Kdsp-Npc-JotaroShobo-Classification", "TYGER CLAWS - HIGH RANKING");
        this.Text("Kdsp-Npc-JotaroShobo-Background", "Jotaro Shobo (正法承太郎). High-ranking Tyger Claws member, owner of Ho-Oh club in Kabuki. Known as 'The Devil of Kabuki' for his side business - producing the most violent XBDs imaginable. At least seventeen confirmed murders, mostly joytoys who disappeared without anyone looking for them.");
        this.Text("Kdsp-Npc-JotaroShobo-EarlyLife", "Rose quickly through Tyger Claws through intelligence, loyalty and ruthlessness. Rules lackeys with iron fist. Never late with cuts to bosses. Gang provides protection and turns blind eye to his 'hobbies'.");
        this.Text("Kdsp-Npc-JotaroShobo-Affiliation", "Tyger Claws (High Ranking)");
        this.Text("Kdsp-Npc-JotaroShobo-CriminalRecord", "SERIAL KILLER | 17+ murders | XBD snuff production | Human trafficking | Torture | Protected by Tyger Claws");
        this.Text("Kdsp-Npc-JotaroShobo-Relationships", "Jae-Hyun Lee (Supplier - provides victims)");
        this.Text("Kdsp-Npc-JotaroShobo-Notes", "Sadistic | Gets off on suffering | Coldly efficient in gang business | The Mox consider him their primary enemy");
        this.Text("Kdsp-Npc-JotaroShobo-FinancialStatus", "Wealthy | Ho-Oh club income | XBD production profits");
        this.Text("Kdsp-Npc-JotaroShobo-ThreatAssessment", "HIGH | Tyger Claws protection | Armed guards | Ho-Oh club is fortified | Casino second floor");
        this.Text("Kdsp-Npc-TakiKenmochi-Classification", "TYGER CLAWS - OPERATOR");
        this.Text("Kdsp-Npc-TakiKenmochi-Background", "Tyger Claws gang member who runs a pachinko operation in Kabuki. Small operation but strategically placed. Red hair, blue and pink jacket, white shoes - easy to identify.");
        this.Text("Kdsp-Npc-TakiKenmochi-Affiliation", "Tyger Claws");
        this.Text("Kdsp-Npc-TakiKenmochi-CriminalRecord", "ILLEGAL GAMBLING | Tyger Claws operations | Pachinko racket");
        this.Text("Kdsp-Npc-TakiKenmochi-Notes", "Gang loyal | Runs tight operation | Not leadership material");
        this.Text("Kdsp-Npc-TakiKenmochi-ThreatAssessment", "MODERATE | Tyger Claws training | Armed | Gang backup possible");
        this.Text("Kdsp-Npc-MikhailAkulov-Classification", "FIXER - SOVIET UNION");
        this.Text("Kdsp-Npc-MikhailAkulov-Background", "Mikhail Sergeievich Akulov (Михаил Сергеевич Акулов). The top fixer in the Soviet Union. Traveled to Night City in 2077 ostensibly on a diplomatic business trip. His presence has generated enormous buzz - a premier Soviet fixer personally handling business in Night City raises questions.");
        this.Text("Kdsp-Npc-MikhailAkulov-EarlyLife", "Rose to fame as USSR's most connected fixer. Has network spanning Soviet territories. First time operating on American soil.");
        this.Text("Kdsp-Npc-MikhailAkulov-Affiliation", "Soviet Union (Government connected)");
        this.Text("Kdsp-Npc-MikhailAkulov-CriminalRecord", "CLASSIFIED | Soviet intelligence connections | Diplomatic immunity claims");
        this.Text("Kdsp-Npc-MikhailAkulov-Relationships", "Nadezhda Tiurina (Bodyguard/companion) | Shelma (Netrunner - status unknown)");
        this.Text("Kdsp-Npc-MikhailAkulov-FinancialStatus", "Extremely wealthy | Soviet government backing | Staying at Hotel Raito penthouse");
        this.Text("Kdsp-Npc-MikhailAkulov-Notes", "Calculating | Professional | Accustomed to power | May be seduced by Night City's freedom and capitalism");
        this.Text("Kdsp-Npc-MikhailAkulov-ThreatAssessment", "HIGH | Heavy Soviet security | Diplomatic complications | Professional bodyguards | Hotel Raito penthouse");
        this.Text("Kdsp-Npc-AnnaHamill-Classification", "NCPD - PATROL OFFICER");
        this.Text("Kdsp-Npc-AnnaHamill-Background", "Blue-blooded cop, through and through. The kind you'd expect in an NCPD recruitment promo - beautiful, smart, honest to a fault. In other words, a really bad fit for Night City. One of the few genuinely good cops trying to make a difference.");
        this.Text("Kdsp-Npc-AnnaHamill-EarlyLife", "Joined NCPD with genuine desire to serve and protect. Refused bribes and kickbacks that her colleagues accepted freely. Became known for being against any form of injustice.");
        this.Text("Kdsp-Npc-AnnaHamill-Affiliation", "NCPD (Active but isolated)");
        this.Text("Kdsp-Npc-AnnaHamill-CriminalRecord", "CLEAN | Model officer | No corruption");
        this.Text("Kdsp-Npc-AnnaHamill-Notes", "Idealistic | Quick tempered | Impulsive | Persistent despite hostility | Doesn't know when to quit");
        this.Text("Kdsp-Npc-AnnaHamill-FinancialStatus", "Modest | Lives on NCPD salary | Renting apartment above Kabuki Market for undercover work");
        this.Text("Kdsp-Npc-AnnaHamill-ThreatAssessment", "MODERATE | NCPD training | Armed | But making powerful enemies among her own colleagues");
        this.Text("Kdsp-Npc-BeatriceEllenTrieste-Classification", "NETRUNNER - FREELANCE");
        this.Text("Kdsp-Npc-BeatriceEllenTrieste-Background", "Beatrice Ellen Trieste, better known by her handle '8ug8ear'. Skilled netrunner living in Japantown. Associate of Wakako Okada and has worked with Tyger Claws on various jobs. Published opinion piece critiquing the after-effects of the DataKrash brought about by Rache Bartmoss.");
        this.Text("Kdsp-Npc-BeatriceEllenTrieste-EarlyLife", "Developed netrunning skills over years. Built reputation in Japantown as reliable technical specialist. Academic interest in Net history and the DataKrash.");
        this.Text("Kdsp-Npc-BeatriceEllenTrieste-Affiliation", "Wakako Okada (Associate) | Tyger Claws (Contract work)");
        this.Text("Kdsp-Npc-BeatriceEllenTrieste-CriminalRecord", "NETRUNNING | Corporate system intrusion | Data theft | Works with gang elements");
        this.Text("Kdsp-Npc-BeatriceEllenTrieste-Notes", "Technically skilled | Opportunistic | Self-preserving | Academic interest in Net history");
        this.Text("Kdsp-Npc-BeatriceEllenTrieste-CyberwareStatus", "Full netrunning suite | Neural interface | Ice breakers");
        this.Text("Kdsp-Npc-BeatriceEllenTrieste-ThreatAssessment", "HIGH via Net | Physical threat minimal | Dangerous in cyberspace");
        this.Text("Kdsp-Npc-SergeiKarasinsky-Classification", "SOLO - INDEPENDENT");
        this.Text("Kdsp-Npc-SergeiKarasinsky-Background", "Russian solo operating in Night City. Has a reputation for acting before thinking - a characteristic that has landed him in trouble more than once. Known to panic when things go wrong, which makes him willing to pay well for help.");
        this.Text("Kdsp-Npc-SergeiKarasinsky-EarlyLife", "Background in solo work. Has history with Tyger Claws that has not always been smooth. Currently on their bad side.");
        this.Text("Kdsp-Npc-SergeiKarasinsky-Affiliation", "Independent | Tyger Claws (Strained relationship)");
        this.Text("Kdsp-Npc-SergeiKarasinsky-CriminalRecord", "ASSAULT | Kidnapping | Various solo work | Currently trying to make amends with Tyger Claws");
        this.Text("Kdsp-Npc-SergeiKarasinsky-Notes", "Impulsive | Acts before thinking | Panics under pressure | Desperate | Willing to pay for solutions");
        this.Text("Kdsp-Npc-SergeiKarasinsky-FinancialStatus", "Moderate | Pays well when panicked | Money 'flying out of his account'");
        this.Text("Kdsp-Npc-SergeiKarasinsky-ThreatAssessment", "MODERATE | Solo skills | But judgment problems make him dangerous to be around");
        this.Text("Kdsp-Npc-ChangHoonNam-Classification", "NETRUNNER - PROFESSIONAL");
        this.Text("Kdsp-Npc-ChangHoonNam-Background", "Chang-Hoon Nam (남창훈). 65-year-old veteran netrunner, hand-picked by Wakako Okada years ago. Hasn't let her down once. Known for being dependable and knowing exactly what's expected of him. Operates from basement hideout beneath restaurant in Japantown.");
        this.Text("Kdsp-Npc-ChangHoonNam-EarlyLife", "Decades of netrunning experience. Built reputation as reliable, methodical operator. Sees himself as bundle of contradictions - ambition vs aloofness, desire to help vs self-preservation, hunger for knowledge vs wanting peace.");
        this.Text("Kdsp-Npc-ChangHoonNam-Affiliation", "Wakako Okada (Primary client)");
        this.Text("Kdsp-Npc-ChangHoonNam-CriminalRecord", "NETRUNNING | Corporate intrusion | Data extraction | Long career with no major incidents");
        this.Text("Kdsp-Npc-ChangHoonNam-Relationships", "Wakako Okada (Employer - hand-picked associate) | Spectral Kid (Mentored - deceased) | Dante (Acquaintance - trapped in Net)");
        this.Text("Kdsp-Npc-ChangHoonNam-Notes", "Dependable | Methodical | Sentimental | Effective but tame | Likes knowing what's expected | Will take calculated risks");
        this.Text("Kdsp-Npc-ChangHoonNam-CyberwareStatus", "Professional netrunning suite | Decades of optimization | Code and daemons match his personality - effective but tame");
        this.Text("Kdsp-Npc-ChangHoonNam-ThreatAssessment", "HIGH via Net | Physical threat minimal | Experienced and careful");
        this.Text("Kdsp-Npc-LaurenCostigan-Classification", "CIVILIAN - NON-COMBATANT");
        this.Text("Kdsp-Npc-LaurenCostigan-Background", "Wife of Bradley Costigan. Ordinary civilian caught up in her husband's past. Bradley is currently incarcerated and his old associations have put Lauren in a difficult position through no fault of her own.");
        this.Text("Kdsp-Npc-LaurenCostigan-EarlyLife", "Married Bradley Costigan. Lived normal civilian life until husband's imprisonment brought unwanted attention from his former associates.");
        this.Text("Kdsp-Npc-LaurenCostigan-CriminalRecord", "CLEAN | No criminal record | Victim of circumstance");
        this.Text("Kdsp-Npc-LaurenCostigan-Relationships", "Bradley Costigan (Husband - imprisoned)");
        this.Text("Kdsp-Npc-LaurenCostigan-Notes", "Innocent civilian | Traumatized by circumstances | Resilient | Has family support network");
        this.Text("Kdsp-Npc-LaurenCostigan-ThreatAssessment", "NONE | Non-combatant | No combat training | Vulnerable");
        this.Text("Kdsp-Npc-NikaYankovich-Classification", "SCAVENGER - DOGTOWN CELL");
        this.Text("Kdsp-Npc-NikaYankovich-Background", "Nika Yankovich. Twin sister of Gaspar Yankovich. Scavenger operating in Dogtown. Unusual among her crew — held in high regard because she actually cares about something beyond chrome and eddies. Family.");
        this.Text("Kdsp-Npc-NikaYankovich-EarlyLife", "Raised alongside twin brother Gaspar. Despite being born minutes apart, always assumed the role of protective older sister. When Gaspar developed an addiction to immunosuppressants, Nika blamed herself. Before she could force him into rehab, he vanished in Dogtown.");
        this.Text("Kdsp-Npc-NikaYankovich-Affiliation", "Scavengers - Dogtown");
        this.Text("Kdsp-Npc-NikaYankovich-CriminalRecord", "SCAVENGER OPERATIONS | Organ/implant harvesting | Breaking and entering | Armed intimidation | Hostage situation at Haven Clinic, Montaña de Oro Ave");
        this.Text("Kdsp-Npc-NikaYankovich-Relationships", "Gaspar Yankovich (Twin brother - missing) | Tim Brent (Associate - dealer, owes Gaspar eddies) | Scavenger crew (Loyal)");
        this.Text("Kdsp-Npc-NikaYankovich-Notes", "Fiercely protective of family | Emotional | Dangerous when desperate | Last known lead on Gaspar pointed to Haven Clinic");
        this.Text("Kdsp-Npc-NikaYankovich-ThreatAssessment", "MODERATE-HIGH | Armed and volatile | Will escalate when cornered | Scav backup nearby");
        this.Text("Kdsp-Npc-OdellBlanco-Classification", "CIVILIAN - CLERGY");
        this.Text("Kdsp-Npc-OdellBlanco-Background", "Father Odell Blanco. Pastor operating out of Haven Clinic, an abandoned church on Montaña de Oro Ave in Dogtown. Partners with a local ripperdoc to provide medical care and used implants to those who can't afford Trauma Team — which in Dogtown means everyone.");
        this.Text("Kdsp-Npc-OdellBlanco-EarlyLife", "Called to service in one of Night City's most godless districts. Survives on donations and goodwill. Built Haven Clinic into a lifeline for Longshore Stacks residents who have nowhere else to turn.");
        this.Text("Kdsp-Npc-OdellBlanco-CriminalRecord", "CLEAN | No criminal record");
        this.Text("Kdsp-Npc-OdellBlanco-Relationships", "Anthony Anderson (Partner - ripperdoc at Haven Clinic) | Father Graeff (Correspondence - clergy contact) | Haven Clinic patients (Congregation)");
        this.Text("Kdsp-Npc-OdellBlanco-Notes", "Genuinely altruistic | Pragmatic faith | Refuses to abandon Dogtown | Will call in outside help when overwhelmed");
        this.Text("Kdsp-Npc-OdellBlanco-ThreatAssessment", "NONE | Non-combatant | Unarmed | High community value");
        this.Text("Kdsp-Npc-AnthonyAndersonRipper-Classification", "RIPPERDOC - UNLICENSED");
        this.Text("Kdsp-Npc-AnthonyAndersonRipper-Background", "Dr. Anthony Anderson. Ripperdoc operating out of Haven Clinic, a converted church in Dogtown's Longshore Stacks. Known for providing used implants and medical care to residents who can't pay. One of Dogtown's few genuinely charitable figures — though even saints have secrets in this district.");
        this.Text("Kdsp-Npc-AnthonyAndersonRipper-EarlyLife", "Medical background. Chose to set up practice in Dogtown rather than pursue corporate clients. Partnered with Father Odell Blanco to establish Haven Clinic as a community resource.");
        this.Text("Kdsp-Npc-AnthonyAndersonRipper-Affiliation", "Haven Clinic - Longshore Stacks");
        this.Text("Kdsp-Npc-AnthonyAndersonRipper-CriminalRecord", "UNLICENSED MEDICAL PRACTICE | Unregistered implant installation | Use of salvaged/secondhand cyberware | Possible medical ethics violations — details classified");
        this.Text("Kdsp-Npc-AnthonyAndersonRipper-Relationships", "Odell Blanco (Partner - clergy) | Tara Anderson (Wife) | Haven Clinic patients (Dependents)");
        this.Text("Kdsp-Npc-AnthonyAndersonRipper-CyberwareStatus", "Standard ripperdoc toolkit | Diagnostic optics | Surgical suite in clinic basement");
        this.Text("Kdsp-Npc-AnthonyAndersonRipper-Notes", "Outwardly selfless | Morally complex | Barricades when threatened | Patients depend on his survival");
        this.Text("Kdsp-Npc-AnthonyAndersonRipper-ThreatAssessment", "LOW | Non-combatant | Medical professional | High community value — loss would devastate local healthcare");
        this.Text("Kdsp-Npc-HasanDemir-Classification", "ZETATECH - TECHIE (AWOL)");
        this.Text("Kdsp-Npc-HasanDemir-Background", "Hasan Demir. Former Zetatech engineer specializing in prototype ocular systems. Clever and convincing, capable of bold moves — but consistently underestimates how his audacity drives him toward perilous situations. Currently AWOL from Zetatech with corporate property in his possession.");
        this.Text("Kdsp-Npc-HasanDemir-EarlyLife", "Dedicated his career to Zetatech. Years of service left him feeling undercompensated for his contributions. Resentment built until he decided to take what he felt he was owed.");
        this.Text("Kdsp-Npc-HasanDemir-Affiliation", "Zetatech (Former — deserted)");
        this.Text("Kdsp-Npc-HasanDemir-CriminalRecord", "CORPORATE THEFT | Unauthorized removal of prototype hardware | Breach of Zetatech employment contract | Misappropriation of proprietary technology");
        this.Text("Kdsp-Npc-HasanDemir-CyberwareStatus", "PROTOTYPE ZETATECH OCULAR IMPLANT — self-installed | Experimental tech of immense value | Industry analysts suggest potential to rival Kiroshi Optics product line");
        this.Text("Kdsp-Npc-HasanDemir-Relationships", "Zetatech (Former employer — actively searching for him) | Mr. Hands (Fixer — contract involvement)");
        this.Text("Kdsp-Npc-HasanDemir-Notes", "Intelligent but reckless | Talks his way out of corners | Self-installed experimental chrome — either brilliant or suicidal | Scavengers took interest in his prototype");
        this.Text("Kdsp-Npc-HasanDemir-ThreatAssessment", "LOW-MODERATE | Non-combatant | High-value target to multiple parties | Prototype makes him a walking payday");
        this.Text("Kdsp-Npc-BillMitchel-Classification", "NCPD - OFFICER");
        this.Text("Kdsp-Npc-BillMitchel-Background", "Officer Bill Mitchel. NCPD. The epitome of mediocrity. Mediocre dreams, mediocre needs, and an overall mediocre life. His attempts to break out of this pattern are plain to see. Husband of Stella Ramos.");
        this.Text("Kdsp-Npc-BillMitchel-EarlyLife", "Joined NCPD because a friend suggested it. Never learned how to say no. Career defined by going along with whatever path of least resistance presented itself.");
        this.Text("Kdsp-Npc-BillMitchel-Affiliation", "NCPD");
        this.Text("Kdsp-Npc-BillMitchel-CriminalRecord", "OFFICER FILE | Internal affairs: PENDING REVIEW | Possible connections to BARGHEST drug operations in Coastview — investigation ongoing");
        this.Text("Kdsp-Npc-BillMitchel-Relationships", "Stella Ramos (Wife) | Charles Wilson (Partner - NCPD) | Carl 'Dodger' Robinson (BARGHEST — adversarial)");
        this.Text("Kdsp-Npc-BillMitchel-Notes", "Risk-averse | People-pleaser | Terrible liar | Aspires to something more but lacks the spine | Dreams of opening a food stand");
        this.Text("Kdsp-Npc-BillMitchel-ThreatAssessment", "LOW | Standard NCPD sidearm | Unlikely to initiate combat | Will follow stronger personalities");
        this.Text("Kdsp-Npc-CharlesWilson-Classification", "NCPD - OFFICER");
        this.Text("Kdsp-Npc-CharlesWilson-Background", "Officer Charles Wilson. NCPD. Partner of Bill Mitchel. Currently assigned to Dogtown-adjacent operations. The more competent half of the Mitchel-Wilson unit, though that's a low bar.");
        this.Text("Kdsp-Npc-CharlesWilson-EarlyLife", "NCPD career officer. Paired with Bill Mitchel. More capable than his partner but dragged into the same compromising situations.");
        this.Text("Kdsp-Npc-CharlesWilson-Affiliation", "NCPD");
        this.Text("Kdsp-Npc-CharlesWilson-CriminalRecord", "OFFICER FILE | Internal affairs: PENDING REVIEW | Linked to same BARGHEST entanglement as partner Mitchel");
        this.Text("Kdsp-Npc-CharlesWilson-Relationships", "Bill Mitchel (Partner - NCPD) | Stella Ramos (Friend - Bill's wife) | Carl 'Dodger' Robinson (BARGHEST — adversarial)");
        this.Text("Kdsp-Npc-CharlesWilson-Notes", "More competent than Mitchel | Pragmatic | Better under pressure | Still managed to end up in the same mess");
        this.Text("Kdsp-Npc-CharlesWilson-ThreatAssessment", "LOW | Standard NCPD equipment | Marginally more effective than partner");
        this.Text("Kdsp-Npc-CarlRobinson-Classification", "BARGHEST - LIEUTENANT");
        this.Text("Kdsp-Npc-CarlRobinson-Background", "Carl 'Dodger' Robinson. High-ranking BARGHEST operator. If you want to escape your past, you go to Night City. If the past catches up, you flee to the Badlands. If several pasts all want you dead — you hop to Dogtown and pray Hansen likes you. Dodger's prayers were answered.");
        this.Text("Kdsp-Npc-CarlRobinson-EarlyLife", "Multiple criminal histories across jurisdictions. Fled to Dogtown after burning bridges with NCPD, Tyger Claws, and nomad clans simultaneously. Hansen saw value in his skills and took him in.");
        this.Text("Kdsp-Npc-CarlRobinson-Affiliation", "BARGHEST");
        this.Text("Kdsp-Npc-CarlRobinson-CriminalRecord", "THREE LIFE SENTENCES (NCPD — outstanding) | Grave insult to prominent Tyger Claws boss | Robbery of nomad clan — several million eddies | Drug manufacturing and distribution in Coastview");
        this.Text("Kdsp-Npc-CarlRobinson-Relationships", "Kurt Hansen (Commander — patron) | BARGHEST soldiers (Subordinates) | NCPD, Tyger Claws, Nomads (Enemies — all actively hostile)");
        this.Text("Kdsp-Npc-CarlRobinson-CyberwareStatus", "Combat-grade BARGHEST implants | Reflexes tuned for close-quarters | Armed and chrome-heavy");
        this.Text("Kdsp-Npc-CarlRobinson-Notes", "Ruthless | Entertained by audacity | Runs drug ops from converted NCPD precinct | Three separate factions want him dead | Carries iconic Rosco revolver");
        this.Text("Kdsp-Npc-CarlRobinson-ThreatAssessment", "HIGH | Armed combatant | BARGHEST backup on-site | Multiple bodyguards | Do not underestimate");
        this.Text("Kdsp-Npc-BrianaDolson-Classification", "CIVILIAN - COMMUNITY LEADER");
        this.Text("Kdsp-Npc-BrianaDolson-Background", "Briana Dolson. Longshore Stacks' unofficial representative. Organizes community vigils and acts as the voice of residents who have no one else to speak for them. Currently seeking justice for eight civilians killed in a massacre by a former BARGHEST triggerman.");
        this.Text("Kdsp-Npc-BrianaDolson-EarlyLife", "Rose to prominence in Longshore Stacks through sheer force of will. When nobody else stepped up, Briana did. Became the person the community turns to when Dogtown's violence hits home.");
        this.Text("Kdsp-Npc-BrianaDolson-CriminalRecord", "CLEAN | No criminal record | Contracted mercenary services through Mr. Hands for community protection");
        this.Text("Kdsp-Npc-BrianaDolson-Relationships", "Longshore Stacks community (Dependents) | Mr. Hands (Fixer — hired merc on her behalf) | Jason Foreman (Victim — community member, murdered)");
        this.Text("Kdsp-Npc-BrianaDolson-Notes", "Strong-willed | Expects results | Protective of her community | Will not forgive easily | Meets only during evening vigils (22:00-06:00)");
        this.Text("Kdsp-Npc-BrianaDolson-ThreatAssessment", "NONE | Non-combatant | Political influence within Longshore Stacks");
        this.Text("Kdsp-Npc-StevenSantos-Classification", "BIA - RISK ASSESSMENT SPECIALIST");
        this.Text("Kdsp-Npc-StevenSantos-Background", "Steven Santos. Brazilian Intelligence Agency. Risk assessment specialist. A patriot willing to sacrifice much for his country — perhaps not his life, but at the very least his self-respect. Knows when a mission is in jeopardy, and when to look the other way and keep things under wraps.");
        this.Text("Kdsp-Npc-StevenSantos-EarlyLife", "Rose through BIA ranks as a dependable, if morally flexible, operative. The kind of man who says 'if I don't do it, someone else will' and 'that's just how the system works.' When his conscience gets too murky, he makes an effort to clean it up. Just not too clean.");
        this.Text("Kdsp-Npc-StevenSantos-Affiliation", "Brazilian Intelligence Agency");
        this.Text("Kdsp-Npc-StevenSantos-CriminalRecord", "CLASSIFIED | BIA operative | Operating in Dogtown without official agency authorization");
        this.Text("Kdsp-Npc-StevenSantos-Relationships", "Ana Friedman (Partner - BIA) | Mark Bana (Mentor/colleague - status unknown) | Mr. Hands (Fixer — contracted V)");
        this.Text("Kdsp-Npc-StevenSantos-Notes", "Pragmatic to a fault | Prioritizes survival over justice | Will undercut his own partner to protect himself | Currently operating off-books in Dogtown");
        this.Text("Kdsp-Npc-StevenSantos-ThreatAssessment", "MODERATE | Intelligence training | Armed | Not a frontline combatant | Dangerous through information rather than firepower");
        this.Text("Kdsp-Npc-AnaFriedman-Classification", "BIA - FIELD AGENT");
        this.Text("Kdsp-Npc-AnaFriedman-Background", "Ana Friedman. Brazilian Intelligence Agency. Field operative partnered with Steven Santos. Currently in Dogtown investigating the reactivation of a colleague's biomonitor signal. Operating without official BIA authorization due to the political sensitivity of the situation.");
        this.Text("Kdsp-Npc-AnaFriedman-EarlyLife", "BIA career agent. Trained under Mark Bana. More idealistic than her partner Santos — believes in doing the right thing even when the system would prefer she didn't.");
        this.Text("Kdsp-Npc-AnaFriedman-Affiliation", "Brazilian Intelligence Agency");
        this.Text("Kdsp-Npc-AnaFriedman-CriminalRecord", "CLASSIFIED | BIA operative | Unauthorized field operation in sovereign Dogtown territory");
        this.Text("Kdsp-Npc-AnaFriedman-Relationships", "Steven Santos (Partner - BIA) | Mark Bana (Mentor - biomonitor signal reactivated) | Mr. Hands (Fixer — contracted V)");
        this.Text("Kdsp-Npc-AnaFriedman-Notes", "Idealistic | Driven by loyalty to fallen colleagues | Will push for truth regardless of cost | Tensions with partner over how far to go");
        this.Text("Kdsp-Npc-AnaFriedman-ThreatAssessment", "MODERATE | Intelligence training | Armed | More willing to take risks than Santos");
        this.Text("Kdsp-Npc-BorisRibakov-Classification", "SOVOIL - ELITE OPERATIVE");
        this.Text("Kdsp-Npc-BorisRibakov-Background", "Boris Ribakov. SovOil corporate black-ops. Elite soldier deployed to Night City on a termination contract. Operates with military precision, advanced stealth technology, and zero regard for collateral damage. Currently embedded in Organitopia, Terra Cognita.");
        this.Text("Kdsp-Npc-BorisRibakov-EarlyLife", "SovOil military pipeline. Trained as tier-one corporate operative. Specializes in high-value target elimination in hostile environments. Scavenger crews in the area answer to him by intimidation.");
        this.Text("Kdsp-Npc-BorisRibakov-Affiliation", "SovOil");
        this.Text("Kdsp-Npc-BorisRibakov-CriminalRecord", "CLASSIFIED — SOVOIL CORPORATE DENIABLE | Contract assassinations | Multiple unauthorized military operations on foreign soil");
        this.Text("Kdsp-Npc-BorisRibakov-CyberwareStatus", "MILITARY-GRADE | Optical camouflage | Sandevistan acceleration | Charge-jump locomotion | Militech Griffin drone deployment system | Holographic decoy projectors");
        this.Text("Kdsp-Npc-BorisRibakov-Relationships", "SovOil (Handler — corporate command) | Scavenger crews (Subordinates — intimidated into compliance)");
        this.Text("Kdsp-Npc-BorisRibakov-Notes", "Apex predator | Uses sniper rifle from elevated positions, switches to Smart SMG at close range | Deploys smoke grenades + flashbangs | Will retreat and re-engage | Carries iconic Pizdets SMG");
        this.Text("Kdsp-Npc-BorisRibakov-ThreatAssessment", "EXTREME | Tier-one combatant | Stealth + heavy firepower | Drone support | Do NOT engage without preparation");
        this.Text("Kdsp-Npc-KatyaKarelina-Classification", "SOVOIL - FORMER INTERROGATOR");
        this.Text("Kdsp-Npc-KatyaKarelina-Background", "Katya Karelina. Former SovOil interrogation specialist. Once part of the corporate machine, now marked for termination by her own employers. Hiding in Organitopia's abandoned museum complex in Terra Cognita. Desperate, resourceful, and willing to trade anything for survival.");
        this.Text("Kdsp-Npc-KatyaKarelina-EarlyLife", "SovOil career operative specializing in information extraction. Participated in interrogations that 'never happened.' When the corporation decided to clean house, she found herself on the wrong side of the ledger.");
        this.Text("Kdsp-Npc-KatyaKarelina-Affiliation", "SovOil (Former — terminated)");
        this.Text("Kdsp-Npc-KatyaKarelina-CriminalRecord", "CLASSIFIED — SOVOIL DENIABLE | Enhanced interrogation | Involvement in deaths of foreign intelligence personnel | Identity fraud | Signal spoofing using stolen biomonitor");
        this.Text("Kdsp-Npc-KatyaKarelina-Relationships", "SovOil (Former employer — actively hunting her) | Boris Ribakov (Assassin — sent to eliminate her) | Olya Sergeeva (Contact)");
        this.Text("Kdsp-Npc-KatyaKarelina-Notes", "Master of deception | Will impersonate others to survive | Knows SovOil secrets worth killing for | Offers stash coordinates as bargaining chip");
        this.Text("Kdsp-Npc-KatyaKarelina-ThreatAssessment", "LOW-MODERATE | Not a frontline combatant | Dangerous through manipulation and information | Valuable intelligence asset");
        this.Text("Kdsp-Npc-Baird-Classification", "NETRUNNER - FREELANCE");
        this.Text("Kdsp-Npc-Baird-Background", "Baird. Freelance netrunner on retainer with Mr. Hands. Specializes in identity fabrication and digital cover stories. Provides operational support for high-profile infiltration gigs throughout Dogtown.");
        this.Text("Kdsp-Npc-Baird-EarlyLife", "Career netrunner. Built reputation as reliable support for fixer operations. Doesn't ask too many questions about the jobs — just makes sure the fake IDs hold up long enough.");
        this.Text("Kdsp-Npc-Baird-Affiliation", "Mr. Hands (Retainer)");
    }

    private func DefineTexts10() -> Void {
        this.Text("Kdsp-Npc-Baird-CriminalRecord", "NETRUNNING | Identity fraud | Digital forgery | Corporate systems intrusion");
        this.Text("Kdsp-Npc-Baird-CyberwareStatus", "Full netrunning suite | Optimized for rapid identity fabrication and systems spoofing");
        this.Text("Kdsp-Npc-Baird-Notes", "Professional | Methodical briefer | Doesn't elaborate beyond what's needed | Creates covers good enough to pass biometric scans");
        this.Text("Kdsp-Npc-Baird-ThreatAssessment", "MODERATE via Net | Minimal physical threat | Support operative, not frontline");
        this.Text("Kdsp-Npc-TommieWalker-Classification", "CIVILIAN - MINOR");
        this.Text("Kdsp-Npc-TommieWalker-Background", "Tommie Walker. Young athlete enrolled at the Center for Neuromotor Development in Dogtown. Son of David Walker, clothing vendor at EBM Petrochem Stadium. One of many Dogtown kids betting everything on a chance to get signed by an off-world sports team and escape the district.");
        this.Text("Kdsp-Npc-TommieWalker-EarlyLife", "Grew up in Dogtown. Father runs a clothing stall at the stadium. Enrolled in Dr. Fiona Vargas' academy — the only shot most Dogtown kids have at leaving. The stakes couldn't be higher: get signed or come out with nothing but cyberware debt.");
        this.Text("Kdsp-Npc-TommieWalker-CriminalRecord", "CLEAN | Minor | No criminal record");
        this.Text("Kdsp-Npc-TommieWalker-Relationships", "David Walker (Father - stadium vendor) | Fiona Vargas (Academy director) | Fellow academy athletes (Peers)");
        this.Text("Kdsp-Npc-TommieWalker-Notes", "Resourceful | Curious | Found places he shouldn't be | The system he's in chews up more kids than it launches");
        this.Text("Kdsp-Npc-TommieWalker-ThreatAssessment", "NONE | Minor | Non-combatant | Protected status");
        this.Text("Kdsp-Npc-FionaVargas-Classification", "CORPORATE - MEDICAL DIRECTOR");
        this.Text("Kdsp-Npc-FionaVargas-Background", "Dr. Fiona Vargas. Head of the Center for Neuromotor Development, Site 341. Extremely talented ripperdoc specializing in cybernetic implants for young athletes. Operates in Dogtown to avoid taxes, regulations, and oversight. Her office walls are covered in medals, trophies, and awards won by the athletes she helped mould.");
        this.Text("Kdsp-Npc-FionaVargas-EarlyLife", "Became a respected ripper in the community quickly. Faced a choice — stay at the hospital and treat patients, or start cybermodifying athletes. Help people, or make money. The trophies on her wall tell you which she chose.");
        this.Text("Kdsp-Npc-FionaVargas-Affiliation", "Center for Neuromotor Development - Site 341");
        this.Text("Kdsp-Npc-FionaVargas-CriminalRecord", "TAX EVASION | Unregulated medical procedures on minors | Operating outside NUSA medical oversight | Scout contract fraud — under investigation by Mr. Hands' client");
        this.Text("Kdsp-Npc-FionaVargas-FinancialStatus", "WEALTHY | International scout contracts | Sizeable transfer fees | All untaxed");
        this.Text("Kdsp-Npc-FionaVargas-Relationships", "Academy athletes (Subjects) | International sports scouts (Clients) | Mr. Hands (Fixer — contract against her operations)");
        this.Text("Kdsp-Npc-FionaVargas-Notes", "Talented and cynical in equal measure | Will negotiate when cornered | Exploits Dogtown kids' desperation for profit | Those who don't get signed are left with cyberware debt their families can't cover");
        this.Text("Kdsp-Npc-FionaVargas-ThreatAssessment", "LOW direct | HIGH indirect | Armed security staff on premises | Will send mercs after threats to her operation");
        this.Text("Kdsp-Npc-MichaelMaldonado-Classification", "CIVILIAN - BUSINESS OWNER");
        this.Text("Kdsp-Npc-MichaelMaldonado-Background", "Michael Maldonado. Small business owner operating beneath The Needle in central Dogtown. A man blessed with two things that go together many a time — a son and trouble. Those who possess very little are the most afraid to lose whatever they love.");
        this.Text("Kdsp-Npc-MichaelMaldonado-EarlyLife", "Built a small business in Dogtown. Raised son Eric in the district. The kind of man who never leaves his shop — not because business is good, but because the world outside keeps getting worse.");
        this.Text("Kdsp-Npc-MichaelMaldonado-Affiliation", "Independent");
        this.Text("Kdsp-Npc-MichaelMaldonado-CriminalRecord", "WITNESS TESTIMONY | Testified against own son Eric Maldonado | Claims testimony was coerced | Details disputed by District Attorney's office");
        this.Text("Kdsp-Npc-MichaelMaldonado-Relationships", "Eric Maldonado (Son - Valentinos member, incarcerated) | Georgina Zembinsky (D.A. — adversarial) | Hank Davis (D.A.'s partner — adversarial) | Mr. Hands (Fixer — hired V)");
        this.Text("Kdsp-Npc-MichaelMaldonado-Notes", "Desperate father | Claims he was tortured into giving false testimony | Story doesn't fully add up | Willing to pay well for someone with very little");
        this.Text("Kdsp-Npc-MichaelMaldonado-ThreatAssessment", "NONE | Non-combatant | Civilian | Financially motivated");
        this.Text("Kdsp-Npc-GeorginaZembinsky-Classification", "DISTRICT ATTORNEY - DOGTOWN");
        this.Text("Kdsp-Npc-GeorginaZembinsky-Background", "Georgina Zembinsky. District Attorney operating out of the Heavy Hearts club in Dogtown. Pursuing a high-profile case involving Valentinos gang activity. Works alongside partner Hank Davis. Frequents the VIP section of Heavy Hearts — one of the few places in Dogtown where the law still pretends to function.");
        this.Text("Kdsp-Npc-GeorginaZembinsky-EarlyLife", "Legal career built in Dogtown's impossible jurisdiction. Learned that justice in this district requires methods the NUSA bar association wouldn't approve of. Has been chasing a serial murderer connected to the Valentinos for two years.");
        this.Text("Kdsp-Npc-GeorginaZembinsky-Affiliation", "Dogtown District Attorney's Office");
        this.Text("Kdsp-Npc-GeorginaZembinsky-CriminalRecord", "NONE ON RECORD | Accusations of coerced testimony — unproven | Allegations of enhanced interrogation techniques — denied | Uses Valentinos informants to build cases");
        this.Text("Kdsp-Npc-GeorginaZembinsky-Relationships", "Hank Davis (Partner/bodyguard) | Michael Maldonado (Witness — adversarial) | Eric Maldonado (Defendant — Valentinos) | Hector Sacristán (Target — high-ranking Valentinos, alleged serial murderer) | Judge Nathaniel Edwards (Correspondence)");
        this.Text("Kdsp-Npc-GeorginaZembinsky-Notes", "Ruthless prosecutor | Believes the ends justify the means | Has video testimony evidence on secure terminal | Willing to negotiate when outmatched | Hank Davis provides physical security");
        this.Text("Kdsp-Npc-GeorginaZembinsky-ThreatAssessment", "LOW direct | Hank Davis serves as armed protection | VIP section of Heavy Hearts has additional security | Political connections make her dangerous to cross");
        this.Text("Kdsp-Npc-JagoSzabo-Classification", "BARGHEST - LIEUTENANT");
        this.Text("Kdsp-Npc-JagoSzabo-Background", "Jago Szabo. Hungarian-born ex-NUSA military officer. One of Kurt Hansen's most trusted lieutenants. Handles Barghest's external negotiations and high-profile arms deals. Known for a polished demeanor that masks ruthless efficiency. The suit he wears to Black Sapphire events costs more than most Dogtown residents earn in a year.");
        this.Text("Kdsp-Npc-JagoSzabo-EarlyLife", "Born in Budapest before the European collapse. Military family. Emigrated to NUSA as a teenager. Enlisted at 18, served in the Unification War under Colonel Hansen. When Hansen defected, Szabo followed without hesitation.");
        this.Text("Kdsp-Npc-JagoSzabo-SignificantEvents", "Unification War veteran. Followed Hansen into Dogtown. Promoted to lieutenant after organizing the Sapphire Arms Expo — Barghest's first public-facing weapons showcase. Now manages all diplomatic functions at the Black Sapphire.");
        this.Text("Kdsp-Npc-JagoSzabo-Affiliation", "Barghest PMC | Kurt Hansen's inner circle");
        this.Text("Kdsp-Npc-JagoSzabo-CriminalRecord", "WANTED - NUSA | Desertion | Arms trafficking | Conspiracy | Multiple counts of murder (wartime, unproven)");
        this.Text("Kdsp-Npc-JagoSzabo-CyberwareStatus", "Military-grade optics | Subdermal armor | Encrypted Barghest comms | Kiroshi upgrade (threat detection)");
        this.Text("Kdsp-Npc-JagoSzabo-FinancialStatus", "AFFLUENT | Arms deal commissions | Black Sapphire revenue share | Hansen's favor");
        this.Text("Kdsp-Npc-JagoSzabo-Relationships", "Kurt Hansen (Commander - loyal) | Chester Bennett (Fellow officer - trusted) | Tyger Claws leadership (Business contacts)");
        this.Text("Kdsp-Npc-JagoSzabo-Notes", "Diplomatic but dangerous | Smiles while negotiating your death | Fluent in five languages | Never seen without a pressed suit in social settings");
        this.Text("Kdsp-Npc-JagoSzabo-ThreatAssessment", "HIGH (75/100) | Combat veteran | Armed at all times | Barghest soldiers on call | Do not underestimate the charm");
        this.Text("Kdsp-Npc-ChesterBennett-Classification", "BARGHEST - OFFICER");
        this.Text("Kdsp-Npc-ChesterBennett-Background", "Chester Bennett. American. Career soldier turned PMC officer. Barghest's logistics and security coordinator for Dogtown's public-facing operations. Responsible for Black Sapphire perimeter security and VIP handling. Where Szabo is the handshake, Bennett is the fist behind it.");
        this.Text("Kdsp-Npc-ChesterBennett-EarlyLife", "Grew up in the ruins of Baltimore after the Unification War tore through the Eastern Seaboard. No family left to speak of. Joined NUSA military at 16 with forged papers. Served under Hansen's command during the final campaigns.");
        this.Text("Kdsp-Npc-ChesterBennett-SignificantEvents", "Baltimore survivor. Unification War veteran. Followed Hansen to Dogtown. Oversaw construction of the Black Sapphire's security infrastructure. Personally vetted every attendee of the first three Sapphire events.");
        this.Text("Kdsp-Npc-ChesterBennett-Affiliation", "Barghest PMC | Security division");
        this.Text("Kdsp-Npc-ChesterBennett-CriminalRecord", "WANTED - NUSA | Desertion | War crimes (alleged) | Smuggling | Racketeering");
        this.Text("Kdsp-Npc-ChesterBennett-CyberwareStatus", "Reinforced skeleton | Gorilla arms | Military-grade optics | Ballistic co-processor");
        this.Text("Kdsp-Npc-ChesterBennett-FinancialStatus", "COMFORTABLE | Barghest officer salary | Black Sapphire security contract");
        this.Text("Kdsp-Npc-ChesterBennett-Relationships", "Kurt Hansen (Commander) | Jago Szabo (Fellow officer - works closely) | Charles Graham (Subordinate - bodyguard detail)");
        this.Text("Kdsp-Npc-ChesterBennett-Notes", "Quiet professional | Watches everything | Prefers actions over words | The kind of soldier who sleeps with one eye open");
        this.Text("Kdsp-Npc-ChesterBennett-ThreatAssessment", "HIGH (72/100) | Combat veteran | Heavy cyberware | Armed | Controls Sapphire security detail");
        this.Text("Kdsp-Npc-CharlesGraham-Classification", "BARGHEST - BODYGUARD");
        this.Text("Kdsp-Npc-CharlesGraham-Background", "Charles Graham. Barghest heavy. Personal bodyguard assigned to Jago Szabo during high-profile events. Built like a tank wrapped in combat armor. Equipped with charge jump legs and flashbang grenades — the kind of firepower you bring when diplomacy fails mid-sentence.");
        this.Text("Kdsp-Npc-CharlesGraham-EarlyLife", "Texas panhandle. Ranch family. Grew up handling cattle and firearms in equal measure. Drifted into mercenary work after drought killed the ranch and his parents with it. Hansen's recruiters found him in a Heywood fight pit.");
        this.Text("Kdsp-Npc-CharlesGraham-SignificantEvents", "Recruited into Barghest from underground fighting circuit. Assigned to VIP protection detail after killing three Scavengers with his bare hands during a supply run. Permanent assignment to Szabo's security.");
        this.Text("Kdsp-Npc-CharlesGraham-Affiliation", "Barghest PMC | VIP protection detail");
        this.Text("Kdsp-Npc-CharlesGraham-CriminalRecord", "WANTED - NUSA | Desertion | Assault | Multiple homicides (combat context) | Unlicensed cyberware modifications");
        this.Text("Kdsp-Npc-CharlesGraham-CyberwareStatus", "Reinforced tendons (charge jump capable) | Gorilla arms | Subdermal armor | Flashbang deployment system | Pain inhibitors");
        this.Text("Kdsp-Npc-CharlesGraham-Relationships", "Jago Szabo (Principal - protective detail) | Chester Bennett (Superior officer)");
        this.Text("Kdsp-Npc-CharlesGraham-Notes", "Minimal conversation | Maximum violence when provoked | Loyal to Szabo specifically, not just Barghest | Eats enough for three people");
        this.Text("Kdsp-Npc-CharlesGraham-ThreatAssessment", "VERY HIGH (80/100) | Heavy combat specialist | Charge jump capability | Flashbang equipped | Will engage immediately if principal threatened");
        this.Text("Kdsp-Npc-JunAzegami-Classification", "TYGER CLAWS - UNDERBOSS");
        this.Text("Kdsp-Npc-JunAzegami-Background", "Jun Azegami (畦上 潤). Senior Tyger Claws underboss overseeing Japantown and Kabuki operations. Represents the Claws' interests at high-level inter-gang negotiations. His presence at the Black Sapphire signals Tyger Claws are looking to expand their reach into Dogtown's arms and XBD markets. Old school yakuza mentality in a chrome-plated world.");
        this.Text("Kdsp-Npc-JunAzegami-EarlyLife", "Born in Chiba, Japan. Son of a mid-ranking Tyger Claws enforcer who operated out of the original Tokyo chapter. Sent to Night City at 19 to apprentice under the NC branch. Rose through the ranks through a combination of business acumen and targeted violence.");
        this.Text("Kdsp-Npc-JunAzegami-SignificantEvents", "Took over Kabuki operations after the previous boss disappeared. Brokered the Tyger Claws-Maelstrom XBD distribution agreement. Now expanding into Dogtown's unregulated markets through Hansen's blessing.");
        this.Text("Kdsp-Npc-JunAzegami-Affiliation", "Tyger Claws | Japantown/Kabuki division");
        this.Text("Kdsp-Npc-JunAzegami-CriminalRecord", "NCPD: 14 arrests, 0 convictions | Racketeering | Extortion | Suspected homicide (x6) | Witnesses consistently recant");
        this.Text("Kdsp-Npc-JunAzegami-CyberwareStatus", "Mantis blades (concealed, retracted) | Kerenzikov | Sandevistan | Subdermal armor");
        this.Text("Kdsp-Npc-JunAzegami-FinancialStatus", "WEALTHY | Multiple front businesses in Japantown | Jig-Jig Street revenue | XBD distribution profits");
        this.Text("Kdsp-Npc-JunAzegami-Relationships", "Marcus Ichida (Fellow underboss - attends as pair) | Jago Szabo (Barghest contact - business) | Jotaro Shobo (Former associate - deceased)");
        this.Text("Kdsp-Npc-JunAzegami-Notes", "Traditional | Observes Japanese business etiquette even when discussing murder | Never drinks at these events — always watching | Left hand never leaves his lap");
        this.Text("Kdsp-Npc-JunAzegami-ThreatAssessment", "EXTREME (85/100) | Mantis blades | Sandevistan equipped | Decades of combat experience | Tyger Claws reinforcements on speed dial");
        this.Text("Kdsp-Npc-MarcusIchida-Classification", "TYGER CLAWS - UNDERBOSS");
        this.Text("Kdsp-Npc-MarcusIchida-Background", "Marcus Ichida (市田 マーカス). Japanese-American. Second-generation Night City Tyger Claws. Co-manages the gang's external relations alongside Jun Azegami. Where Azegami is the traditionalist, Ichida is the modernizer — pushing the Claws into legitimate business fronts while maintaining iron control over their illegal operations. Attends the Black Sapphire as the public-facing negotiator.");
        this.Text("Kdsp-Npc-MarcusIchida-EarlyLife", "Born in Night City, Watson district. Father was a Tyger Claws accountant. Educated at Arasaka-funded academy in Japantown. Business degree from NC Metro University — paid for by gang money. Recruited formally at 22, but grew up in the life.");
        this.Text("Kdsp-Npc-MarcusIchida-SignificantEvents", "Established multiple Tyger Claws front corporations. Negotiated territorial agreements with Valentinos and Maelstrom. Currently brokering a deal with Barghest for exclusive distribution rights in Dogtown.");
        this.Text("Kdsp-Npc-MarcusIchida-Affiliation", "Tyger Claws | External relations / Business operations");
        this.Text("Kdsp-Npc-MarcusIchida-CriminalRecord", "NCPD: 8 arrests, 0 convictions | Money laundering | Tax evasion | RICO investigation (ongoing, no charges filed)");
        this.Text("Kdsp-Npc-MarcusIchida-CyberwareStatus", "Kiroshi optics (recording suite) | Neural interface (encrypted) | Subdermal armor | Monowire (concealed)");
        this.Text("Kdsp-Npc-MarcusIchida-FinancialStatus", "WEALTHY | Corporate fronts | Legitimate investments | Japantown real estate portfolio");
        this.Text("Kdsp-Npc-MarcusIchida-Relationships", "Jun Azegami (Fellow underboss - mutual respect) | Jago Szabo (Barghest contact) | Arasaka mid-level contacts (business)");
        this.Text("Kdsp-Npc-MarcusIchida-Notes", "Educated and articulate | Dresses corpo, thinks yakuza | Records every conversation through Kiroshi implants | The smarter and more dangerous of the pair in a boardroom");
        this.Text("Kdsp-Npc-MarcusIchida-ThreatAssessment", "HIGH (70/100) | Monowire | Combat-trained but prefers to delegate | Real danger is his connections and resources");
        this.Text("Kdsp-Npc-RuthDzeng-Classification", "MEDIA - DMS NETWORK HOST");
        this.Text("Kdsp-Npc-RuthDzeng-Background", "Ruth Dzeng. Anchor and senior correspondent for DMS (Data Mainstream Services). One of Night City's most recognized faces in broadcast journalism. Covers high-society events, corporate politics, and gang-adjacent power brokers. Her presence at the Black Sapphire is professional — she's here to report, network, and gather material for her next series on Dogtown's transformation under Hansen.");
        this.Text("Kdsp-Npc-RuthDzeng-EarlyLife", "Born in San Francisco to a family of second-generation Chinese-American journalists. Her mother covered the Unification War for the Pacific Standard. Ruth inherited the instincts and none of the idealism. Moved to Night City after DMS offered her the anchor desk at 28.");
        this.Text("Kdsp-Npc-RuthDzeng-SignificantEvents", "Broke the Watson Waterfront corruption story in 2073. Landed exclusive interview with a Militech VP during the Arasaka-Militech proxy conflict. Currently developing a long-form piece on Dogtown as a 'sovereign experiment.'");
        this.Text("Kdsp-Npc-RuthDzeng-Affiliation", "DMS Network | Night City press corps");
        this.Text("Kdsp-Npc-RuthDzeng-CriminalRecord", "CLEAN | One defamation lawsuit (settled out of court, Biotechnica)");
        this.Text("Kdsp-Npc-RuthDzeng-CyberwareStatus", "Kiroshi optics (recording suite, live-feed capable) | Neural interface (teleprompter overlay) | Voice modulator (broadcast-grade)");
        this.Text("Kdsp-Npc-RuthDzeng-FinancialStatus", "AFFLUENT | DMS salary | Speaking engagements | Book deal (pending)");
        this.Text("Kdsp-Npc-RuthDzeng-Relationships", "DMS producers (Professional) | Night City media network (Competitors and colleagues) | Various fixers (Sources)");
        this.Text("Kdsp-Npc-RuthDzeng-Notes", "Sharp interviewer | Knows when to push and when to smile | Never off the record | Camera-ready at all times");
        this.Text("Kdsp-Npc-RuthDzeng-ThreatAssessment", "NONE (direct) | Influence through broadcast reach | Can destroy reputations with a single segment");
        this.Text("Kdsp-Npc-ZiggyQ-Classification", "MEDIA - N64 PERSONALITY");
        this.Text("Kdsp-Npc-ZiggyQ-Background", "Ziggy Q. Stage name. Real name classified — and he'd like to keep it that way. Network 64's most popular entertainment host. Famous for his outrageous on-air persona, celebrity interviews, and willingness to say anything for ratings. At the Black Sapphire for content — every handshake is a potential segment, every scandal a sweeps-week special.");
        this.Text("Kdsp-Npc-ZiggyQ-EarlyLife", "Rumored origins range from a corpo family in Westbrook to a Heywood street kid who talked his way onto a pirate broadcast. The truth is probably somewhere in between. What's confirmed: he appeared on N64's late-night slot in 2071 and never left.");
        this.Text("Kdsp-Npc-ZiggyQ-SignificantEvents", "'Ziggy After Dark' debuted 2071, became N54's highest-rated show within six months. Viral segment interviewing a cyberpsycho mid-episode. Banned from three Arasaka facilities for unauthorized filming.");
        this.Text("Kdsp-Npc-ZiggyQ-Affiliation", "Network 64 (N64) | Night City entertainment media");
        this.Text("Kdsp-Npc-ZiggyQ-CriminalRecord", "Trespassing (x3, dismissed) | Unauthorized recording (x2, settled) | Contempt of court (1, community service)");
        this.Text("Kdsp-Npc-ZiggyQ-CyberwareStatus", "Kiroshi optics (always recording) | Neural editor (real-time highlight reel) | Voice modulator | Mood-reactive LED subdermal tattoos");
        this.Text("Kdsp-Npc-ZiggyQ-FinancialStatus", "WEALTHY | N64 contract | Endorsement deals | Merchandise line ('Ziggy Q Approved')");
        this.Text("Kdsp-Npc-ZiggyQ-Notes", "Loud, strategic, and smarter than he lets on | The buffoon act is exactly that — an act | Has dirt on half of Night City's elite");
        this.Text("Kdsp-Npc-ZiggyQ-ThreatAssessment", "NONE (direct) | Extremely dangerous to reputations | Has a direct line to millions of viewers");
        this.Text("Kdsp-Npc-ArifIqbal-Classification", "MEDIA - WNS CORRESPONDENT");
        this.Text("Kdsp-Npc-ArifIqbal-Background", "Arif Iqbal. Senior international correspondent for WNS (World News Service). Specializes in conflict zones, failed states, and corporate-sovereign disputes. Covering Dogtown's Black Sapphire event as part of a broader WNS series on post-Unification War power vacuums. The kind of journalist who's been shot at in four continents and still shows up to parties in a tailored suit.");
        this.Text("Kdsp-Npc-ArifIqbal-EarlyLife", "Born in Islamabad. Studied journalism at the University of Lahore before securing a WNS internship. First assignment was covering the Karachi port bombing of 2063. Never looked back.");
        this.Text("Kdsp-Npc-ArifIqbal-SignificantEvents", "Embedded with NUSA forces during the Unification War. Covered the fall of Busan to corporate PMCs. Award-winning documentary on Arasaka's influence in Southeast Asian politics. Currently the only WNS journalist with standing access to Dogtown.");
        this.Text("Kdsp-Npc-ArifIqbal-Affiliation", "WNS (World News Service) | International press");
        this.Text("Kdsp-Npc-ArifIqbal-CriminalRecord", "CLEAN | Detained twice (conflict zones — released) | Press credentials valid across NUSA and Free States");
        this.Text("Kdsp-Npc-ArifIqbal-CyberwareStatus", "Kiroshi optics (documentary-grade recording) | Translation implant (12 languages) | Reinforced subdermal plating (journalist armor, conflict zone standard)");
        this.Text("Kdsp-Npc-ArifIqbal-FinancialStatus", "COMFORTABLE | WNS salary | Documentary residuals | Freelance consulting");
        this.Text("Kdsp-Npc-ArifIqbal-Notes", "Calm under fire — literally | Asks uncomfortable questions with a gentle voice | Never reveals sources | Respects Hansen enough to attend, doesn't trust him enough to turn his back");
        this.Text("Kdsp-Npc-ArifIqbal-ThreatAssessment", "NONE (direct) | International press protection | WNS legal team on retainer | Killing him would be an international incident");
        this.Text("Kdsp-Npc-JoshKavorkin-Classification", "MEDIA - WNS ANALYST");
        this.Text("Kdsp-Npc-JoshKavorkin-Background", "Josh Kavorkin. WNS political analyst and on-air commentator. Covers Night City governance, NUSA federal politics, and corporate power structures. Known for his measured delivery and ability to explain complex geopolitical situations to a mass audience. At the Black Sapphire networking with power brokers and gathering material for his evening analysis segment.");
        this.Text("Kdsp-Npc-JoshKavorkin-EarlyLife", "Born in Chicago. Russian-American family. Father was a political science professor at the University of Chicago before it was absorbed by Militech's educational trust. Josh inherited the academic temperament and parlayed it into broadcast journalism.");
        this.Text("Kdsp-Npc-JoshKavorkin-SignificantEvents", "Correctly predicted the outcome of three consecutive NUSA elections. His analysis of the Unification War's economic impact became required reading at several universities. Regular panelist on WNS's flagship debate show.");
        this.Text("Kdsp-Npc-JoshKavorkin-Affiliation", "WNS (World News Service) | Political analysis division");
        this.Text("Kdsp-Npc-JoshKavorkin-CriminalRecord", "CLEAN");
        this.Text("Kdsp-Npc-JoshKavorkin-CyberwareStatus", "Kiroshi optics (standard media suite) | Neural interface (data overlay, live statistics feed)");
        this.Text("Kdsp-Npc-JoshKavorkin-FinancialStatus", "COMFORTABLE | WNS contract | University speaking fees | Published author");
        this.Text("Kdsp-Npc-JoshKavorkin-Relationships", "WNS editorial board (Professional) | Arif Iqbal (Colleague - mutual respect) | Various political contacts (Sources)");
        this.Text("Kdsp-Npc-JoshKavorkin-Notes", "Thoughtful and deliberate | Never speculates without data | The kind of journalist politicians fear because he does his homework");
        this.Text("Kdsp-Npc-JoshKavorkin-ThreatAssessment", "NONE (direct) | Influence through analysis and commentary | Can shift public opinion with a single broadcast");
        this.Text("Kdsp-Npc-ReverendColver-Classification", "CLERGY - NIGHT CITY DIOCESE");
        this.Text("Kdsp-Npc-ReverendColver-Background", "Reverend Colver. One of Night City's few remaining ordained ministers. Operates a small congregation in Pacifica's remains and serves as spiritual advisor to several wealthy patrons — which is how he ended up with an invitation to the Black Sapphire. The collar gets him into rooms that guns cannot.");
        this.Text("Kdsp-Npc-ReverendColver-EarlyLife", "Seminary education in the NUSA heartland. Took his first parish in Night City in 2058 when the diocese couldn't find anyone else willing to go. Twenty years later, he's still here — held together by faith and the kind of stubbornness only clergy possess.");
        this.Text("Kdsp-Npc-ReverendColver-SignificantEvents", "Rebuilt St. Ambrose parish after the Pacifica collapse. Provides sanctuary services to war refugees in Dogtown's border zones. Quietly brokers ceasefire agreements between smaller gangs. His neutrality is his currency.");
        this.Text("Kdsp-Npc-ReverendColver-Affiliation", "Night City Diocese | Unaffiliated (political)");
        this.Text("Kdsp-Npc-ReverendColver-CriminalRecord", "CLEAN | Cited once for operating an unlicensed shelter (dismissed)");
        this.Text("Kdsp-Npc-ReverendColver-CyberwareStatus", "Minimal | Basic neural interface | Kiroshi optics (standard)");
        this.Text("Kdsp-Npc-ReverendColver-FinancialStatus", "MODEST | Parish income | Wealthy patrons donate generously | Funds redirected to charitable work");
        this.Text("Kdsp-Npc-ReverendColver-Relationships", "Various wealthy patrons (Spiritual advisor) | Pacifica communities (Pastor) | Hansen's administration (Tolerated)");
        this.Text("Kdsp-Npc-ReverendColver-Notes", "Genuine faith in a faithless city | Knows everyone's secrets from confession | Never weaponizes them | The one person in the room with no angle to play");
        this.Text("Kdsp-Npc-ReverendColver-ThreatAssessment", "NONE | Non-combatant | Protected by social convention and genuine neutrality");
        this.Text("Kdsp-Npc-AuroreCassel-Classification", "SOCIALITE - FRENCH EXPATRIATE");
        this.Text("Kdsp-Npc-AuroreCassel-Background", "Aurore Cassel. French-born socialite. Twin sister of Aymeric Cassel. The Cassels are fixtures of Night City's ultra-wealthy social circuit — old European money that survived the continental collapse by diversifying into Night City real estate and corpo stock before everyone else saw the writing on the wall. Aurore handles the family's social capital with surgical precision.");
        this.Text("Kdsp-Npc-AuroreCassel-EarlyLife", "Born in Lyon, France. Privately educated across what remained of the EU. The family relocated to Night City when Aurore and Aymeric were teenagers, converting their European holdings into a Night City portfolio worth billions.");
        this.Text("Kdsp-Npc-AuroreCassel-SignificantEvents", "Co-hosts the annual Cassel Foundation Gala — Night City's most exclusive charity event. Rumored to have brokered introductions between Arasaka executives and European banking interests. The Black Sapphire is one of the few venues she considers worth attending.");
        this.Text("Kdsp-Npc-AuroreCassel-Affiliation", "Cassel Family | High society");
        this.Text("Kdsp-Npc-AuroreCassel-CriminalRecord", "CLEAN | One civil suit (defamation, won)");
        this.Text("Kdsp-Npc-AuroreCassel-CyberwareStatus", "Cosmetic-grade implants only | Kiroshi optics (social overlay) | Anti-aging suite | Subdermal UV protection");
        this.Text("Kdsp-Npc-AuroreCassel-FinancialStatus", "ULTRA-WEALTHY | Family trust | Night City real estate | European banking interests | Corpo stock portfolio");
        this.Text("Kdsp-Npc-AuroreCassel-Relationships", "Aymeric Cassel (Twin brother - inseparable) | Night City's corporate elite (Social circle) | Various fixers (Discreet arrangements)");
        this.Text("Kdsp-Npc-AuroreCassel-Notes", "Charming and lethal in conversation | Every word is calculated | Speaks four languages fluently | Treats Night City like a chess board she's already winning");
        this.Text("Kdsp-Npc-AuroreCassel-ThreatAssessment", "NONE (direct) | Enormous financial and social influence | Can end careers with a phone call");
        this.Text("Kdsp-Npc-AymericCassel-Classification", "SOCIALITE - FRENCH EXPATRIATE");
        this.Text("Kdsp-Npc-AymericCassel-Background", "Aymeric Cassel. French-born socialite and investor. Twin brother of Aurore Cassel. Where Aurore manages the family's social presence, Aymeric manages the money. A venture capitalist with stakes in everything from Dogtown reconstruction projects to Biotechnica subsidiaries. Quieter than his sister but arguably more dangerous — money moves faster than gossip.");
        this.Text("Kdsp-Npc-AymericCassel-EarlyLife", "Born in Lyon, France. Studied finance in Zurich before the Swiss banking collapse. Relocated to Night City with the family. Built the Cassel investment portfolio from inherited European wealth into a Night City powerhouse.");
        this.Text("Kdsp-Npc-AymericCassel-SignificantEvents", "Led the Cassel acquisition of three Watson waterfront properties. Early investor in Dogtown's reconstruction — one of the few outsiders Hansen permits to operate financially in his territory. Rumored to hold leverage over at least two city councilors.");
        this.Text("Kdsp-Npc-AymericCassel-Affiliation", "Cassel Family | Cassel Ventures");
        this.Text("Kdsp-Npc-AymericCassel-CriminalRecord", "CLEAN | SEC investigation (closed, no charges) | Tax optimization (legal)");
        this.Text("Kdsp-Npc-AymericCassel-CyberwareStatus", "Minimal cosmetic | Neural interface (financial data feeds) | Kiroshi optics (social overlay)");
        this.Text("Kdsp-Npc-AymericCassel-FinancialStatus", "ULTRA-WEALTHY | Venture capital | Real estate | Corpo investments | Dogtown reconstruction stakes");
        this.Text("Kdsp-Npc-AymericCassel-Relationships", "Aurore Cassel (Twin sister - inseparable) | Kurt Hansen (Business arrangement - cautious) | Various corpo boards (Investor)");
        this.Text("Kdsp-Npc-AymericCassel-Notes", "Quiet, observant, patient | Lets Aurore do the talking while he reads the room | The checkbook behind the charm | Prefers whiskey neat and conversations short");
        this.Text("Kdsp-Npc-AymericCassel-ThreatAssessment", "NONE (direct) | Financial leverage over multiple parties | Bankrolls operations that others execute");
        this.Text("Kdsp-Npc-NeleSpringer-Classification", "CRIMSON HARVEST - DEFECTOR");
        this.Text("Kdsp-Npc-NeleSpringer-Background", "Nele Springer. Former member of the Crimson Harvest terrorist organization since 2074. Recently indicated desire to leave the group and prevent further attacks. A brilliant chemist carrying the weight of blood she didn't intend to spill.");
        this.Text("Kdsp-Npc-NeleSpringer-EarlyLife", "Grew up on her family's corn farm in Indiana with four siblings. When the farm went bankrupt and her parents were forced to sell their land to Biotechnica, Springer moved to Night City. A compensation payout for children of relocated farmers funded her chemistry degree. The university proved to be a breeding ground for revolutionary recruiters — when Crimson Harvest offered, she didn't hesitate.");
        this.Text("Kdsp-Npc-NeleSpringer-Affiliation", "Crimson Harvest (Defecting)");
        this.Text("Kdsp-Npc-NeleSpringer-CriminalRecord", "TERRORISM | Crimson Harvest membership since 2074 | Involvement in anti-Biotechnica sabotage operations | Connected to civilian casualties — extent of direct involvement disputed | WANTED by Biotechnica corporate security");
        this.Text("Kdsp-Npc-NeleSpringer-MedicalStatus", "Psychological: Guilt-driven | Tormented by the belief her education was bought with her parents' suffering | Never stopped feeling like a stranger in Night City");
        this.Text("Kdsp-Npc-NeleSpringer-Relationships", "Crimson Harvest (Former cell — defecting) | Biotechnica (Primary target — also hunting her) | Mr. Hands (Fixer — contracted V to assist) | Four siblings (Family — Indiana)");
        this.Text("Kdsp-Npc-NeleSpringer-Notes", "Brilliant chemist | True believer turned disillusioned | Sabotaging Biotechnica felt like alleviating her family's pain — until reality caught up | Biotechnica agents actively pursuing her in Dogtown");
        this.Text("Kdsp-Npc-NeleSpringer-ThreatAssessment", "MODERATE | Chemistry expertise makes her dangerous in theory | Not a direct combatant | Multiple hostile parties tracking her location");
        this.Text("Kdsp-Npc-ZenMaster-Classification", "UNKNOWN - DATABASE INCONCLUSIVE");
        this.Text("Kdsp-Npc-ZenMaster-Background", "No verified identity on file. Subject appears across multiple NCPD surveillance zones in sequence — Reconciliation Park (Corpo Plaza), Japantown shrine district, North Oak roundabout, Jackson Plains overlook — with no recorded transit between locations. Offers unlicensed braindance meditation sessions themed around classical elements. No commercial registration. No fixed address. No known employer. NCPD has received four separate civilian reports describing the same individual in four districts within 48 hours. All reports filed independently.");
        this.Text("Kdsp-Npc-ZenMaster-EarlyLife", "NO DATA AVAILABLE. Immigration records return no match. NUSA citizen registry returns no match. Night City municipal database returns no match. Corporate employment databases return no match. Subject's accent, mannerisms, and philosophical references suggest extensive monastic training — tradition and origin unconfirmed. Facial recognition cross-reference produces zero hits across all available databases. This is statistically anomalous.");
        this.Text("Kdsp-Npc-ZenMaster-SignificantEvents", "Distributes unlicensed braindances focused on elemental meditation (Earth, Water, Fire, Air). BDs have been flagged for analysis — content is non-harmful, non-addictive, and contains no embedded malware or subliminal encoding. Braindance technicians describe the recordings as 'technically impossible' — the sensory fidelity exceeds known consumer-grade wreath hardware capabilities. Subject has been observed quoting lyrics from the band Samurai intermixed with Buddhist and Sufi philosophical texts. Disappears from location after each encounter — no departure recorded on any surveillance feed.");
        this.Text("Kdsp-Npc-ZenMaster-Affiliation", "NONE IDENTIFIED | No gang ties | No corporate affiliation | No political connections | No registered religious organization");
        this.Text("Kdsp-Npc-ZenMaster-CriminalRecord", "NO RECORD | Unlicensed braindance distribution (report filed, investigation stalled — cannot locate subject for questioning) | Four civilian reports (wellness checks — subject found in good health each time, then absent on follow-up) | NCPD classification: NON-PRIORITY CURIOSITY");
        this.Text("Kdsp-Npc-ZenMaster-CyberwareStatus", "SCAN INCONCLUSIVE | External scan detects no implants, no cyberware signature, no neural interface | This would make subject one of approximately 0.3% of Night City residents with zero chrome | Internal scan unable to penetrate — reason unknown");
        this.Text("Kdsp-Npc-ZenMaster-FinancialStatus", "NO FINANCIAL FOOTPRINT | No bank accounts | No registered eddies transactions | No credit history | Accepts voluntary payment for BD sessions (0-610 eddies) — funds not deposited into any tracked account");
        this.Text("Kdsp-Npc-ZenMaster-MedicalStatus", "NO MEDICAL RECORDS | No Trauma Team coverage | No clinic visits on file | Visual assessment: excellent physical condition for estimated age range (50-70?) | Age estimation inconsistent between encounters");
        this.Text("Kdsp-Npc-ZenMaster-Relationships", "NONE ON FILE | Subject appears to operate entirely alone | No known associates | No known residence shared with others | Surveillance note: subject has been observed engaging with individuals experiencing psychological distress or existential crisis — selection criteria for these interactions is unknown");
        this.Text("Kdsp-Npc-ZenMaster-Notes", "PSYCH ASSESSMENT IMPOSSIBLE | Subject demonstrates no markers for any known psychological condition | Exhibits profound calm inconsistent with Night City baseline stress indicators | Speech patterns suggest high intelligence and extensive philosophical education | Does not register on standard threat matrices | Consulting psychologist note: 'This individual is either the most well-adjusted person in Night City, or our tools are not equipped to measure what we are looking at.' | Multiple officers have noted a 'strange sensation' when near the subject — not threat, not fear, described variously as 'peace,' 'stillness,' and 'the feeling of being seen.' One officer requested reassignment after the encounter, citing 'personal reasons.' Another enrolled in a meditation course. | NCPD Dispatch has informally flagged this file as 'Do Not Pursue — Not Worth The Paperwork.'");
        this.Text("Kdsp-Npc-ZenMaster-ThreatAssessment", "CANNOT BE DETERMINED | Subject has never demonstrated hostile behavior | No weapons detected | No cyberware detected | However: subject's ability to appear and disappear without surveillance detection represents a security anomaly that has been escalated to NetWatch twice | NetWatch response both times: 'Not our problem.' | Recommended classification: OBSERVE ONLY");
        this.Text("Kdsp-Glitch-CorruptID-0", "NC??????");
        this.Text("Kdsp-Glitch-CorruptID-1", "NC000000");
