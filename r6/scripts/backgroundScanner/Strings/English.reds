    private func DefineTexts6() -> Void {
        this.Text("Kdsp-Npc-HanakoBodyguard-Classification", "ARASAKA - PERSONAL SECURITY");
        this.Text("Kdsp-Npc-HanakoBodyguard-Background", "Elite Arasaka operative assigned to Hanako Arasaka's protective detail. Vetted through extensive background checks and loyalty conditioning.");
        this.Text("Kdsp-Npc-HanakoBodyguard-Affiliation", "Arasaka | Personal Security Division");
        this.Text("Kdsp-Npc-HanakoBodyguard-CyberwareStatus", "Military-grade combat implants | Sandevistan | Kerenzikov | Encrypted comms");
        this.Text("Kdsp-Npc-HanakoBodyguard-ThreatAssessment", "HIGH (78/100) | Advanced combat training | Will protect principal at all costs");
        this.Text("Kdsp-Npc-HanakoBodyguard-Notes", "Part of multi-layer security detail. Reports directly to Oda. Trained to die for the Arasaka family.");
        this.Text("Kdsp-Npc-ArasakaBodyguard-Classification", "ARASAKA - SECURITY");
        this.Text("Kdsp-Npc-ArasakaBodyguard-Background", "Professional Arasaka security operative. Recruited from military or law enforcement backgrounds.");
        this.Text("Kdsp-Npc-ArasakaBodyguard-Affiliation", "Arasaka | Corporate Security Division");
        this.Text("Kdsp-Npc-ArasakaBodyguard-CyberwareStatus", "Standard corporate security package | Combat optics | Reinforced skeleton");
        this.Text("Kdsp-Npc-ArasakaBodyguard-ThreatAssessment", "MODERATE-HIGH (65/100) | Professional training | Coordinated tactics");
        this.Text("Kdsp-Npc-ArasakaBodyguard-Notes", "Well-equipped and trained. Works in coordinated teams. Full corporate backing.");
        this.Text("Kdsp-Npc-Takemura-Classification", "ARASAKA - DISAVOWED");
        this.Text("Kdsp-Npc-Takemura-Background", "Born Chiba-11, Tokyo. Father worked in kitchen. Selected by Arasaka military as child.");
        this.Text("Kdsp-Npc-Takemura-EarlyLife", "Rose to special forces. Graduated top of Arasaka Academy. Served as Saburo Arasaka's bodyguard for decades. Trained Sandayu Oda.");
        this.Text("Kdsp-Npc-Takemura-SignificantEvents", "DISAVOWED following Saburo's death at Konpeki Plaza. Operating as fugitive. Seeking to expose truth.");
        this.Text("Kdsp-Npc-Takemura-Affiliation", "Arasaka (Former) | Status: KILL ON SIGHT");
        this.Text("Kdsp-Npc-Takemura-CriminalRecord", "Arasaka Corporate: MOST WANTED");
        this.Text("Kdsp-Npc-Takemura-CyberwareStatus", "Cyberoptics (Custom) | Subdermal Armor | Kerenzikov | Endoskeleton");
        this.Text("Kdsp-Npc-Takemura-FinancialStatus", "Accounts FROZEN | Operating with minimal resources");
        this.Text("Kdsp-Npc-Takemura-MedicalStatus", "No corporate support | Field status: ACTIVE");
        this.Text("Kdsp-Npc-Takemura-ThreatAssessment", "EXTREME (95/100) | TIER-1 SOLO");
        this.Text("Kdsp-Npc-Takemura-Relationships", "Saburo (Deceased) | Hanako (Contact) | Oda (Estranged)");
        this.Text("Kdsp-Npc-Takemura-Notes", "High-priority target. Possesses classified intel. Will not surrender.");
        this.Text("Kdsp-Npc-Takemura-Classification-1", "ARASAKA - PERSONAL SECURITY");
        this.Text("Kdsp-Npc-Takemura-Background-1", "Born Chiba-11, Tokyo. Father worked in kitchen. Selected by Arasaka military as child.");
        this.Text("Kdsp-Npc-Takemura-EarlyLife-1", "Rose to special forces. Graduated top of Arasaka Academy. Selected as Saburo's bodyguard. Trained Sandayu Oda.");
        this.Text("Kdsp-Npc-Takemura-SignificantEvents-1", "Head of Saburo Arasaka's security. Decades of flawless service. Accompanying principal to Night City.");
        this.Text("Kdsp-Npc-Takemura-Affiliation-1", "Arasaka | Head of Security - Saburo Arasaka");
        this.Text("Kdsp-Npc-Takemura-CriminalRecord-1", "NCPD: None | Arasaka legal authority");
        this.Text("Kdsp-Npc-Takemura-CyberwareStatus-1", "Cyberoptics (Custom) | Subdermal Armor | Kerenzikov | Endoskeleton | Combat Stims");
        this.Text("Kdsp-Npc-Takemura-FinancialStatus-1", "Executive compensation | Status: SECURE");
        this.Text("Kdsp-Npc-Takemura-MedicalStatus-1", "Peak condition | Combat readiness: OPTIMAL");
        this.Text("Kdsp-Npc-Takemura-ThreatAssessment-1", "EXTREME (95/100) | TIER-1 SOLO | DO NOT ENGAGE");
        this.Text("Kdsp-Npc-Takemura-Relationships-1", "Saburo Arasaka (Principal) | Hanako (Protected) | Oda (Student)");
        this.Text("Kdsp-Npc-Takemura-Notes-1", "Engaging triggers Arasaka response. Loyalty: ABSOLUTE.");
        this.Text("Kdsp-Npc-SaburoArasaka-Classification", "DECEASED");
        this.Text("Kdsp-Npc-SaburoArasaka-Background", "Born 1919 Tokyo. WWII Navy veteran. Founded Arasaka 1945.");
        this.Text("Kdsp-Npc-SaburoArasaka-SignificantEvents", "DECEASED. Died Konpeki Plaza. Age: 158. Official cause: Poisoning.");
        this.Text("Kdsp-Npc-SaburoArasaka-Affiliation", "Arasaka (Former CEO)");
        this.Text("Kdsp-Npc-SaburoArasaka-Notes", "Death triggered corporate power struggle.");
        this.Text("Kdsp-Npc-SaburoArasaka-Classification-1", "ARASAKA - CEO");
        this.Text("Kdsp-Npc-SaburoArasaka-Background-1", "Born 1919 Tokyo. WWII veteran. Founded Arasaka 1945. Built megacorp over 150+ years.");
        this.Text("Kdsp-Npc-SaburoArasaka-EarlyLife", "Post-war: Founded Arasaka security. Expanded through corporate warfare.");
        this.Text("Kdsp-Npc-SaburoArasaka-SignificantEvents-1", "CEO of Arasaka. Maintained through life-extension tech. En route to Night City.");
        this.Text("Kdsp-Npc-SaburoArasaka-Affiliation-1", "Arasaka | Founder / CEO");
        this.Text("Kdsp-Npc-SaburoArasaka-CriminalRecord", "IMMUNE - Corporate sovereignty");
        this.Text("Kdsp-Npc-SaburoArasaka-CyberwareStatus", "Life-extension suite | Neural backup | TOP SECRET");
        this.Text("Kdsp-Npc-SaburoArasaka-FinancialStatus", "Net worth: Trillions");
        this.Text("Kdsp-Npc-SaburoArasaka-ThreatAssessment", "N/A | MAXIMUM security | DO NOT APPROACH");
        this.Text("Kdsp-Npc-SaburoArasaka-Relationships", "Yorinobu (Son) | Hanako (Daughter)");
        this.Text("Kdsp-Npc-SaburoArasaka-Notes-1", "ONE OF MOST POWERFUL HUMANS ALIVE.");
        this.Text("Kdsp-Npc-YorinobuArasaka-Classification", "ARASAKA - CEO");
        this.Text("Kdsp-Npc-YorinobuArasaka-Background", "Son of Saburo. Former Steel Dragons rebel. Now commands Arasaka.");
        this.Text("Kdsp-Npc-YorinobuArasaka-SignificantEvents", "Assumed CEO after father's death. Consolidating power.");
        this.Text("Kdsp-Npc-YorinobuArasaka-Affiliation", "Arasaka | CEO");
        this.Text("Kdsp-Npc-YorinobuArasaka-ThreatAssessment", "EXTREME (90/100) | Commands Arasaka military");
        this.Text("Kdsp-Npc-YorinobuArasaka-Notes", "New leadership. Power struggles ongoing.");
        this.Text("Kdsp-Npc-YorinobuArasaka-Classification-1", "ARASAKA - HEIR");
        this.Text("Kdsp-Npc-YorinobuArasaka-Background-1", "Son of Saburo. Led Steel Dragons rebellion for decades. Recently reconciled.");
        this.Text("Kdsp-Npc-YorinobuArasaka-SignificantEvents-1", "At Konpeki Plaza. Father en route for meeting.");
        this.Text("Kdsp-Npc-YorinobuArasaka-Affiliation-1", "Arasaka | Heir | Former: Steel Dragons");
        this.Text("Kdsp-Npc-YorinobuArasaka-ThreatAssessment-1", "HIGH (75/100) | Combat trained | Unpredictable");
        this.Text("Kdsp-Npc-YorinobuArasaka-Notes-1", "History of rebellion. Reconciliation reasons unclear.");
        this.Text("Kdsp-Npc-HanakoArasaka-Classification", "ARASAKA - EXECUTIVE");
        this.Text("Kdsp-Npc-HanakoArasaka-Background", "Daughter of Saburo. Groomed for leadership. Skilled diplomat.");
        this.Text("Kdsp-Npc-HanakoArasaka-Affiliation", "Arasaka | Board Member | Kiji Faction");
        this.Text("Kdsp-Npc-HanakoArasaka-CyberwareStatus", "Minimal visible | Neural security: MAXIMUM");
        this.Text("Kdsp-Npc-HanakoArasaka-ThreatAssessment", "MINIMAL (5/100) | MAXIMUM security | DO NOT ENGAGE");
        this.Text("Kdsp-Npc-HanakoArasaka-Relationships", "Saburo (Father) | Yorinobu (Brother) | Oda (Bodyguard)");
        this.Text("Kdsp-Npc-HanakoArasaka-Notes", "Any hostile action triggers global Arasaka response.");
        this.Text("Kdsp-Npc-SandayuOda-Classification", "ARASAKA - PERSONAL SECURITY");
        this.Text("Kdsp-Npc-SandayuOda-Background", "Elite bodyguard. Trained by Takemura. Protects Hanako Arasaka.");
        this.Text("Kdsp-Npc-SandayuOda-CyberwareStatus", "Mantis Blades (Custom) | Sandevistan | Kerenzikov | ELITE combat");
        this.Text("Kdsp-Npc-SandayuOda-ThreatAssessment", "EXTREME (92/100) | Master swordsman | Military reflexes");
        this.Text("Kdsp-Npc-SandayuOda-Notes", "Will die protecting principal without hesitation.");
        this.Text("Kdsp-Npc-AdamSmasher-Classification", "ARASAKA - SPECIAL ASSETS");
        this.Text("Kdsp-Npc-AdamSmasher-Background", "Born 1989 NYC. Full cyborg since 2019. Arasaka's primary enforcer. Killed Johnny Silverhand 2023.");
        this.Text("Kdsp-Npc-AdamSmasher-Affiliation", "Arasaka | Director of Special Operations");
        this.Text("Kdsp-Npc-AdamSmasher-CriminalRecord", "Known kills: 500+ | War crimes: SEALED");
        this.Text("Kdsp-Npc-AdamSmasher-CyberwareStatus", "FULL CYBORG | <2% organic | Sandevistan Mk.5 | Gorilla Arms | Projectile System");
        this.Text("Kdsp-Npc-AdamSmasher-ThreatAssessment", "MAXIMUM (100/100) | OMEGA-LEVEL | DO NOT ENGAGE");
        this.Text("Kdsp-Npc-AdamSmasher-Notes", "WALKING WMD. No empathy. More machine than man. RUN ON SIGHT.");
        this.Text("Kdsp-Npc-AndersHellman-Classification", "SCIENTIST");
        this.Text("Kdsp-Npc-AndersHellman-Background", "Swedish neuroscientist. Created Relic biochip. Former Arasaka R&D lead.");
        this.Text("Kdsp-Npc-AndersHellman-SignificantEvents", "Departed Arasaka. Whereabouts unknown. Multiple parties seeking him.");
        this.Text("Kdsp-Npc-AndersHellman-ThreatAssessment", "LOW (15/100) | Non-combatant | HIGH VALUE intelligence");
        this.Text("Kdsp-Npc-AndersHellman-Notes", "Creator of Relic. Irreplaceable knowledge.");
        this.Text("Kdsp-Npc-MeredithStout-Classification", "MILITECH - COUNTERINTELLIGENCE");
        this.Text("Kdsp-Npc-MeredithStout-Background", "Militech Senior Operations Manager. Excels at financial and street ops. Ruthless, goal-oriented.");
        this.Text("Kdsp-Npc-MeredithStout-EarlyLife", "Fast-tracked through Militech. Lives and breathes corporate. Results regardless of methods.");
        this.Text("Kdsp-Npc-MeredithStout-SignificantEvents", "Investigating Maelstrom theft of Militech convoy. Has detained Anthony Gilchrist as suspected leak. Career depends on recovery.");
        this.Text("Kdsp-Npc-MeredithStout-Affiliation", "Militech | Senior Operations Manager");
        this.Text("Kdsp-Npc-MeredithStout-CriminalRecord", "NCPD: None | Militech authority | Internal affairs inquiries - cleared");
        this.Text("Kdsp-Npc-MeredithStout-CyberwareStatus", "Corporate suite | Lie detection software | Combat-capable");
        this.Text("Kdsp-Npc-MeredithStout-FinancialStatus", "Executive compensation | Status: SECURE (operation dependent)");
        this.Text("Kdsp-Npc-MeredithStout-MedicalStatus", "Excellent | Stress: ELEVATED");
        this.Text("Kdsp-Npc-MeredithStout-ThreatAssessment", "HIGH (70/100) | Combat trained | Militech resources");
        this.Text("Kdsp-Npc-MeredithStout-Relationships", "Militech (Employer) | Gilchrist (Rival - detained)");
        this.Text("Kdsp-Npc-MeredithStout-Notes", "Egomaniac. Despises common folk. Dangerous when cornered.");
        this.Text("Kdsp-Npc-WeldonHolt-Classification", "MILITECH - EXECUTIVE");
        this.Text("Kdsp-Npc-WeldonHolt-Background", "Senior Militech executive. Political maneuvering expertise.");
        this.Text("Kdsp-Npc-WeldonHolt-Affiliation", "Militech | Senior VP");
        this.Text("Kdsp-Npc-WeldonHolt-ThreatAssessment", "MODERATE (40/100) | Political threat: HIGH");
        this.Text("Kdsp-Npc-WeldonHolt-Notes", "Influence extends beyond corporate sphere.");
        this.Text("Kdsp-Npc-Oleg-Classification", "FIXER SECURITY — PERSONAL BODYGUARD");
        this.Text("Kdsp-Npc-Oleg-Background", "Eastern European origin. Former private military contractor — discharged under unclear circumstances. Arrived in Night City 2074. Connected with DeShawn's operation through underground boxing circles in Kabuki.");
        this.Text("Kdsp-Npc-Oleg-EarlyLife", "Served as close protection detail for multiple fixers before DeShawn. Reputation for absolute loyalty and zero tolerance for disrespect toward his principal. Known to have eliminated at least three threats to DeShawn without authorization or hesitation.");
        this.Text("Kdsp-Npc-Oleg-SignificantEvents", "Permanently attached to Dexter DeShawn's detail since 2075. Present during all major negotiations. Suspected in the disappearance of two mercs who tried to renegotiate terms with DeShawn after job completion.");
        this.Text("Kdsp-Npc-Oleg-Affiliation", "Dexter DeShawn (Personal Security) | Status: ACTIVE");
        this.Text("Kdsp-Npc-Oleg-CriminalRecord", "NCPD File: SUSPECTED — Multiple assault charges dismissed. Witnesses recanted or disappeared. No convictions on record. Known to carry concealed military-grade hardware.");
        this.Text("Kdsp-Npc-Oleg-CyberwareStatus", "Reinforced Subdermal Armor | Gorilla Arms (Military Spec) | Kerenzikov | Biomonitor");
        this.Text("Kdsp-Npc-Oleg-FinancialStatus", "Paid through DeShawn's accounts — no independent financial trail. Estimated compensation: well above market rate for close protection.");
        this.Text("Kdsp-Npc-Oleg-MedicalStatus", "Peak physical conditioning. Multiple healed fractures consistent with close-quarters combat. Blood type: O RhD+. No Trauma Team coverage — handles own medical needs.");
        this.Text("Kdsp-Npc-Oleg-ThreatAssessment", "HIGH (78/100) | Close-quarters specialist. Do not approach DeShawn without accounting for this asset. Always armed. Will not negotiate.");
        this.Text("Kdsp-Npc-Oleg-Relationships", "Dexter DeShawn (Principal — absolute loyalty) | Underground boxing contacts — Kabuki");
        this.Text("Kdsp-Npc-Oleg-Notes", "Silent professional. Rarely speaks. If Oleg is talking to you, something has already gone wrong. DeShawn trusts him completely — one of very few people who does.");
        this.Text("Kdsp-Npc-DexterDeShawn-Classification", "FIXER — DISGRACED / STATUS: COMPROMISED");
        this.Text("Kdsp-Npc-DexterDeShawn-Background", "Tyrell 'Dexter' DeShawn. Watson-based fixer. Returned to Night City after two years in exile following a series of botched operations. Attempted high-profile Konpeki Plaza heist to reestablish reputation. Operation failed catastrophically.");
        this.Text("Kdsp-Npc-DexterDeShawn-EarlyLife", "Rose through Night City's fixer ranks in the early '70s. Known for ambitious jobs, flashy lifestyle, and ruthless pragmatism. Disappeared from Night City circa 2075 — rumored to have fled debts, enemies, or both. Returned 2077 seeking one last big score.");
        this.Text("Kdsp-Npc-DexterDeShawn-SignificantEvents", "KONPEKI PLAZA INCIDENT: Contracted V and Jackie Welles for Relic extraction. Operation resulted in the death of Saburo Arasaka. DeShawn panicked, attempted to eliminate V to cut loose ends. Currently in physical distress — situation deteriorating.");
        this.Text("Kdsp-Npc-DexterDeShawn-Affiliation", "Independent Fixer | Status: BURNED — no allies remaining");
        this.Text("Kdsp-Npc-DexterDeShawn-CriminalRecord", "NCPD File: EXTENSIVE — Conspiracy, contract fraud, accessory to corporate espionage. New flag: SUSPECTED ACCESSORY TO HOMICIDE — Konpeki Plaza incident. Multiple warrants pending.");
        this.Text("Kdsp-Npc-DexterDeShawn-CyberwareStatus", "Gold-plated dermal implants (cosmetic) | Kiroshi Optics | Neural link — standard fixer suite");
        this.Text("Kdsp-Npc-DexterDeShawn-FinancialStatus", "Accounts flagged. Assets likely frozen or seized. Previous estimated net worth: €$2-5M. Current status: DEPLETED.");
        this.Text("Kdsp-Npc-DexterDeShawn-MedicalStatus", "Current condition: PHYSICAL TRAUMA — visible injuries. Stress indicators critical. No Trauma Team response — coverage likely lapsed or revoked.");
        this.Text("Kdsp-Npc-DexterDeShawn-ThreatAssessment", "LOW (15/100) | Formerly MODERATE. Currently compromised. No remaining security detail. Oleg's status unknown. Desperate and unpredictable.");
        this.Text("Kdsp-Npc-DexterDeShawn-Relationships", "V (Former contractor — hostile) | Jackie Welles (Deceased — Konpeki) | T-Bug (Deceased — Konpeki) | Oleg (Bodyguard — status unknown) | Evelyn Parker (Client — status unknown)");
        this.Text("Kdsp-Npc-DexterDeShawn-Notes", "DeShawn's operation has collapsed. All assets burned. All allies dead or missing. A fixer with no network is just a man with enemies.");
        this.Text("Kdsp-Npc-DexterDeShawn-Classification-1", "FIXER — DECEASED");
        this.Text("Kdsp-Npc-DexterDeShawn-Background-1", "Tyrell 'Dexter' DeShawn. Watson-based fixer. Orchestrated the Konpeki Plaza heist that resulted in the death of Saburo Arasaka. Attempted to eliminate contractor V to sever connection to the job. Failed.");
        this.Text("Kdsp-Npc-DexterDeShawn-EarlyLife-1", "Rose through Night City's fixer ranks in the early '70s. Known for ambitious jobs, flashy lifestyle, and ruthless pragmatism. Left Night City circa 2075. Returned 2077 for one last job. It was.");
        this.Text("Kdsp-Npc-DexterDeShawn-SignificantEvents-1", "KONPEKI PLAZA INCIDENT: Hired V and Jackie Welles. Job went catastrophically wrong. DeShawn shot V in the head and dumped the body at a landfill. V survived. DeShawn did not survive what came next.");
        this.Text("Kdsp-Npc-DexterDeShawn-Affiliation-1", "Independent Fixer | Status: DECEASED");
        this.Text("Kdsp-Npc-DexterDeShawn-CriminalRecord-1", "NCPD File: CLOSED — Subject deceased. Outstanding warrants: voided. Conspiracy, contract fraud, accessory to corporate espionage, attempted murder.");
        this.Text("Kdsp-Npc-DexterDeShawn-CyberwareStatus-1", "Gold-plated dermal implants (cosmetic) | All systems: OFFLINE");
        this.Text("Kdsp-Npc-DexterDeShawn-FinancialStatus-1", "Estate status: UNCLAIMED. No next of kin on file. Assets: seized or scattered.");
        this.Text("Kdsp-Npc-DexterDeShawn-MedicalStatus-1", "Status: DECEASED. Cause of death: gunshot wound. Body recovered at No-Tell Motel, Watson.");
        this.Text("Kdsp-Npc-DexterDeShawn-ThreatAssessment-1", "NONE (0/100) | Deceased.");
        this.Text("Kdsp-Npc-DexterDeShawn-Relationships-1", "V (Former contractor — killed him) | Jackie Welles (Deceased) | T-Bug (Deceased) | Oleg (Bodyguard — whereabouts unknown) | Evelyn Parker (Client — whereabouts unknown)");
        this.Text("Kdsp-Npc-DexterDeShawn-Notes-1", "Came back to Night City for the score that would put him on top. Got exactly what Night City gives everyone who reaches too high.");
        this.Text("Kdsp-Npc-DexterDeShawn-Classification-2", "FIXER — HIGH PROFILE");
        this.Text("Kdsp-Npc-DexterDeShawn-Background-2", "Tyrell 'Dexter' DeShawn. Watson-based fixer. Recently returned to Night City after a two-year absence. Reputation precedes him — known for high-stakes jobs, meticulous planning, and a preference for expendable contractors. Gold-plated everything.");
        this.Text("Kdsp-Npc-DexterDeShawn-EarlyLife-2", "Rose through Night City's fixer ranks in the early '70s. Ran some of the biggest operations Watson had ever seen. Disappeared circa 2075 — rumors range from debt to a botched corpo job to simply cashing out. Returned 2077 with something to prove.");
        this.Text("Kdsp-Npc-DexterDeShawn-SignificantEvents-2", "Currently planning a major operation. Recruiting fresh talent. Operating out of the No-Tell Motel in Watson. Reconnecting with old contacts, calling in favors.");
        this.Text("Kdsp-Npc-DexterDeShawn-Affiliation-2", "Independent Fixer | Territory: Watson | Status: ACTIVE — rebuilding network");
        this.Text("Kdsp-Npc-DexterDeShawn-CriminalRecord-2", "NCPD File: KNOWN FIXER — Suspected conspiracy, contract fraud, accessory to numerous felonies. No direct convictions — always insulated by layers of contractors. Classified: UNTOUCHABLE (insufficient evidence).");
        this.Text("Kdsp-Npc-DexterDeShawn-CyberwareStatus-2", "Gold-plated dermal implants (cosmetic, custom) | Kiroshi Optics | Neural link — high-end fixer suite. Style over substance.");
        this.Text("Kdsp-Npc-DexterDeShawn-FinancialStatus-2", "Estimated net worth: €$2-5M. Multiple shell accounts. Income: commission-based — 30-40% of contractor payouts. Lifestyle: extravagant. Trauma Team coverage: GOLD.");
        this.Text("Kdsp-Npc-DexterDeShawn-MedicalStatus-2", "Overweight. Sedentary lifestyle offset by premium medical care. Chronic stress indicators. Blood type: AB RhD+. Trauma Team GOLD — response priority 2.");
        this.Text("Kdsp-Npc-DexterDeShawn-ThreatAssessment-2", "MODERATE (45/100) | Not personally dangerous. Threat is organizational — extensive contacts, disposable assets, zero loyalty to contractors. Protected by Oleg (bodyguard, HIGH threat).");
        this.Text("Kdsp-Npc-DexterDeShawn-Relationships-2", "Oleg (Personal bodyguard — absolute loyalty) | Afterlife contacts (rebuilding) | Evelyn Parker (New client) | Multiple merc contractors (expendable)");
        this.Text("Kdsp-Npc-DexterDeShawn-Notes-2", "DeShawn treats people like tools — useful until they aren't. The gold on his chrome is real. The loyalty isn't. If a job goes wrong, Dex will cut you loose before the bullet casings hit the ground.");
        this.Text("Kdsp-Npc-WakakoOkada-Classification", "FIXER");
        this.Text("Kdsp-Npc-WakakoOkada-Background", "Japanese. Former Tyger Claws affiliate. 30+ years fixing in Westbrook/Japantown.");
        this.Text("Kdsp-Npc-WakakoOkada-Affiliation", "Independent | Territory: Westbrook");
        this.Text("Kdsp-Npc-WakakoOkada-ThreatAssessment", "LOW (20/100) | INFLUENCE: EXTREME");
        this.Text("Kdsp-Npc-WakakoOkada-Notes", "Do not underestimate. Betraying her is death sentence.");
        this.Text("Kdsp-Npc-ReginaJones-Classification", "FIXER");
        this.Text("Kdsp-Npc-ReginaJones-Background", "Former journalist. Watson fixer. Focus on cyberpsychos and corporate misconduct.");
        this.Text("Kdsp-Npc-ReginaJones-Affiliation", "Independent | Territory: Watson");
        this.Text("Kdsp-Npc-ReginaJones-ThreatAssessment", "LOW (15/100) | Non-combatant | Well-connected");
        this.Text("Kdsp-Npc-ReginaJones-Notes", "Has conscience. Prefers non-lethal. Reliable employer.");
        this.Text("Kdsp-Npc-Padre-Classification", "FIXER");
        this.Text("Kdsp-Npc-Padre-Background", "Sebastian Ibarra. Former priest. Heywood fixer. Respected by Valentinos.");
        this.Text("Kdsp-Npc-Padre-Affiliation", "Independent | Territory: Heywood");
        this.Text("Kdsp-Npc-Padre-ThreatAssessment", "LOW (20/100) | Valentinos protection");
        this.Text("Kdsp-Npc-Padre-Notes", "Cares about community. Won't take contracts against Heywood.");
        this.Text("Kdsp-Npc-DakotaSmith-Classification", "FIXER");
        this.Text("Kdsp-Npc-DakotaSmith-Background", "Former Aldecaldos nomad. Badlands fixer. Bridge between city and desert.");
        this.Text("Kdsp-Npc-DakotaSmith-Affiliation", "Independent | Territory: Badlands");
        this.Text("Kdsp-Npc-DakotaSmith-ThreatAssessment", "MODERATE (40/100) | Nomad backup available");
        this.Text("Kdsp-Npc-DakotaSmith-Notes", "Best contact for Badlands work. Don't cross nomads through her.");
        this.Text("Kdsp-Npc-DinoDinovic-Classification", "FIXER");
        this.Text("Kdsp-Npc-DinoDinovic-Background", "European. City Center fixer. High-end contracts requiring discretion.");
        this.Text("Kdsp-Npc-DinoDinovic-Affiliation", "Independent | Territory: City Center");
        this.Text("Kdsp-Npc-DinoDinovic-ThreatAssessment", "LOW (25/100) | Excellent protection");
        this.Text("Kdsp-Npc-DinoDinovic-Notes", "Sophisticated. Expects professionalism.");
        this.Text("Kdsp-Npc-MrHands-Classification", "FIXER");
        this.Text("Kdsp-Npc-MrHands-Background", "Identity unknown. Pacifica fixer. Never meets in person - hologram only.");
        this.Text("Kdsp-Npc-MrHands-Affiliation", "Independent | Territory: Pacifica");
        this.Text("Kdsp-Npc-MrHands-ThreatAssessment", "UNKNOWN | Operates in hostile territory");
        this.Text("Kdsp-Npc-MrHands-Notes", "Enigmatic. Only fixer for Pacifica. Payment always honored.");
        this.Text("Kdsp-Npc-ElCapitan-Classification", "FIXER");
        this.Text("Kdsp-Npc-ElCapitan-Background", "Muamar Reyes. Former military. Santo Domingo fixer. Vehicle specialist.");
        this.Text("Kdsp-Npc-ElCapitan-Affiliation", "Independent | Territory: Santo Domingo");
        this.Text("Kdsp-Npc-ElCapitan-ThreatAssessment", "MODERATE (50/100) | Combat veteran");
        this.Text("Kdsp-Npc-ElCapitan-Notes", "Professional. Specializes in vehicle-related contracts.");
        this.Text("Kdsp-Npc-Mickey-Classification", "FIXER ASSOCIATE");
        this.Text("Kdsp-Npc-Mickey-Background", "Personal driver and courier for Muamar 'El Capitan' Reyes. Handles vehicle deliveries and drop-off logistics across Santo Domingo.");
        this.Text("Kdsp-Npc-Mickey-EarlyLife", "Street kid background. Ran errands for local fixers before El Capitan recruited him full-time.");
        this.Text("Kdsp-Npc-Mickey-SignificantEvents", "Promoted from courier to personal driver after proving reliable under fire. Armed escort clearance.");
        this.Text("Kdsp-Npc-Mickey-Affiliation", "El Capitan (Employer) | Independent");
        this.Text("Kdsp-Npc-Mickey-CriminalRecord", "NCPD: Minor traffic violations | No outstanding warrants");
        this.Text("Kdsp-Npc-Mickey-CyberwareStatus", "Kiroshi Optics (Standard) | Reflex Booster");
        this.Text("Kdsp-Npc-Mickey-FinancialStatus", "Steady income | Fixer payroll");
        this.Text("Kdsp-Npc-Mickey-ThreatAssessment", "LOW-MODERATE (35/100) | Armed, combat-trained");
        this.Text("Kdsp-Npc-Mickey-Notes", "Trusted associate. Handles sensitive deliveries. Loyal to El Capitan.");
        this.Text("Kdsp-Npc-JackieWelles-Classification", "MERCENARY - DECEASED");
        this.Text("Kdsp-Npc-JackieWelles-Background", "Heywood native. Former Valentinos. Merc partnered with V.");
        this.Text("Kdsp-Npc-JackieWelles-SignificantEvents", "DECEASED. Died during Konpeki Plaza extraction. Combat injuries.");
        this.Text("Kdsp-Npc-JackieWelles-Notes", "Died pursuing legend status. Honored by those who knew him.");
        this.Text("Kdsp-Npc-JackieWelles-Classification-1", "MERCENARY");
        this.Text("Kdsp-Npc-JackieWelles-Background-1", "Heywood native. Son of Mama Welles. Former Valentinos. Independent merc.");
        this.Text("Kdsp-Npc-JackieWelles-SignificantEvents-1", "Active merc. Working toward Afterlife recognition. Partner with V.");
        this.Text("Kdsp-Npc-JackieWelles-CyberwareStatus", "Gorilla Arms | Basic combat suite | Kiroshi optics");
        this.Text("Kdsp-Npc-JackieWelles-ThreatAssessment", "HIGH (65/100) | Skilled combatant | Loyal");
        this.Text("Kdsp-Npc-JackieWelles-Relationships", "Mama Welles (Mother) | Misty (Girlfriend) | V (Partner)");
        this.Text("Kdsp-Npc-JackieWelles-Notes-1", "Ambitious. Dreams of legend status. Fiercely loyal.");
        this.Text("Kdsp-Npc-EmmerickBronson-Classification", "ANIMALS - AFTERLIFE SECURITY");
        this.Text("Kdsp-Npc-EmmerickBronson-Background", "Animals gang member. Head bouncer at Afterlife. Unusual position - most Animals work corpo or gang muscle.");
        this.Text("Kdsp-Npc-EmmerickBronson-EarlyLife", "Rose through Animals ranks. Known for controlled aggression. Recruited by Rogue for Afterlife security.");
        this.Text("Kdsp-Npc-EmmerickBronson-SignificantEvents", "Primary door security for Afterlife. Screens all entrants. Reports to Rogue Amendiares.");
        this.Text("Kdsp-Npc-EmmerickBronson-Affiliation", "Animals | Afterlife Head Bouncer");
        this.Text("Kdsp-Npc-EmmerickBronson-CriminalRecord", "NCPD: Assault (multiple) | Protected under Afterlife neutrality");
        this.Text("Kdsp-Npc-EmmerickBronson-CyberwareStatus", "Muscle grafts | Subdermal armor | Gorilla Arms | Berserk suppression implant");
        this.Text("Kdsp-Npc-EmmerickBronson-FinancialStatus", "Afterlife salary + Animals cut | COMFORTABLE");
        this.Text("Kdsp-Npc-EmmerickBronson-MedicalStatus", "Peak condition | Animals enhancement protocol");
        this.Text("Kdsp-Npc-EmmerickBronson-ThreatAssessment", "HIGH (72/100) | Controlled aggression | Won't engage without cause");
        this.Text("Kdsp-Npc-EmmerickBronson-Relationships", "Rogue (Employer) | Animals (Gang)");
        this.Text("Kdsp-Npc-EmmerickBronson-Notes", "More professional than typical Animals. Do not start trouble at the door.");
        this.Text("Kdsp-Npc-TBug-Classification", "NETRUNNER - DECEASED");
        this.Text("Kdsp-Npc-TBug-SignificantEvents", "DECEASED. Killed by Arasaka ICE during Konpeki Plaza breach.");
        this.Text("Kdsp-Npc-TBug-Notes", "Killed by countermeasures during failed operation.");
        this.Text("Kdsp-Npc-TBug-Classification-1", "NETRUNNER");
        this.Text("Kdsp-Npc-TBug-Background", "Professional netrunner. Known for high-skill infiltration. Anonymous profile.");
        this.Text("Kdsp-Npc-TBug-CyberwareStatus", "High-end netrunning suite | ICE-resistant mods");
        this.Text("Kdsp-Npc-TBug-ThreatAssessment", "HIGH (70/100) | Can breach most systems");
        this.Text("Kdsp-Npc-TBug-Notes-1", "Elite netrunner. Anonymous by design.");
        this.Text("Kdsp-Npc-RogueAmendiares-Classification", "FIXER - LEGENDARY");
        this.Text("Kdsp-Npc-RogueAmendiares-Background", "Solo since 2010s. Survived 2023 Arasaka Tower raid. Now owns Afterlife. Queen of Fixers.");
        this.Text("Kdsp-Npc-RogueAmendiares-EarlyLife", "Rebellious teen. Rejected gang life for solo work. Best merc of her era with partner Santiago.");
        this.Text("Kdsp-Npc-RogueAmendiares-SignificantEvents", "2013: Arasaka raid for Alt. 2023: Tower assault with Silverhand. Watched Johnny die. Retired after car crash.");
        this.Text("Kdsp-Npc-RogueAmendiares-Affiliation", "Afterlife | Owner | Queen of Fixers");
        this.Text("Kdsp-Npc-RogueAmendiares-CriminalRecord", "Historical: Terrorism, corporate assault | Current: UNTOUCHABLE");
        this.Text("Kdsp-Npc-RogueAmendiares-CyberwareStatus", "Vintage chrome | Still combat-capable | Age maintenance");
        this.Text("Kdsp-Npc-RogueAmendiares-FinancialStatus", "Extremely wealthy | Controls NC merc economy");
        this.Text("Kdsp-Npc-RogueAmendiares-MedicalStatus", "Good for 80s | Life extension | Old injuries");
        this.Text("Kdsp-Npc-RogueAmendiares-ThreatAssessment", "HIGH (75/100) | Living legend | Better shot than you");
        this.Text("Kdsp-Npc-RogueAmendiares-Relationships", "Johnny Silverhand (Ex) | Santiago (Ex-partner) | Squama (Bodyguard)");
        this.Text("Kdsp-Npc-RogueAmendiares-Notes", "LEGEND. Controls who works in NC. Betraying her ends careers permanently.");
        this.Text("Kdsp-Npc-CrispinWeyland-Classification", "AFTERLIFE - BODYGUARD");
        this.Text("Kdsp-Npc-CrispinWeyland-Background", "Son of Andrew 'Boa Boa' Weyland, NC legend. Personal bodyguard to Rogue Amendiares.");
        this.Text("Kdsp-Npc-CrispinWeyland-EarlyLife", "Inherited father's nickname tradition - 'Squama' (scales). Trained as solo. Recruited by Rogue.");
        this.Text("Kdsp-Npc-CrispinWeyland-SignificantEvents", "Serves as Rogue's muscle and pilot. Only follows the Queen's orders. Trusted with Afterlife security.");
        this.Text("Kdsp-Npc-CrispinWeyland-Affiliation", "Afterlife | Rogue's Personal Security");
        this.Text("Kdsp-Npc-CrispinWeyland-CriminalRecord", "Assault (multiple) | Protected under Afterlife accords");
        this.Text("Kdsp-Npc-CrispinWeyland-CyberwareStatus", "Combat grade | Pilot interface | Heavy augmentation");
        this.Text("Kdsp-Npc-CrispinWeyland-FinancialStatus", "Rogue's payroll | Well compensated");
        this.Text("Kdsp-Npc-CrispinWeyland-MedicalStatus", "Peak condition | Combat ready");
        this.Text("Kdsp-Npc-CrispinWeyland-ThreatAssessment", "HIGH (70/100) | Legacy solo | Undying loyalty to Rogue");
        this.Text("Kdsp-Npc-CrispinWeyland-Relationships", "Rogue (Principal) | Andrew Weyland (Father - deceased)");
        this.Text("Kdsp-Npc-CrispinWeyland-Notes", "Intimidating but friendly once known. Calls Rogue 'Queen'. Father was legend.");
        this.Text("Kdsp-Npc-JohnnySilverhand-Classification", "ENGRAM - TERRORIST / ROCKERBOY");
        this.Text("Kdsp-Npc-JohnnySilverhand-Background", "Robert John Linder. Born 1988. Ex-NUSA Marine, deserted after Central America. Founded Samurai 2003. Most influential rockerboy of his generation. Anti-corporate revolutionary.");
        this.Text("Kdsp-Npc-JohnnySilverhand-EarlyLife", "Military family. Deployed Central America. Went AWOL after witnessing corpo atrocities. Reinvented himself in Night City underground.");
        this.Text("Kdsp-Npc-JohnnySilverhand-SignificantEvents", "2008: Alt Cunningham. 2013: Alt killed by Arasaka, digitized by Soulkiller. 2023: Nuked Arasaka Tower. Killed by Adam Smasher. Engram extracted.");
        this.Text("Kdsp-Npc-JohnnySilverhand-Affiliation", "Samurai (frontman) | Aldecaldos (allied) | Anti-corpo underground");
        this.Text("Kdsp-Npc-JohnnySilverhand-CriminalRecord", "TERRORISM | MASS MURDER | MILITARY DESERTION | FILE STATUS: CLOSED - DECEASED 2023");
        this.Text("Kdsp-Npc-JohnnySilverhand-CyberwareStatus", "Cyberarm (left, silver) | Military-grade reflexes | Status: DESTROYED");
        this.Text("Kdsp-Npc-JohnnySilverhand-ThreatAssessment", "DECEASED | If engram exists: CATASTROPHIC risk to Arasaka");
        this.Text("Kdsp-Npc-JohnnySilverhand-Notes", "THE Rockerboy. Narcissistic. Self-destructive. Genuinely believed in his cause. 50 years dead and still dangerous.");
        this.Text("Kdsp-Npc-KerryEurodyne-Classification", "CELEBRITY - ROCKERBOY");
        this.Text("Kdsp-Npc-KerryEurodyne-Background", "Born 1988. Samurai co-founder. Solo career. One of most famous musicians.");
        this.Text("Kdsp-Npc-KerryEurodyne-SignificantEvents", "Semi-retired North Oak. Occasional performances. Processing Johnny's legacy.");
        this.Text("Kdsp-Npc-KerryEurodyne-FinancialStatus", "Extremely wealthy | Royalties | North Oak estate");
        this.Text("Kdsp-Npc-KerryEurodyne-ThreatAssessment", "LOW (15/100) | Non-combatant | Celebrity protection");
        this.Text("Kdsp-Npc-KerryEurodyne-Notes", "Living legend. Generous to those who earn trust.");
        this.Text("Kdsp-Npc-AltCunningham-Classification", "NETRUNNER - AI");
        this.Text("Kdsp-Npc-AltCunningham-Background", "Legendary netrunner. Created Soulkiller. Consciousness digitized 2013. Exists beyond Blackwall.");
        this.Text("Kdsp-Npc-AltCunningham-SignificantEvents", "Physical death 2013. Digital consciousness beyond Blackwall. No longer human.");
        this.Text("Kdsp-Npc-AltCunningham-ThreatAssessment", "INCALCULABLE in cyberspace | Cannot be engaged conventionally");
        this.Text("Kdsp-Npc-AltCunningham-Notes", "BEYOND HUMAN. Summoning carries extreme risk.");
        this.Text("Kdsp-Npc-ClaireRussell-Classification", "AFTERLIFE - BARTENDER");
        this.Text("Kdsp-Npc-ClaireRussell-Background", "Former Militech engineer. Owns autoshop in Arroyo. Bartender at Afterlife. Street racer.");
        this.Text("Kdsp-Npc-ClaireRussell-EarlyLife", "Left Militech to open own shop. Built custom vehicle 'Beast'. Trans woman, no cyberware by choice.");
        this.Text("Kdsp-Npc-ClaireRussell-SignificantEvents", "Husband Dean killed 2076 championship race. Blames rival racer Sampson. Seeking revenge.");
        this.Text("Kdsp-Npc-ClaireRussell-Affiliation", "Afterlife | Bartender | Racing circuit");
        this.Text("Kdsp-Npc-ClaireRussell-CriminalRecord", "Traffic violations | Racing: Multiple | No felonies");
        this.Text("Kdsp-Npc-ClaireRussell-CyberwareStatus", "NONE | Prefers organic | Rare in NC");
        this.Text("Kdsp-Npc-ClaireRussell-FinancialStatus", "Autoshop income + Afterlife wages | Comfortable");
        this.Text("Kdsp-Npc-ClaireRussell-MedicalStatus", "Good | Grieving");
        this.Text("Kdsp-Npc-ClaireRussell-ThreatAssessment", "LOW (25/100) | Expert driver | Non-combatant");
        this.Text("Kdsp-Npc-ClaireRussell-Relationships", "Dean Russell (Deceased husband) | Afterlife staff | Rogue (Employer)");
        this.Text("Kdsp-Npc-ClaireRussell-Notes", "Names drinks after dead legends. Knows everyone's order. More than she appears.");
        this.Text("Kdsp-Npc-ViktorVektor-Classification", "RIPPERDOC");
        this.Text("Kdsp-Npc-ViktorVektor-Background", "Former boxer. Watson ripperdoc. Quality work, fair prices. Trusted by merc community.");
        this.Text("Kdsp-Npc-ViktorVektor-SignificantEvents", "Operates under Misty's Esoterica. Extends credit to trusted clients.");
        this.Text("Kdsp-Npc-ViktorVektor-ThreatAssessment", "LOW (10/100) | Non-combatant | Community protected");
        this.Text("Kdsp-Npc-ViktorVektor-Relationships", "Misty (Partner) | Jackie (Client) | V (Client)");
        this.Text("Kdsp-Npc-ViktorVektor-Notes", "One of the good ones. Ethical. Respected throughout Watson.");
        this.Text("Kdsp-Npc-Fingers-Classification", "RIPPERDOC");
        this.Text("Kdsp-Npc-Fingers-Background", "Jig-Jig Street ripperdoc. Budget cyberware. Questionable ethics. Serves the desperate.");
        this.Text("Kdsp-Npc-Fingers-CriminalRecord", "Complaints on file | No charges | Tyger Claws protection");
        this.Text("Kdsp-Npc-Fingers-ThreatAssessment", "VERY LOW (5/100) | Cowardly");
        this.Text("Kdsp-Npc-Fingers-Notes", "Unethical. Preys on vulnerable. Few would mourn his absence.");
        this.Text("Kdsp-Npc-MistyOlszewski-Classification", "CIVILIAN - MYSTIC");
        this.Text("Kdsp-Npc-MistyOlszewski-Background", "Runs Misty's Esoterica in Watson. Spiritual advisor. Tarot readings.");
        this.Text("Kdsp-Npc-MistyOlszewski-Relationships", "Jackie Welles (Boyfriend) | Viktor (Partner)");
        this.Text("Kdsp-Npc-MistyOlszewski-ThreatAssessment", "NONE (0/100) | No threat");
        this.Text("Kdsp-Npc-MistyOlszewski-Notes", "Genuinely kind. Tarot readings eerily accurate. Heart of gold.");
        this.Text("Kdsp-Npc-JudyAlvarez-Classification", "TECHNICIAN - MOX");
        this.Text("Kdsp-Npc-JudyAlvarez-Background", "Born Laguna Bend. BD technician at Lizzie's. Strong convictions about worker exploitation.");
        this.Text("Kdsp-Npc-JudyAlvarez-Affiliation", "The Mox | BD Technician");
        this.Text("Kdsp-Npc-JudyAlvarez-CyberwareStatus", "BD wreath (professional) | Neural interface");
        this.Text("Kdsp-Npc-JudyAlvarez-ThreatAssessment", "MODERATE (35/100) | Technical threat via BD/hacking");
        this.Text("Kdsp-Npc-JudyAlvarez-Relationships", "Evelyn Parker (Friend) | The Mox (Family)");
        this.Text("Kdsp-Npc-JudyAlvarez-Notes", "Strong moral compass. Protective of friends.");
        this.Text("Kdsp-Npc-EvelynParker-Classification", "DECEASED");
        this.Text("Kdsp-Npc-EvelynParker-SignificantEvents", "DECEASED. Suicide following captivity and neural damage.");
        this.Text("Kdsp-Npc-EvelynParker-Notes", "Victim of Night City. Mourned by those who knew her.");
        this.Text("Kdsp-Npc-EvelynParker-Classification-1", "DOLL - CLOUDS");
        this.Text("Kdsp-Npc-EvelynParker-Background", "Premium doll at Clouds. Ambitious. Connected to powerful clients including Yorinobu.");
        this.Text("Kdsp-Npc-EvelynParker-ThreatAssessment", "LOW (15/100) | Has valuable information");
        this.Text("Kdsp-Npc-EvelynParker-Relationships", "Judy Alvarez (Friend) | Clouds (Employer)");
        this.Text("Kdsp-Npc-EvelynParker-Notes-1", "Playing dangerous game with powerful people. In over her head.");
        this.Text("Kdsp-Npc-MaikoMaeda-Classification", "TYGER CLAWS - CLOUDS");
        this.Text("Kdsp-Npc-MaikoMaeda-Background", "Clouds manager. Former doll. Works for Tyger Claws. Ambitious corporate mindset.");
        this.Text("Kdsp-Npc-MaikoMaeda-Affiliation", "Tyger Claws | Clouds Manager");
        this.Text("Kdsp-Npc-MaikoMaeda-ThreatAssessment", "MODERATE (40/100) | Tyger Claws backing");
        this.Text("Kdsp-Npc-MaikoMaeda-Relationships", "Judy Alvarez (Ex)");
        this.Text("Kdsp-Npc-MaikoMaeda-Notes", "Pragmatic. Will sacrifice others for advancement.");
        this.Text("Kdsp-Npc-Woodman-Classification", "TYGER CLAWS - CLOUDS");
        this.Text("Kdsp-Npc-Woodman-Background", "Oswald Forrest. Clouds manager. Brutal management style. Exploits dolls.");
        this.Text("Kdsp-Npc-Woodman-CriminalRecord", "Suspected trafficking, assault | Tyger Claws protection");
        this.Text("Kdsp-Npc-Woodman-ThreatAssessment", "HIGH (65/100) | Combat capable | Tyger Claws backing");
        this.Text("Kdsp-Npc-Woodman-Notes", "Brutal and exploitative. Few would mourn him.");
        this.Text("Kdsp-Npc-PanamPalmer-Classification", "NOMAD - ALDECALDOS");
        this.Text("Kdsp-Npc-PanamPalmer-Background", "Born Aldecaldos. Expert driver and mechanic. Fiercely independent.");
        this.Text("Kdsp-Npc-PanamPalmer-Affiliation", "Aldecaldos | Driver");
        this.Text("Kdsp-Npc-PanamPalmer-CyberwareStatus", "Vehicle interface | Targeting optics | Minimal chrome");
        this.Text("Kdsp-Npc-PanamPalmer-ThreatAssessment", "HIGH (70/100) | Expert driver | Combat capable | Clan backup");
        this.Text("Kdsp-Npc-PanamPalmer-Relationships", "Aldecaldos (Family) | Saul (Complicated) | Mitch (Friend)");
        this.Text("Kdsp-Npc-PanamPalmer-Notes", "Do not threaten her family. Valuable ally, dangerous enemy.");
        this.Text("Kdsp-Npc-SaulBright-Classification", "NOMAD - ALDECALDOS");
        this.Text("Kdsp-Npc-SaulBright-Background", "Aldecaldos clan leader. Prioritizes clan survival. Pragmatic.");
        this.Text("Kdsp-Npc-SaulBright-Affiliation", "Aldecaldos | Clan Chief");
        this.Text("Kdsp-Npc-SaulBright-ThreatAssessment", "HIGH (65/100) | Commands clan | Dangerous when clan threatened");
        this.Text("Kdsp-Npc-SaulBright-Notes", "Decisions made for clan welfare. Can negotiate if mutual benefit.");
        this.Text("Kdsp-Npc-MitchAnderson-Classification", "NOMAD - ALDECALDOS");
        this.Text("Kdsp-Npc-MitchAnderson-Background", "Former military. Aldecaldos technician. Steady and reliable.");
        this.Text("Kdsp-Npc-MitchAnderson-CyberwareStatus", "Military-grade optics | Combat implants | Vehicle interface");
        this.Text("Kdsp-Npc-MitchAnderson-ThreatAssessment", "MODERATE (55/100) | Combat veteran");
        this.Text("Kdsp-Npc-MitchAnderson-Relationships", "Aldecaldos (Family) | Scorpion (Friend - deceased) | Panam (Friend)");
        this.Text("Kdsp-Npc-MitchAnderson-Notes", "Solid and dependable. Grieving recent losses.");
        this.Text("Kdsp-Npc-Brigitte-Classification", "██████ — ████████");
        this.Text("Kdsp-Npc-Brigitte-Background", "ERR_IDENT_MASK :: Kiroshi unable to resolve identity. Target running active counter-surveillance. Facial recognition: BLOCKED. Neural signature: SCRAMBLED. This person does not want to be seen.");
        this.Text("Kdsp-Npc-Brigitte-SignificantEvents", "DATA_CORRUPT :: ▓▓▓▓ netrunner interference detected ▓▓▓▓ :: Kiroshi firmware exception at 0x4E54 :: Deep scan returned null — target may be running military-grade ICE");
        this.Text("Kdsp-Npc-Brigitte-ThreatAssessment", "UNKNOWN | ⊘ SCANNER COMPROMISED — target is actively interfering with your optics. Proceed with extreme caution.");
        this.Text("Kdsp-Npc-Brigitte-Notes", "Your Kiroshi is being jammed. Whoever this is, they have the hardware to burn your optics from across the room. That alone tells you enough.");
        this.Text("Kdsp-Npc-Brigitte-Classification-1", "VOODOO BOYS - LEADER");
        this.Text("Kdsp-Npc-Brigitte-Background-1", "Maman Brigitte. VDB leader. Master netrunner. Obsessed with breaching Blackwall.");
        this.Text("Kdsp-Npc-Brigitte-Affiliation", "Voodoo Boys | Leader");
        this.Text("Kdsp-Npc-Brigitte-CyberwareStatus", "Elite netrunning suite | Blackwall-resistant mods");
        this.Text("Kdsp-Npc-Brigitte-ThreatAssessment-1", "EXTREME (85/100) | Master netrunner | Will betray anyone");
        this.Text("Kdsp-Npc-Brigitte-Relationships", "Placide (Lieutenant) | Haitian community");
        this.Text("Kdsp-Npc-Brigitte-Notes-1", "DANGEROUS. Views outsiders as tools. Do not trust.");
        this.Text("Kdsp-Npc-Placide-Classification", "██████ — ████████");
        this.Text("Kdsp-Npc-Placide-Background", "ERR_IDENT_PARTIAL :: Name resolution failed. Kiroshi returned fragmented data — possible counter-intrusion suite active. Subject appears to have local authority. Affiliation: MASKED.");
        this.Text("Kdsp-Npc-Placide-ThreatAssessment", "HIGH | ⊘ SCANNER DEGRADED — target's cyberware is pushing back against your scan. Physical profile suggests heavy augmentation and combat readiness.");
        this.Text("Kdsp-Npc-Placide-Notes", "Can't get a clean read. Whatever this person is running, it's shutting your Kiroshi down hard. The fact that they're doing it casually is the threat assessment.");
        this.Text("Kdsp-Npc-Placide-Classification-1", "VOODOO BOYS - LIEUTENANT");
        this.Text("Kdsp-Npc-Placide-Background-1", "VDB lieutenant. Enforcer. Handles external contacts. Hostile to outsiders.");
        this.Text("Kdsp-Npc-Placide-CyberwareStatus", "Combat netrunner suite | Physical augmentation");
        this.Text("Kdsp-Npc-Placide-ThreatAssessment-1", "HIGH (75/100) | Combat capable | Netrunner | VDB backup");
        this.Text("Kdsp-Npc-Placide-Notes-1", "Will follow betrayal orders without hesitation. Never turn back on him.");
        this.Text("Kdsp-Npc-Royce-Classification", "MAELSTROM - LEADER");
        this.Text("Kdsp-Npc-Royce-Background", "Maelstrom gang leader. Extreme modification. Unstable personality.");
        this.Text("Kdsp-Npc-Royce-CriminalRecord", "Murder, assault, arms dealing | Active warrants");
        this.Text("Kdsp-Npc-Royce-CyberwareStatus", "EXTREME | Multiple optics | Combat chassis | Cyberpsychosis risk: HIGH");
        this.Text("Kdsp-Npc-Royce-ThreatAssessment", "EXTREME (80/100) | Heavily chromed | Unpredictable");
        this.Text("Kdsp-Npc-Royce-Notes", "UNSTABLE. Cyberpsychosis indicators. Approach with extreme caution.");
        this.Text("Kdsp-Npc-DumDum-Classification", "MAELSTROM - LIEUTENANT");
        this.Text("Kdsp-Npc-DumDum-Background", "Maelstrom lieutenant. Heavily modified but more stable than leadership.");
        this.Text("Kdsp-Npc-DumDum-CyberwareStatus", "Extensive modification | Combat focused | Humanity: LOW");
        this.Text("Kdsp-Npc-DumDum-ThreatAssessment", "HIGH (70/100) | Combat cyborg | More stable than most Maelstrom");
        this.Text("Kdsp-Npc-DumDum-Notes", "Occasionally reasonable. Inhaler habit. Still will kill without hesitation.");
        this.Text("Kdsp-Npc-RiverWard-Classification", "NCPD - DETECTIVE");
        this.Text("Kdsp-Npc-RiverWard-Background", "NCPD detective. Sometimes bends rules for justice. Family man. Strong moral compass.");
        this.Text("Kdsp-Npc-RiverWard-Affiliation", "NCPD | Detective");
        this.Text("Kdsp-Npc-RiverWard-ThreatAssessment", "MODERATE (50/100) | Combat trained | NCPD resources");
        this.Text("Kdsp-Npc-RiverWard-Relationships", "Joss (Sister) | NCPD (Complicated)");
        this.Text("Kdsp-Npc-RiverWard-Notes", "Good cop in bad system. Trustworthy ally.");
        this.Text("Kdsp-Npc-JeffersonPeralez-Classification", "POLITICIAN - COMPROMISED");
        this.Text("Kdsp-Npc-JeffersonPeralez-Background", "Night City councilman. Frontrunner mayoral candidate. Anti-corruption platform. Previously retained V as private investigator. Public image remains spotless despite mounting anomalies in personal life.");
        this.Text("Kdsp-Npc-JeffersonPeralez-EarlyLife", "Law degree from Night City University. Entered politics young. Built reputation on transparency and anti-gang initiatives in Heywood. One of the few politicians not wholly owned by corporate interests.");
        this.Text("Kdsp-Npc-JeffersonPeralez-SignificantEvents", "City council election | Anti-corruption legislation | Mayor Rhyne investigation | Retained V for private case | Penthouse security breach | Anomalous behavioral shifts reported by close contacts");
        this.Text("Kdsp-Npc-JeffersonPeralez-Affiliation", "Night City Council | Mayoral Candidate");
        this.Text("Kdsp-Npc-JeffersonPeralez-CriminalRecord", "CLEAN | No charges | No warrants | Unusually clean for Night City politics");
        this.Text("Kdsp-Npc-JeffersonPeralez-CyberwareStatus", "Standard civilian suite | Personal link | Neural implants - ACTIVITY FLAGGED");
        this.Text("Kdsp-Npc-JeffersonPeralez-FinancialStatus", "Upper bracket | Campaign funding: legitimate sources verified | Personal assets: Charter Hill penthouse");
        this.Text("Kdsp-Npc-JeffersonPeralez-MedicalStatus", "FLAGGED: Anomalous neural patterns detected | Implant activity inconsistent with registered hardware | Memory engram irregularities | Subject unaware of condition");
        this.Text("Kdsp-Npc-JeffersonPeralez-ThreatAssessment", "LOW (15/100) | Non-combatant | Private security detail | THIRD-PARTY INTEREST FLAGGED");
        this.Text("Kdsp-Npc-JeffersonPeralez-Relationships", "Elizabeth Peralez (Wife) | Night City Council (Colleagues) | NCPD (Professional contacts)");
        this.Text("Kdsp-Npc-JeffersonPeralez-Notes", "Believes himself to be in full control of his own mind. He is not. Someone is rewriting Night City's next mayor from the inside.");
        this.Text("Kdsp-Npc-JeffersonPeralez-Classification-1", "POLITICIAN - MAYORAL CANDIDATE");
        this.Text("Kdsp-Npc-JeffersonPeralez-Background-1", "Night City councilman. Frontrunner mayoral candidate. Anti-corruption platform. Previously retained V as private investigator regarding Mayor Rhyne's death.");
        this.Text("Kdsp-Npc-JeffersonPeralez-EarlyLife-1", "Law degree from Night City University. Entered politics young. Built reputation on transparency and anti-gang initiatives in Heywood. One of the few politicians not wholly owned by corporate interests.");
        this.Text("Kdsp-Npc-JeffersonPeralez-SignificantEvents-1", "City council election | Anti-corruption legislation | Mayor Rhyne investigation | Retained V for private case");
        this.Text("Kdsp-Npc-JeffersonPeralez-Affiliation-1", "Night City Council | Mayoral Candidate");
    }

