        this.Text("Kdsp-Npc-ElizabethPeralez-CriminalRecord", "CLEAN | No charges | No warrants");
        this.Text("Kdsp-Npc-ElizabethPeralez-CyberwareStatus", "Standard civilian suite | Personal link | Neural implants - ACTIVITY FLAGGED: patterns mirror husband's anomalies");
        this.Text("Kdsp-Npc-ElizabethPeralez-FinancialStatus", "Upper bracket | Joint assets with Jefferson Peralez | Charter Hill penthouse");
        this.Text("Kdsp-Npc-ElizabethPeralez-MedicalStatus", "FLAGGED: Neural pattern anomalies consistent with husband's readings | Possible external influence on cognition and memory | Subject may be partially aware of condition");
        this.Text("Kdsp-Npc-ElizabethPeralez-ThreatAssessment", "LOW (10/100) | Non-combatant | Shares husband's security detail | THIRD-PARTY INTEREST FLAGGED");
