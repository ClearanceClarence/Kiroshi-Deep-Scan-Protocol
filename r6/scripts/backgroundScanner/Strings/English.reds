        this.Text("Kdsp-NCPDNameGenera-S0", "Gang Task Force");
        this.Text("Kdsp-NCPDNameGenera-S1", "Vista Del Rey");
        this.Text("Kdsp-NCPDProfileGen-S0", "Grew up in Heywood. Lost two siblings to gang violence before age 15.");
        this.Text("Kdsp-NCPDProfileGen-S1", "Watson native. Father was NCPD — killed during a routine traffic stop in Kabuki.");
        this.Text("Kdsp-NCPDProfileGen-S2", "Corporate brat. Family lost everything when Biotechnica restructured.");
        this.Text("Kdsp-NCPDProfileGen-S3", "Raised in a Megabuilding in Santo Domingo. Shared a 20-square-meter unit with six people.");
        this.Text("Kdsp-NCPDProfileGen-S4", "Military family. Three generations of service before Night City swallowed them.");
        this.Text("Kdsp-NCPDProfileGen-S5", "Orphaned young. Grew up in a Night City group home in Northside.");
        this.Text("Kdsp-NCPDProfileGen-S6", "Mother was Trauma Team. Father was a drunk. Standard Night City upbringing.");
        this.Text("Kdsp-NCPDProfileGen-S7", "Ex-Militech contractor. Saw things in the Corporate War that won't leave.");
        this.Text("Kdsp-NCPDProfileGen-S8", "Former gang associate. Valentinos-adjacent but never made — got out before initiation.");
        this.Text("Kdsp-NCPDProfileGen-S9", "Street kid from Arroyo. Watched friends get chewed up by the system one by one.");
        this.Text("Kdsp-NCPDProfileGen-S10", "Nomad background. Family clan dissolved when they hit Night City. Everyone scattered.");
        this.Text("Kdsp-NCPDProfileGen-S11", "Pacifica native. One of the few who made it out legally.");
        this.Text("Kdsp-NCPDProfileGen-S12", "Born in the Combat Zone. Doesn't talk about it.");
        this.Text("Kdsp-NCPDProfileGen-S13", "Third-generation NCPD. Grandfather walked a beat in Little China when it was still safe.");
        this.Text("Kdsp-NCPDProfileGen-S14", "Transferred from out of state. Previous department dissolved due to corruption charges.");
        this.Text("Kdsp-NCPDProfileGen-S15", "Former bouncer at Afterlife. Saw enough corpses to want a badge instead.");
        this.Text("Kdsp-NCPDProfileGen-S16", "Grew up in Westbrook. Watched the neighborhood gentrify while the crime went underground.");
        this.Text("Kdsp-NCPDProfileGen-S17", "Academy scholarship kid. First in the family to finish any kind of schooling.");
        this.Text("Kdsp-NCPDProfileGen-S18", "Came up through the NCPD cadet program. Been on the force since age 19.");
        this.Text("Kdsp-NCPDProfileGen-S19", "Former Arasaka security. Left after the Tower bombing. Wanted something that felt real.");
        this.Text("Kdsp-NCPDProfileGen-S20", "Japantown native. Speaks fluent Japanese. Recruited specifically for Tyger Claws intelligence.");
        this.Text("Kdsp-NCPDProfileGen-S21", "Single mother. Two kids. Took the badge because it was the only job with insurance.");
        this.Text("Kdsp-NCPDProfileGen-S22", "Ex-Trauma Team medic. Couldn't handle watching patients die because their coverage lapsed.");
        this.Text("Kdsp-NCPDProfileGen-S23", "Heywood born and raised. Uncle was Valentinos. Holidays are complicated.");
        this.Text("Kdsp-NCPDProfileGen-S24", "Former corporate accountant. Found irregularities. Reported them. Lost the job. Found a new one.");
        this.Text("Kdsp-NCPDProfileGen-S25", "Badlands kid. Walked into Night City at 17 with nothing. Badge gave structure.");
        this.Text("Kdsp-NCPDProfileGen-S26", "Rancho Coronado. Father was a factory foreman until automation took the plant.");
        this.Text("Kdsp-NCPDProfileGen-S27", "Night City born. Never left city limits. Doesn't know anything else.");
        this.Text("Kdsp-NCPDProfileGen-S28", "Former private investigator. Solo work paid worse and the hours were the same.");
        this.Text("Kdsp-NCPDProfileGen-S29", "The Glen native. Grew up hearing gunfire so often it stopped waking the family.");
        this.Text("Kdsp-NCPDProfileGen-S30", "Immigrant family. Parents worked three jobs each. Badge was the path to stability.");
        this.Text("Kdsp-NCPDProfileGen-S31", "Charter Hill upbringing. Comfortable, not wealthy. Wanted to do something that mattered.");
        this.Text("Kdsp-NCPDProfileGen-S32", "Kabuki market kid. Used to run messages for the Tyger Claws before a mentor pulled them out.");
        this.Text("Kdsp-NCPDProfileGen-S33", "Vista del Rey. Quiet neighborhood. Quiet childhood. Then the neighbor turned out to be a Scav.");
        this.Text("Kdsp-NCPDProfileGen-S34", "Former paramedic. Burned out after a mass-casualty Cyberpsycho incident in Watson.");
        this.Text("Kdsp-NCPDProfileGen-S35", "Coastal town, south of Night City. Moved in for a relationship. Relationship didn't last. Job did.");
        this.Text("Kdsp-NCPDProfileGen-S36", "Corpo kid turned street kid turned cop. The full Night City progression.");
        this.Text("Kdsp-NCPDProfileGen-S37", "Mother was NCPD dispatch. Grew up listening to calls on a scanner. Knew every code by age 12.");
        this.Text("Kdsp-NCPDProfileGen-S38", "Grew up near Reconciliation Park. Remembers when they built the memorial. Took the oath that year.");
        this.Text("Kdsp-NCPDProfileGen-S39", "Night City native. Details of early life not on file.");
        this.Text("Kdsp-NCPDProfileGen-S40", "Academy graduate. Middling scores. Assigned to patrol.");
        this.Text("Kdsp-NCPDProfileGen-S41", "Top of the academy class. Had options. Chose patrol anyway.");
        this.Text("Kdsp-NCPDProfileGen-S42", "Academy washout first try. Reapplied. Made it the second time.");
        this.Text("Kdsp-NCPDProfileGen-S43", "Fast-tracked through academy after Militech recommendation.");
        this.Text("Kdsp-NCPDProfileGen-S44", "Hired directly from private security. Skipped half the academy.");
        this.Text("Kdsp-NCPDProfileGen-S45", "Completed academy during a recruitment surge. Standards were lower that year.");
        this.Text("Kdsp-NCPDProfileGen-S46", "Military-to-NCPD pipeline. Combat experience counted for academy credits.");
        this.Text("Kdsp-NCPDProfileGen-S47", "Academy graduate. Wanted detective. Got patrol. Hasn't let go of that.");
        this.Text("Kdsp-NCPDProfileGen-S48", "Recruited after civilian involvement in stopping a robbery. NCPD saw potential.");
        this.Text("Kdsp-NCPDProfileGen-S49", "Family connections got them into the academy. Performance since has been their own.");
        this.Text("Kdsp-NCPDProfileGen-S50", "Academy graduate. Only person in the class who actually wanted to be a cop.");
        this.Text("Kdsp-NCPDProfileGen-S51", "Former NCPD civilian employee. Decided to go active after seeing what dispatch deals with.");
        this.Text("Kdsp-NCPDProfileGen-S52", "Lateral transfer from another city's department. Night City was supposed to be temporary.");
        this.Text("Kdsp-NCPDProfileGen-S53", "Academy dropout originally. Came back after the DataKrash when they needed everyone.");
        this.Text("Kdsp-NCPDProfileGen-S54", "Completed academy with a broken wrist. Refused to delay graduation.");
        this.Text("Kdsp-NCPDProfileGen-S55", "Joined during the recruitment crisis. They were taking anyone with a pulse and a clean record.");
        this.Text("Kdsp-NCPDProfileGen-S56", "Academy honors. Top marksman. Bottom interpersonal skills.");
        this.Text("Kdsp-NCPDProfileGen-S57", "Got in on a diversity initiative. Has spent every day since proving it wasn't a handout.");
        this.Text("Kdsp-NCPDProfileGen-S58", "Former CI. Became an informant, then decided the other side of the badge paid better.");
        this.Text("Kdsp-NCPDProfileGen-S59", "Academy graduate. Nothing special. Nothing terrible. Just a cop.");
        this.Text("Kdsp-NCPDProfileGen-S60", "Recruited by an NCPD officer who saw them break up a fight bare-handed in Kabuki.");
        this.Text("Kdsp-NCPDProfileGen-S61", "Completed a compressed 12-week wartime academy program. Knows the gaps in the training.");
        this.Text("Kdsp-NCPDProfileGen-S62", "Transferred from corporate judicial enforcement. Prefers street work.");
        this.Text("Kdsp-NCPDProfileGen-S63", "Academy class had a 40% attrition rate. This one stuck.");
        this.Text("Kdsp-NCPDProfileGen-S64", "Standard academy pipeline. Unremarkable entry.");
        this.Text("Kdsp-NCPDProfileGen-S65", "First partner was killed during a Maelstrom raid in Northside. Still carries the badge.");
        this.Text("Kdsp-NCPDProfileGen-S66", "Involved in a high-profile shootout in Watson during first year. Three suspects dead. Internal review cleared.");
        this.Text("Kdsp-NCPDProfileGen-S67", "Discovered a corruption ring in own precinct. Reported it. Got transferred to Pacifica as thanks.");
        this.Text("Kdsp-NCPDProfileGen-S68", "First month on patrol: responded to a Cyberpsycho incident alone. Survived. Earned a commendation and a prescription for sleep aids.");
        this.Text("Kdsp-NCPDProfileGen-S69", "Shot during a routine domestic call in Heywood. Vest caught it. Off the street for three months.");
        this.Text("Kdsp-NCPDProfileGen-S70", "Found a Scavenger den in a basement during a noise complaint. 14 victims recovered, 3 alive.");
        this.Text("Kdsp-NCPDProfileGen-S71", "Former partner went dirty — took bribes from Tyger Claws. Internal Affairs pulled them both in. Cleared after 6 months.");
        this.Text("Kdsp-NCPDProfileGen-S72", "First arrest was a corpo executive for vehicular manslaughter. Case got buried. Learned how Night City works.");
        this.Text("Kdsp-NCPDProfileGen-S73", "Witnessed a MaxTac takedown firsthand during a Cyberpsycho call in Japantown. Nightmares for months.");
        this.Text("Kdsp-NCPDProfileGen-S74", "Saved a child during a gang crossfire in The Glen. Only good thing that happened that year.");
        this.Text("Kdsp-NCPDProfileGen-S75", "Walked in on a braindance snuff operation in Kabuki. Can't watch BDs anymore.");
        this.Text("Kdsp-NCPDProfileGen-S76", "Early career marked by excessive force complaints. Three investigations. All inconclusive.");
        this.Text("Kdsp-NCPDProfileGen-S77", "Responded to a bombing at a food processing plant. First mass casualty scene. Still smells the smoke sometimes.");
        this.Text("Kdsp-NCPDProfileGen-S78", "Partner retired early due to PTSD after a hostage situation went wrong in Santo Domingo.");
        this.Text("Kdsp-NCPDProfileGen-S79", "Worked undercover in the Valentinos for 8 months. Cover wasn't blown. But some loyalties got complicated.");
        this.Text("Kdsp-NCPDProfileGen-S80", "Caught falsifying a report to protect a CI. Disciplinary action. Career nearly ended. Didn't.");
        this.Text("Kdsp-NCPDProfileGen-S81", "Refused to take a bribe from 6th Street during a traffic stop. Got a brick through the apartment window that night.");
        this.Text("Kdsp-NCPDProfileGen-S82", "First-year ride-along went sideways when the patrol car was ambushed by Scavengers near the dam.");
        this.Text("Kdsp-NCPDProfileGen-S83", "Broke up an illegal implant surgery in progress. Patient died on the table. Surgeon escaped.");
        this.Text("Kdsp-NCPDProfileGen-S84", "Transferred precincts three times in two years. Not by choice.");
        this.Text("Kdsp-NCPDProfileGen-S85", "Early commendation for talking down a suicidal jumper on the Corpo Plaza overpass.");
        this.Text("Kdsp-NCPDProfileGen-S86", "Arrested a city councilman's son for assault. Charges dropped within hours. Learned the lesson.");
        this.Text("Kdsp-NCPDProfileGen-S87", "Chased a Wraith convoy into Badlands jurisdiction. Got reprimanded. Caught the driver anyway.");
        this.Text("Kdsp-NCPDProfileGen-S88", "Worked the Jig-Jig Street beat for 14 months. Requested transfer. Denied. Requested again. Granted.");
        this.Text("Kdsp-NCPDProfileGen-S89", "Partnered with a 20-year veteran who taught everything the academy didn't. Retired last year.");
        this.Text("Kdsp-NCPDProfileGen-S90", "Accidentally discharged weapon in a parking garage. No injuries. The paperwork lasted longer than the investigation.");
        this.Text("Kdsp-NCPDProfileGen-S91", "Pulled over an unmarked Arasaka vehicle. Got a phone call from the precinct captain within 4 minutes.");
        this.Text("Kdsp-NCPDProfileGen-S92", "Investigated a series of missing persons in Wellsprings. Trail went cold. Cases still open.");
        this.Text("Kdsp-NCPDProfileGen-S93", "Was first on scene to a Cyberpsycho attack at a ramen shop in Little China. Civilians dead before backup arrived.");
        this.Text("Kdsp-NCPDProfileGen-S94", "Rotated through the evidence locker for 6 months after a knee injury. Noticed items going missing. Didn't report it.");
        this.Text("Kdsp-NCPDProfileGen-S95", "Worked crowd control during the anti-corpo riots. Got hit with a bottle. Still has the scar.");
        this.Text("Kdsp-NCPDProfileGen-S96", "Investigated own neighbor for domestic abuse. Case went to trial. Moved apartments the same week.");
        this.Text("Kdsp-NCPDProfileGen-S97", "Spent two years in the cybercrimes unit. The braindance cases are the ones that stick.");
        this.Text("Kdsp-NCPDProfileGen-S98", "Pulled a driver from a burning car after a chase. Received a commendation. Never mentioned it.");
        this.Text("Kdsp-NCPDProfileGen-S99", "Early career was clean. Too clean. Colleagues suspected a plant. IA confirmed they weren't. Trust was never fully rebuilt.");
        this.Text("Kdsp-NCPDProfileGen-S100", "Took a bullet in a Scavenger warehouse raid. Spent 8 weeks recovering. Came back harder.");
        this.Text("Kdsp-NCPDProfileGen-S101", "Was assigned to escort a corpo witness. Witness was killed in transit. Investigation found no fault. Doesn't help.");
        this.Text("Kdsp-NCPDProfileGen-S102", "First year ended with a formal complaint from a Militech attorney. File sealed.");
        this.Text("Kdsp-NCPDProfileGen-S103", "Found a dead officer in a patrol car during a night shift. Carbon monoxide. The department called it an accident.");
        this.Text("Kdsp-NCPDProfileGen-S104", "Early career was unremarkable. Which in Night City counts as lucky.");
        this.Text("Kdsp-NCPDProfileGen-S105", "Marksmanship scores consistently above average.");
        this.Text("Kdsp-NCPDProfileGen-S106", "Has requested transfer to Homicide four times. Denied each time.");
        this.Text("Kdsp-NCPDProfileGen-S107", "Known to work doubles without logging overtime.");
        this.Text("Kdsp-NCPDProfileGen-S108", "Psych evaluation flagged elevated stress markers. Cleared for duty anyway.");
        this.Text("Kdsp-NCPDProfileGen-S109", "Popular with patrol. Unpopular with administration.");
        this.Text("Kdsp-NCPDProfileGen-S110", "Three IA investigations. Zero findings. Either clean or careful.");
        this.Text("Kdsp-NCPDProfileGen-S111", "Known to look the other way on minor drug offenses. Prioritizes violent crime.");
        this.Text("Kdsp-NCPDProfileGen-S112", "Volunteers for Pacifica shifts that nobody else wants.");
        this.Text("Kdsp-NCPDProfileGen-S113", "Carries a backup piece. Department doesn't know about it.");
        this.Text("Kdsp-NCPDProfileGen-S114", "Quietly pays a CI out of pocket when the department budget runs dry.");
        this.Text("Kdsp-NCPDProfileGen-S115", "Has turned down promotions twice. Prefers the street.");
        this.Text("Kdsp-NCPDProfileGen-S116", "Drinks after shift. Every shift. Functional.");
        this.Text("Kdsp-NCPDProfileGen-S117", "Keeps a flask in the patrol car. Everyone knows. Nobody says anything.");
        this.Text("Kdsp-NCPDProfileGen-S118", "Mentors new academy graduates. Doesn't sugarcoat what they're walking into.");
        this.Text("Kdsp-NCPDProfileGen-S119", "Badge number has been flagged by the Valentinos. Drives a different route home every night.");
        this.Text("Kdsp-NCPDProfileGen-S120", "Sleeps in the precinct locker room more often than at home.");
        this.Text("Kdsp-NCPDProfileGen-S121", "Reputation for paperwork accuracy. Files every report on time. Colleagues find it suspicious.");
        this.Text("Kdsp-NCPDProfileGen-S122", "Maintains contacts in three gangs. NCPD Intelligence knows about two of them.");
        this.Text("Kdsp-NCPDProfileGen-S123", "Weapon has been discharged in the line of duty 4 times. Each one documented and justified.");
        this.Text("Kdsp-NCPDProfileGen-S124", "Avoids corpo-adjacent cases. Doesn't say why.");
        this.Text("Kdsp-NCPDProfileGen-S125", "Known for being the last one to leave the precinct. First one in.");
        this.Text("Kdsp-NCPDProfileGen-S126", "Carries a photo of someone in the vest pocket. Never talks about it.");
        this.Text("Kdsp-NCPDProfileGen-S127", "Fluent in street slang for three gang territories. Useful during interrogations.");
        this.Text("Kdsp-NCPDProfileGen-S128", "Standard performance metrics. No red flags. No commendations.");
        this.Text("Kdsp-NCPDProfileGen-S129", "Currently assigned to gang task force operations in Watson.");
        this.Text("Kdsp-NCPDProfileGen-S130", "On standard patrol rotation. Third consecutive month without incident.");
        this.Text("Kdsp-NCPDProfileGen-S131", "Recently returned from administrative leave following an officer-involved shooting.");
        this.Text("Kdsp-NCPDProfileGen-S132", "Under Internal Affairs review. Allegations of excessive force during an arrest in Kabuki.");
        this.Text("Kdsp-NCPDProfileGen-S133", "Currently working overtime due to staffing shortages in the precinct.");
        this.Text("Kdsp-NCPDProfileGen-S134", "Assigned to a joint NCPD-Militech operation. Details classified.");
        this.Text("Kdsp-NCPDProfileGen-S135", "On light duty following a knee injury sustained during a foot chase.");
        this.Text("Kdsp-NCPDProfileGen-S136", "Recently completed mandatory anger management counseling. Back on full duty.");
        this.Text("Kdsp-NCPDProfileGen-S137", "Temporarily assigned to evidence processing after a complaint from a local politician.");
        this.Text("Kdsp-NCPDProfileGen-S138", "Just returned from two weeks compassionate leave. Partner was killed in the line of duty.");
        this.Text("Kdsp-NCPDProfileGen-S139", "Assigned to community liaison in Heywood. Considered a demotion by everyone including the officer.");
        this.Text("Kdsp-NCPDProfileGen-S140", "Recently passed the detective examination. Waiting list is 18 months.");
        this.Text("Kdsp-NCPDProfileGen-S141", "Pulled from undercover assignment after cover was compromised. Currently on desk duty.");
        this.Text("Kdsp-NCPDProfileGen-S142", "On rotation in the Badlands checkpoint. Two more weeks until city reassignment.");
        this.Text("Kdsp-NCPDProfileGen-S143", "Currently mentoring a rookie. Third one this year. The other two quit.");
        this.Text("Kdsp-NCPDProfileGen-S144", "Operating in Pacifica with reduced backup. Standard for the district.");
        this.Text("Kdsp-NCPDProfileGen-S145", "Involved in a vehicle pursuit last week that ended in a civilian injury. Review pending.");
        this.Text("Kdsp-NCPDProfileGen-S146", "Recently transferred from Japantown precinct after receiving threats from Tyger Claws.");
        this.Text("Kdsp-NCPDProfileGen-S147", "Assigned to the Cyberpsycho response hotline. Mostly coordinates with MaxTac.");
        this.Text("Kdsp-NCPDProfileGen-S148", "Working double shifts to cover for a colleague on medical leave.");
        this.Text("Kdsp-NCPDProfileGen-S149", "On traffic duty following a suspension. Three more weeks.");
        this.Text("Kdsp-NCPDProfileGen-S150", "Just completed a raid on a Scavenger operation. Sixteen arrests. Paperwork ongoing.");
        this.Text("Kdsp-NCPDProfileGen-S151", "Suspended with pay pending investigation into missing evidence from a drug bust.");
        this.Text("Kdsp-NCPDProfileGen-S152", "Currently operating a DUI checkpoint in City Center. Low-risk assignment.");
        this.Text("Kdsp-NCPDProfileGen-S153", "Reassigned from Gang Intelligence to Patrol after budget cuts eliminated the unit.");
        this.Text("Kdsp-NCPDProfileGen-S154", "On the Maelstrom watch list after a raid in the All Foods plant area.");
    }

    private func DefineTexts16() -> Void {
        this.Text("Kdsp-NCPDProfileGen-S155", "Working plainclothes in Jig-Jig Street. Vice operation targeting illegal braindance vendors.");
        this.Text("Kdsp-NCPDProfileGen-S156", "Spent last month providing security for a city council hearing. Uneventful.");
        this.Text("Kdsp-NCPDProfileGen-S157", "Currently part of the precinct's crisis negotiation team. Two callouts this month.");
        this.Text("Kdsp-NCPDProfileGen-S158", "Back on patrol after six months desk duty due to a back injury from a car accident.");
        this.Text("Kdsp-NCPDProfileGen-S159", "Assigned to a stakeout in Santo Domingo. Target hasn't shown in three weeks.");
        this.Text("Kdsp-NCPDProfileGen-S160", "Volunteered for the Night City Marathon security detail. Straightforward assignment.");
        this.Text("Kdsp-NCPDProfileGen-S161", "Currently assigned to courthouse security. Temporary. Boring. Preferred.");
        this.Text("Kdsp-NCPDProfileGen-S162", "Working the night shift in Northside. Nobody volunteers for the night shift in Northside.");
        this.Text("Kdsp-NCPDProfileGen-S163", "Conducting welfare checks in a Megabuilding after three overdose deaths in one week.");
        this.Text("Kdsp-NCPDProfileGen-S164", "Investigating a string of car thefts near Corpo Plaza. Low priority but steady work.");
        this.Text("Kdsp-NCPDProfileGen-S165", "Recently attended a fellow officer's funeral. Third one this year.");
        this.Text("Kdsp-NCPDProfileGen-S166", "Temporarily embedded with a Trauma Team unit for a cross-training program.");
        this.Text("Kdsp-NCPDProfileGen-S167", "Standard patrol duties. No notable assignments.");
        this.Text("Kdsp-NCPDProfileGen-S168", "Promotion board next quarter. Chances are decent.");
        this.Text("Kdsp-NCPDProfileGen-S169", "Has been asking about early retirement options.");
        this.Text("Kdsp-NCPDProfileGen-S170", "Considering a transfer to a quieter district. If one exists.");
        this.Text("Kdsp-NCPDProfileGen-S171", "Marriage is falling apart. Comes to work to avoid going home.");
        this.Text("Kdsp-NCPDProfileGen-S172", "Recently started seeing a department therapist. Off the record.");
        this.Text("Kdsp-NCPDProfileGen-S173", "An old informant resurfaced with intel on a major case. Deciding whether to pursue it.");
        this.Text("Kdsp-NCPDProfileGen-S174", "Received a threat at home address. Source unknown. Request for protection detail denied.");
        this.Text("Kdsp-NCPDProfileGen-S175", "Studying for the sergeant exam. Third attempt.");
        this.Text("Kdsp-NCPDProfileGen-S176", "Being recruited by corporate security. The pay is triple. Hasn't decided yet.");
        this.Text("Kdsp-NCPDProfileGen-S177", "A fixer has been making offers. No response yet. The department doesn't know.");
        this.Text("Kdsp-NCPDProfileGen-S178", "Morale is low. Colleagues are leaving for private sector. The ones left are stretched thin.");
        this.Text("Kdsp-NCPDProfileGen-S179", "Has a disciplinary hearing next month over a use-of-force report.");
        this.Text("Kdsp-NCPDProfileGen-S180", "Recently broke off a relationship. Throwing more hours into the job.");
        this.Text("Kdsp-NCPDProfileGen-S181", "Saving money for a transfer to a different city. If any are hiring.");
        this.Text("Kdsp-NCPDProfileGen-S182", "Union rep approached about filing a grievance against the precinct commander.");
        this.Text("Kdsp-NCPDProfileGen-S183", "Quietly documenting irregularities in the evidence chain. Not sure what to do with it.");
        this.Text("Kdsp-NCPDProfileGen-S184", "A journalist has been asking questions about an old case. Avoiding the calls.");
        this.Text("Kdsp-NCPDProfileGen-S185", "Looking into private investigation licensing. Just in case.");
        this.Text("Kdsp-NCPDProfileGen-S186", "New partner is untested. Trust hasn't been established yet.");
        this.Text("Kdsp-NCPDProfileGen-S187", "Department-mandated fitness test next week. Not worried. Should be.");
        this.Text("Kdsp-NCPDProfileGen-S188", "Has been volunteering at a youth center in Heywood on days off. Doesn't put it on the resume.");
        this.Text("Kdsp-NCPDProfileGen-S189", "Internal Affairs called. Wouldn't say what about. That was three days ago.");
        this.Text("Kdsp-NCPDProfileGen-S190", "Considering applying for MaxTac. The psychological screening is the obstacle.");
        this.Text("Kdsp-NCPDProfileGen-S191", "Something happened on a recent call. Won't talk about it. Colleagues have noticed the change.");
        this.Text("Kdsp-NCPDProfileGen-S192", "The precinct is being restructured. Everyone's position is under review.");
        this.Text("Kdsp-NCPDProfileGen-S193", "Recently recognized by a gang member in a grocery store. Changed routines immediately.");
        this.Text("Kdsp-NCPDProfileGen-S194", "Pension vests in 18 months. Counting the days.");
        this.Text("Kdsp-NCPDProfileGen-S195", "Just found out the department is cutting the mental health benefit. Planning to speak up at the union meeting.");
        this.Text("Kdsp-NCPDProfileGen-S196", "No pending developments.");
