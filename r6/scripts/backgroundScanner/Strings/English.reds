        this.Text("Kdsp-Home-LIVED_LITTLE_CHINA", "Lived in Little China, Watson. ");
        this.Text("Kdsp-Home-LIVED_SHELTER", "Stayed in shelters for months. ");
        this.Text("Kdsp-Home-LIVED_STAIRWELL", "Slept in megabuilding stairwells. ");
        this.Text("Kdsp-Home-LIVED_LAUNDROMAT", "Slept in a 24-hour laundromat. ");
        this.Text("Kdsp-Home-LIVED_ARCADE", "Crashed in the back of an arcade. ");
        this.Text("Kdsp-Home-LIVED_CONVERTED_BUS", "Lived in a converted bus. ");
        this.Text("Kdsp-Home-LIVED_COMM_TOWER", "Squatted in an abandoned comm tower. ");
        this.Text("Kdsp-Home-LIVED_BILLBOARD", "Made a shelter behind a massive billboard. ");
        this.Text("Kdsp-Home-LIVED_SERVER_ROOM", "Lived in a decommissioned server room. ");
        this.Text("Kdsp-Home-LIVED_CRANE", "Squatted in a construction crane cab. ");
        this.Text("Kdsp-Home-LIVED_FIRST_APT", "Got %his% first apartment. One room, no windows. ");
        this.Text("Kdsp-Home-LIVED_PENTHOUSE", "Briefly lived in a penthouse. ");
        this.Text("Kdsp-Home-LIVED_SHARED_APT", "Shared an apartment with five others. ");
        this.Text("Kdsp-Home-LIVED_ABOVE_BAR", "Lived above a bar. Never slept well. ");
        this.Text("Kdsp-Home-LIVED_BACK_SHOP", "Lived in the back of a shop. ");
        this.Text("Kdsp-Home-LIVED_RIPPER_CLINIC", "Lived above a ripperdoc clinic. ");
        this.Text("Kdsp-Home-LIVED_MEGA_H4", "Lived in Megabuilding H4. Twelve years on the same floor. ");
        this.Text("Kdsp-Home-LIVED_MEGA_H2", "Lived in Megabuilding H2 before the water reclamation failed. ");
        this.Text("Kdsp-Home-LIVED_CAPSULE", "Rented a capsule pod in Kabuki. 2 square meters, shared bathroom, no windows. ");
        this.Text("Kdsp-Home-LIVED_STACKED", "Lived in a stacked container block in Rancho Coronado. ");
        this.Text("Kdsp-Home-LIVED_MARINA_BOAT", "Lived on a boat in the marina. Engine hasn't run since '71. ");
        this.Text("Kdsp-Home-LIVED_ROOFTOP_SHACK", "Built a shack on a Watson rooftop. Landlord never found out. ");
        this.Text("Kdsp-Home-LIVED_OLD_METRO", "Squatted in a decommissioned NCART station with a dozen others. ");
        this.Text("Kdsp-Home-LIVED_CORPO_RUIN", "Squatted in a bankrupt corpo's abandoned office tower. Still had power on floor 12. ");
        this.Text("Kdsp-Home-LIVED_MOTEL_MONTH", "Lived month-to-month in a Santo Domingo motel. Paid in cash. ");
        this.Text("Kdsp-Home-LIVED_LANDFILL_EDGE", "Lived at the edge of the landfill. The smell stopped registering after a year. ");
        this.Text("Kdsp-Home-LIVED_BADLANDS_TRAILER", "Lived in a trailer in the Badlands. Solar rig and a water condenser. ");
        this.Text("Kdsp-Home-LIVED_CLAN_CONVOY", "Grew up moving with a nomad convoy. Home was wherever the engines stopped. ");
        this.Text("Kdsp-Home-LIVED_ABOVE_SHOP", "Lived above the family shop. Commute was a staircase. ");
        this.Text("Kdsp-Home-LIVED_SRO_NORTHSIDE", "Lived in a single-room occupancy in Northside. Shared kitchen, no questions. ");
        this.Text("Kdsp-Home-LIVED_JAPANTOWN_MICRO", "Rented a Japantown micro-apartment. Bed folds into the wall, desk folds out of it. ");
        this.Text("Kdsp-Home-LIVED_CHARTER_HILL", "Lived in Charter Hill back when the family had corpo money. ");
        this.Text("Kdsp-Home-LIVED_BASEMENT_SUB", "Sublet a basement unit with no egress and one outlet. Landlord called it cozy. ");
        this.Text("Kdsp-Home-LIVED_GLEN_WALKUP", "Lived in a fourth-floor walkup in The Glen. Elevator's been broken since before the move-in. ");
        this.Text("Kdsp-Home-EVICTED_MEGACORP", "Evicted when a megacorp bought the block for redevelopment that never happened. ");
        this.Text("Kdsp-Home-EVICTED_RENT_ALGO", "Evicted by an automated rent adjustment. Never spoke to a human about it. ");
        this.Text("Kdsp-Home-HOUSE_FIRE_ARSON", "Lost the apartment to a fire. Insurance called it arson. Never charged anyone. ");
        this.Text("Kdsp-Home-BUILDING_CONDEMNED", "Building was condemned mid-lease. Got 72 hours to clear out. ");
        this.Text("Kdsp-Home-INHERITED_UNIT", "Inherited a unit from a grandmother. First stable address in years. ");
        this.Text("Kdsp-Home-RENT_CONTROLLED", "Landed a rent-controlled unit through a housing lottery. Defends it like territory. ");
        this.Text("Kdsp-Home-ROOMMATE_SEVEN", "Shared a two-bedroom with seven people. Slept in shifts. ");
        this.Text("Kdsp-Home-LIVED_PACIFICA_HOTEL", "Lived in a half-finished Pacifica resort hotel. Ocean view, no running water. ");
        this.Text("Kdsp-Home-LIVED_DOGTOWN_BLOCK", "Lived in a Dogtown block controlled by Barghest. Rent paid in favors. ");
        this.Text("Kdsp-Home-LIVED_ARROYO_INDUSTRIAL", "Lived in an Arroyo industrial conversion. Forklift noise at 5 AM, every day. ");
        this.Text("Kdsp-Home-LIVED_COASTVIEW_WALKUP", "Lived in a Coastview walkup with a view of the combat zone. ");
        this.Text("Kdsp-Home-SLEPT_WORKPLACE", "Slept at the workplace for a year to save rent. Boss never knew. ");
        this.Text("Kdsp-Home-LIVED_STORAGE_UNIT", "Lived in a climate-controlled storage unit. Better insulated than most apartments. ");
        this.Text("Kdsp-Home-HOME_FLOODED", "Ground-floor unit flooded three times in one rainy season. Kept living there. ");
        this.Text("Kdsp-Home-LIVED_NEAR_POWERPLANT", "Lived next to the power plant. The hum gets into your teeth. ");
        this.Text("Kdsp-Home-LIVED_WITH_GRANDPARENTS_ADULT", "Moved back in with grandparents at 30. Nobody talks about it. ");
        this.Text("Kdsp-Home-HOUSING_COOP", "Joined a housing cooperative. Meetings are hell but the rent is honest. ");
        this.Text("Kdsp-Home-LIVED_MAELSTROM_EDGE", "Lived two blocks from Maelstrom territory. Learned which streets change at night. ");
        this.Text("Kdsp-Home-APARTMENT_BUGGED", "Found surveillance devices in the apartment. Moved out the same week. Never learned who. ");
        this.Text("Kdsp-Home-LIVED_LUXURY_SUBLET", "Illegally sublet a luxury apartment from a corpo on foreign assignment for two years. ");
        this.Text("Kdsp-Home-BUILDING_GANG_TAX", "Building charged a 'security fee' collected by the local gang. Cheaper than insurance. ");
        this.Text("Kdsp-Job-JOB_LOCAL_FIXER", "Started doing jobs for a local fixer. ");
        this.Text("Kdsp-Job-JOB_ROB_APT", "Started robbing apartments for cash. ");
        this.Text("Kdsp-Job-JOB_HOMELESS", "Began begging for money in the street. ");
        this.Text("Kdsp-Job-JOB_DRUG_RUNNER", "Started working as a drug runner for nomads. ");
        this.Text("Kdsp-Job-JOB_ARMS_DEALER", "Started working as an arms dealer for nomads. ");
        this.Text("Kdsp-Job-JOB_BOOTLEGGER", "Started working as a whiskey bootlegger for nomads. ");
        this.Text("Kdsp-Job-JOB_MERC", "Started working as a mercenary. ");
        this.Text("Kdsp-Job-JOB_SOLO", "Became a solo for hire. ");
        this.Text("Kdsp-Job-JOB_HITMAN", "Started working as a contract killer. ");
        this.Text("Kdsp-Job-JOB_ENFORCER", "Became an enforcer for a local gang. ");
        this.Text("Kdsp-Job-JOB_SMUGGLER", "Started smuggling goods across the border. ");
        this.Text("Kdsp-Job-JOB_FENCE", "Started fencing stolen goods. ");
        this.Text("Kdsp-Job-JOB_CARJACKER", "Started boosting cars professionally. ");
        this.Text("Kdsp-Job-JOB_ORGAN_RUNNER", "Started running organs for Scavs. ");
        this.Text("Kdsp-Job-JOB_DATA_THIEF", "Became a professional data thief. ");
