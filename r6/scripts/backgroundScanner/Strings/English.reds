        this.Text("Kdsp-Npc-AntonKolev-CriminalRecord", "NCPD PRIORITY | Violent crimes");
        this.Text("Kdsp-Npc-AntonKolev-ThreatAssessment", "HIGH | Armed | Eastern European criminal connections");
        this.Text("Kdsp-Npc-JohnQuaid-Classification", "CRIMINAL - NCPD TARGET");
