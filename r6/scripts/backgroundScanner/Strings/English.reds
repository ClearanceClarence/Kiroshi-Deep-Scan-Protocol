        this.Text("Kdsp-Adult-ADULT_PIGEON_KEEPER", "Keeps racing pigeons on the roof. Illegal in the building code. Beloved on the block. ");
        this.Text("Kdsp-Adult-ADULT_TRIVIA_CHAMPION", "Three-time champion of a Kabuki bar's trivia night. The trophy is a spray-painted boot. ");
        this.Text("Kdsp-Adult-ADULT_STREET_HISTORIAN", "Unofficial historian of the block. Remembers every business that ever held the corner lease. ");
        this.Text("Kdsp-Adult-ADULT_WALKS_DOGS", "Walks dogs for shut-ins in the building. Doesn't charge the ones on fixed income. ");
        this.Text("Kdsp-Adult-ADULT_COLLECTS_MAPS", "Collects paper maps of old Night City. Owns editions the city archive doesn't. ");
        this.Text("Kdsp-Adult-ADULT_MAHJONG_CIRCLE", "Plays mahjong Tuesdays with the aunties on floor nine. Loses on purpose. Sometimes. ");
        this.Text("Kdsp-Adult-ADULT_BALCONY_ASTRONOMER", "Stargazes from the balcony with a homemade scope. Light pollution wins most nights. ");
        this.Text("Kdsp-Adult-ADULT_LETTERS_ABROAD", "Writes actual paper letters to a cousin in the EU. Takes months. Worth it. ");
        this.Text("Kdsp-Adult-ADULT_REPAIRS_FREE", "Fixes neighbors' appliances for free. Payment arrives anyway: tamales, favors, respect. ");
        this.Text("Kdsp-Adult-ADULT_KARAOKE_REGULAR", "Owns one karaoke song and performs it like a sworn duty every Friday. ");
        this.Text("Kdsp-Adult-ADULT_QUIET_LIFE", "No record, no debts, no drama. In Night City, statistically remarkable. ");
        this.Text("Kdsp-Adult-ADULT_MEMORIZED_BUS", "Has the entire NCART schedule memorized. People plan trips by asking. ");
        this.Text("Kdsp-Adult-ADULT_SUNDAY_MARKET", "Hasn't missed the Sunday market in Heywood in six years. The vendors hold things aside. ");
        this.Text("Kdsp-Adult-ADULT_TEACHES_LITERACY", "Teaches reading at the community center two nights a week. ");
        this.Text("Kdsp-Adult-ADULT_OLD_CAR_RESTORE", "Restoring a 2040s sedan in a rented garage bay. Five years in. Almost runs. ");
        this.Text("Kdsp-Adult-ADULT_ROOFTOP_MOVIES", "Runs a rooftop movie night in summer. Projector, bedsheet, whoever shows up. ");
        this.Text("Kdsp-Adult-ADULT_KEEPS_BEES", "Keeps bees on the roof. The honey sells out in a day. City says it's illegal. City buys it anyway. ");
        this.Text("Kdsp-Adult-ADULT_ANNIVERSARY_DINER", "Eats at the same diner every anniversary of getting to Night City. Orders the same thing. ");
        this.Text("Kdsp-Adult-ADULT_HOSPITAL_VISITS", "Visits a hospitalized friend every week. Two years now. Never missed one. ");
