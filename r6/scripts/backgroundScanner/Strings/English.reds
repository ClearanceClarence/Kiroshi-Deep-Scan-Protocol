        this.Text("Kdsp-Npc-JermaineNorton-ThreatAssessment", "MODERATE | Combat capable | Can be intimidated by sufficient reputation | Professional");
        this.Text("Kdsp-Npc-ZaneJagger-Classification", "VENDOR - HIGH-END RETAIL");
        this.Text("Kdsp-Npc-ZaneJagger-Background", "Manager of Jinguji clothing store in Downtown, City Center. Purveyor of Night City's finest fashion to elite clientele. Prissy demeanor, impeccable taste.");
        this.Text("Kdsp-Npc-ZaneJagger-EarlyLife", "Fashion industry background. Rose through luxury retail. Secured Jinguji management position through connections and expertise.");
