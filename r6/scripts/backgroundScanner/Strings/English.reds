        this.Text("Kdsp-Npc-ZaneJagger-Notes", "Known for discretion regarding client purchases. Values returning customers.");
        this.Text("Kdsp-Npc-ZariaHughes-Classification", "CYBERPSYCHO - ACTIVE");
        this.Text("Kdsp-Npc-ZariaHughes-Background", "Former Maelstrom member. Participated in cult ritual involving near-death Net connection. Process destroyed remaining sanity.");
