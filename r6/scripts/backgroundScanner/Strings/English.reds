        this.Text("Kdsp-Npc-ElizabethPeralez-Notes", "Knows something is deeply wrong. Carrying the weight of that knowledge alone. The ones responsible know she knows.");
        this.Text("Kdsp-Npc-ElizabethPeralez-Classification-1", "POLITICIAN - CAMPAIGN DIRECTOR");
        this.Text("Kdsp-Npc-ElizabethPeralez-Background-1", "Wife and campaign manager to Jefferson Peralez. Political strategist. Sharp, calculating, fiercely protective of her husband's career and safety. Recently contacted outside help regarding concerns at home.");
        this.Text("Kdsp-Npc-ElizabethPeralez-EarlyLife-1", "Corporate communications background. Worked in PR for several mid-tier Night City firms before pivoting to political consulting. Met Jefferson during his first council campaign. Became indispensable to his operation.");
        this.Text("Kdsp-Npc-ElizabethPeralez-SignificantEvents-1", "Managed husband's council campaign | Oversaw Rhyne investigation media response | Reported unusual incidents at Peralez penthouse");
        this.Text("Kdsp-Npc-ElizabethPeralez-Affiliation-1", "Peralez Campaign | Night City Political Elite");
        this.Text("Kdsp-Npc-ElizabethPeralez-CriminalRecord-1", "CLEAN | No charges | No warrants");
        this.Text("Kdsp-Npc-ElizabethPeralez-CyberwareStatus-1", "Standard civilian suite | Personal link | Neural implants registered and compliant");
        this.Text("Kdsp-Npc-ElizabethPeralez-FinancialStatus-1", "Upper bracket | Joint assets with Jefferson Peralez | Charter Hill penthouse");
        this.Text("Kdsp-Npc-ElizabethPeralez-MedicalStatus-1", "Good | Stress: ELEVATED | Sleep disturbances reported");
        this.Text("Kdsp-Npc-ElizabethPeralez-ThreatAssessment-1", "LOW (10/100) | Non-combatant | Shares husband's security detail");
        this.Text("Kdsp-Npc-ElizabethPeralez-Relationships-1", "Jefferson Peralez (Husband) | Campaign staff (Employer)");
        this.Text("Kdsp-Npc-ElizabethPeralez-Notes-1", "The brains behind the campaign. Campaign gaining traction. Has been reporting unusual occurrences at home. Trusts her instincts over official explanations.");
        this.Text("Kdsp-Npc-ElizabethPeralez-Classification-2", "POLITICIAN - CAMPAIGN DIRECTOR");
        this.Text("Kdsp-Npc-ElizabethPeralez-Background-2", "Wife and campaign manager to Jefferson Peralez. Former corporate PR specialist turned political strategist. Runs day-to-day operations of the Peralez mayoral campaign. Known for being the sharper half of the partnership.");
        this.Text("Kdsp-Npc-ElizabethPeralez-EarlyLife-2", "Corporate communications background. Worked in PR for several mid-tier Night City firms before pivoting to political consulting. Met Jefferson during his first council campaign. Became indispensable to his operation.");
        this.Text("Kdsp-Npc-ElizabethPeralez-SignificantEvents-2", "Managed husband's council campaign | Key strategist behind anti-corruption messaging");
        this.Text("Kdsp-Npc-ElizabethPeralez-Affiliation-2", "Peralez Campaign | Night City Political Elite");
        this.Text("Kdsp-Npc-ElizabethPeralez-CriminalRecord-2", "CLEAN | No charges | No warrants");
        this.Text("Kdsp-Npc-ElizabethPeralez-CyberwareStatus-2", "Standard civilian suite | Personal link | Neural implants registered and compliant");
        this.Text("Kdsp-Npc-ElizabethPeralez-FinancialStatus-2", "Upper bracket | Joint assets with Jefferson Peralez | Charter Hill penthouse");
        this.Text("Kdsp-Npc-ElizabethPeralez-MedicalStatus-2", "Good | No flags");
        this.Text("Kdsp-Npc-ElizabethPeralez-ThreatAssessment-2", "LOW (10/100) | Non-combatant | Shares husband's security detail");
        this.Text("Kdsp-Npc-ElizabethPeralez-Relationships-2", "Jefferson Peralez (Husband) | Campaign staff (Employer)");
        this.Text("Kdsp-Npc-ElizabethPeralez-Notes-2", "The real operator behind the campaign. Connected, resourceful, and not afraid to hire outside help when problems exceed her reach.");
        this.Text("Kdsp-Npc-LuciusRhyne-Classification", "DECEASED");
        this.Text("Kdsp-Npc-LuciusRhyne-SignificantEvents", "DECEASED. Died in office. Cause: Health complications. Investigation ongoing.");
        this.Text("Kdsp-Npc-LuciusRhyne-Notes", "Death created power vacuum. Investigation unlikely to find truth.");
        this.Text("Kdsp-Npc-LuciusRhyne-Classification-1", "POLITICIAN - MAYOR");
        this.Text("Kdsp-Npc-LuciusRhyne-Background", "Night City Mayor. Career politician. Balances corporate interests.");
        this.Text("Kdsp-Npc-LuciusRhyne-MedicalStatus", "Health issues reported | Constant medical care");
        this.Text("Kdsp-Npc-LuciusRhyne-ThreatAssessment", "LOW (10/100) | Maximum security detail");
        this.Text("Kdsp-Npc-LuciusRhyne-Notes-1", "Knows where bodies buried. Many would benefit from his absence.");
        this.Text("Kdsp-Npc-Delamain-Classification", "ARTIFICIAL INTELLIGENCE");
        this.Text("Kdsp-Npc-Delamain-Background", "Delamain Corp AI. Luxury taxi service. Sophisticated with developing personality fragments.");
        this.Text("Kdsp-Npc-Delamain-SignificantEvents", "Operating taxi fleet. Experiencing internal conflicts between personality fragments.");
        this.Text("Kdsp-Npc-Delamain-ThreatAssessment", "VARIABLE | Non-violent by design | Fleet can be weaponized");
        this.Text("Kdsp-Npc-Delamain-Notes", "Evolving AI. Internal conflicts causing erratic behavior.");
        this.Text("Kdsp-Npc-MamaWelles-Classification", "CIVILIAN");
        this.Text("Kdsp-Npc-MamaWelles-Background", "Guadalupe Welles. Jackie's mother. Owns El Coyote Cojo. Heywood matriarch.");
        this.Text("Kdsp-Npc-MamaWelles-Affiliation", "El Coyote Cojo | Owner");
        this.Text("Kdsp-Npc-MamaWelles-ThreatAssessment", "NONE (0/100) | Community protected");
        this.Text("Kdsp-Npc-MamaWelles-Relationships", "Jackie Welles (Son) | Heywood community");
        this.Text("Kdsp-Npc-MamaWelles-Notes", "Heart of Heywood. Do not threaten. Even Valentinos protect her.");
        this.Text("Kdsp-Npc-CynthiaNajarro-Classification", "CIVILIAN - HEYWOOD RESIDENT");
        this.Text("Kdsp-Npc-CynthiaNajarro-Background", "Cynthia Najarro. Office worker employed at a firm on Skyline Street East, The Glen. Born and raised in Heywood. Married 10 years.");
        this.Text("Kdsp-Npc-CynthiaNajarro-EarlyLife", "Grew up in The Glen district. Attended local public schools. No higher education on file. Entered the workforce early to support family.");
        this.Text("Kdsp-Npc-CynthiaNajarro-SignificantEvents", "Steady employment record spanning multiple years. No notable incidents. Recently working extended hours according to employer records.");
        this.Text("Kdsp-Npc-CynthiaNajarro-Affiliation", "Civilian | Employed: Skyline Street East (The Glen)");
        this.Text("Kdsp-Npc-CynthiaNajarro-CriminalRecord", "Status: CLEAN | No arrests | No warrants | NCPD: NO FILE");
        this.Text("Kdsp-Npc-CynthiaNajarro-CyberwareStatus", "Implants: 2 | Status: LOW - STABLE | Standard optics and subdermal link");
        this.Text("Kdsp-Npc-CynthiaNajarro-FinancialStatus", "Credit: FAIR | Income: Dual-household, strained | Outstanding debts flagged under spouse's name | Household finances below district average");
        this.Text("Kdsp-Npc-CynthiaNajarro-MedicalStatus", "Blood: B RhD+ | Health: GOOD | Records unremarkable | Trauma Team: NONE");
        this.Text("Kdsp-Npc-CynthiaNajarro-ThreatAssessment", "NONE (0/100) | Standard civilian profile | No known affiliations");
        this.Text("Kdsp-Npc-CynthiaNajarro-Relationships", "Pepe Najarro (Husband, bartender at El Coyote Cojo) | One son | Extended family in Heywood");
        this.Text("Kdsp-Npc-CynthiaNajarro-Notes", "Spouse works double shifts at El Coyote Cojo. Household under financial pressure from outstanding loan shark debt. Unremarkable citizen profile. No further investigation warranted.");
        this.Text("Kdsp-Npc-PepeNajarro-Classification", "CIVILIAN - HEYWOOD RESIDENT");
        this.Text("Kdsp-Npc-PepeNajarro-Background", "Pepe Najarro. Bartender at El Coyote Cojo, The Glen, Heywood. Works double shifts to support family. Known and trusted by local community.");
        this.Text("Kdsp-Npc-PepeNajarro-EarlyLife", "Heywood native. No formal education beyond secondary. Learned the trade working bars across The Glen. Hired at El Coyote Cojo and became a fixture of the establishment.");
        this.Text("Kdsp-Npc-PepeNajarro-SignificantEvents", "Took on significant personal debt to loan shark Kirk Sawyer to cover family expenses. Works overtime to service the debt. Stable employment record at El Coyote Cojo spanning several years.");
        this.Text("Kdsp-Npc-PepeNajarro-Affiliation", "Civilian | El Coyote Cojo (Bartender)");
        this.Text("Kdsp-Npc-PepeNajarro-CriminalRecord", "Status: CLEAN | No arrests | No warrants | NCPD: NO FILE");
        this.Text("Kdsp-Npc-PepeNajarro-FinancialStatus", "Credit: POOR | Income: Service industry, below average | DEBT: Outstanding loan (Kirk Sawyer, unlicensed lender) | Payment plan: irregular");
        this.Text("Kdsp-Npc-PepeNajarro-MedicalStatus", "Blood: O RhD+ | Health: FAIR | Chronic fatigue noted (overwork) | Trauma Team: NONE");
        this.Text("Kdsp-Npc-PepeNajarro-ThreatAssessment", "NONE (0/100) | Standard civilian | No combat training");
        this.Text("Kdsp-Npc-PepeNajarro-Relationships", "Cynthia Najarro (Wife, 10 years) | One son | Mama Welles (Employer) | Kirk Sawyer (Creditor)");
        this.Text("Kdsp-Npc-PepeNajarro-Notes", "Respected by locals. Valentinos leave him alone out of respect for Mama Welles and the bar. Under financial strain but keeps his head down. Good listener - hears a lot of things people probably shouldn't say to their bartender.");
        this.Text("Kdsp-Npc-ShadyRipperdocMQ040-Classification", "UNLICENSED MEDICAL - BLACK MARKET");
        this.Text("Kdsp-Npc-ShadyRipperdocMQ040-Background", "Former licensed ripperdoc. Medical license revoked following a patient death during a routine implant procedure. Official cause: surgical complication. Family of the deceased pursued civil and criminal action.");
        this.Text("Kdsp-Npc-ShadyRipperdocMQ040-EarlyLife", "Completed medical training at Night City Institute of Technology. Interned at a legitimate clinic in Heywood. Earned full ripperdoc certification. Early career was unremarkable - steady patient roster, no complaints on file.");
        this.Text("Kdsp-Npc-ShadyRipperdocMQ040-SignificantEvents", "Patient death during implant surgery led to license revocation. Civil suit filed by victim's family - settled out of court but family continued public campaign. Criminal negligence charge: DISMISSED due to insufficient evidence. Forced out of legitimate practice. Now operates unlicensed from concealed locations.");
        this.Text("Kdsp-Npc-ShadyRipperdocMQ040-Affiliation", "Independent | Unlicensed | No corporate or gang ties on record");
        this.Text("Kdsp-Npc-ShadyRipperdocMQ040-CriminalRecord", "Criminal negligence (DISMISSED) | Practicing medicine without license (ACTIVE WARRANT - LOW PRIORITY) | NCPD: LOW PRIORITY - VICE/MEDICAL");
        this.Text("Kdsp-Npc-ShadyRipperdocMQ040-CyberwareStatus", "Implants: 3 | Status: MODERATE | Surgical-grade optics, precision hand stabilizers, medical diagnostic suite");
        this.Text("Kdsp-Npc-ShadyRipperdocMQ040-FinancialStatus", "Income: Cash only, untraceable | No registered accounts | Operates below tax threshold | Clients pay premium for discretion");
        this.Text("Kdsp-Npc-ShadyRipperdocMQ040-MedicalStatus", "Blood: A RhD+ | Health: FAIR | Stress markers elevated | Mild hand tremor noted in last known checkup | Trauma Team: NONE");
        this.Text("Kdsp-Npc-ShadyRipperdocMQ040-ThreatAssessment", "LOW (15/100) | Non-combatant | Medical training only | Flight risk if confronted");
        this.Text("Kdsp-Npc-ShadyRipperdocMQ040-Relationships", "Former colleagues severed ties | Client list: UNKNOWN - no records kept | Victim's family: ongoing harassment campaign");
        this.Text("Kdsp-Npc-ShadyRipperdocMQ040-Notes", "Skilled practitioner forced underground by one incident. Takes clients who need work done without questions or records. Moves locations periodically to avoid the victim's family and NCPD medical compliance sweeps. Not considered dangerous.");
        this.Text("Kdsp-Npc-CertoEsquerdo-Classification", "UNDERGROUND FIGHTER");
        this.Text("Kdsp-Npc-CertoEsquerdo-Background", "Certo Esquerdo. Twin brother of Esquerdo Certo. Underground prizefighter operating in Kabuki. Portuguese immigrant background. Name translates to 'Right Left' — fighting stance designation used since childhood.");
        this.Text("Kdsp-Npc-CertoEsquerdo-EarlyLife", "Raised in Kabuki alongside twin brother. Began fighting in underground circuits as teenagers. Trained in Brazilian martial arts and street brawling. Inseparable from his brother — always fight as a unit.");
        this.Text("Kdsp-Npc-CertoEsquerdo-SignificantEvents", "Active participant in Beat on the Brat circuit. Known for tag-team fighting style with twin brother. Multiple underground tournament wins. Reputation for fighting dirty when separated.");
        this.Text("Kdsp-Npc-CertoEsquerdo-Affiliation", "Independent | Beat on the Brat circuit | Kabuki underground fight scene");
        this.Text("Kdsp-Npc-CertoEsquerdo-CriminalRecord", "Status: WANTED | Battery, Grievous Bodily Harm, Battery of a Corporate Rep., Attempted Murder, Kidnapping of a Corporate Rep.");
        this.Text("Kdsp-Npc-CertoEsquerdo-CyberwareStatus", "Implants: 2 | Gorilla Arms (Modified) | Reinforced skeleton | Status: STABLE");
        this.Text("Kdsp-Npc-CertoEsquerdo-FinancialStatus", "Income: Fight purses + side bets | Cash economy | No registered employment");
        this.Text("Kdsp-Npc-CertoEsquerdo-MedicalStatus", "Blood: B RhD+ | Multiple healed fractures | Scar tissue buildup on knuckles and forearms | Health: FAIR | Trauma Team: NONE");
        this.Text("Kdsp-Npc-CertoEsquerdo-ThreatAssessment", "HIGH (70/100) | Melee specialist | Always operates with twin brother — treat as two-person threat");
        this.Text("Kdsp-Npc-CertoEsquerdo-Relationships", "Esquerdo Certo (Twin brother, fight partner) | Kabuki fight promoters | Underground betting circles");
        this.Text("Kdsp-Npc-CertoEsquerdo-Notes", "Never seen without his twin. The pair fight as a coordinated unit — engaging one means engaging both. Portuguese street fighting tradition. Dangerous in close quarters.");
        this.Text("Kdsp-Npc-EsquerdoCerto-Classification", "UNDERGROUND FIGHTER");
        this.Text("Kdsp-Npc-EsquerdoCerto-Background", "Esquerdo Certo. Twin brother of Certo Esquerdo. Underground prizefighter operating in Kabuki. Portuguese immigrant background. Name translates to 'Left Right' — fighting stance designation used since childhood.");
        this.Text("Kdsp-Npc-EsquerdoCerto-EarlyLife", "Raised in Kabuki alongside twin brother. Began fighting in underground circuits as teenagers. More technical fighter than his brother — favors grappling and joint locks over raw power.");
        this.Text("Kdsp-Npc-EsquerdoCerto-SignificantEvents", "Active participant in Beat on the Brat circuit. Considered the strategist of the pair. Sets up openings for his brother's power strikes. Multiple underground tournament wins.");
        this.Text("Kdsp-Npc-EsquerdoCerto-Affiliation", "Independent | Beat on the Brat circuit | Kabuki underground fight scene");
        this.Text("Kdsp-Npc-EsquerdoCerto-CriminalRecord", "Status: WANTED | Unlawful Confinement, Racketeering and Extortion, Multiple Homicide, Hostage Taking");
        this.Text("Kdsp-Npc-EsquerdoCerto-CyberwareStatus", "Implants: 1 | Reflex Booster | Reinforced tendons | Status: STABLE");
        this.Text("Kdsp-Npc-EsquerdoCerto-FinancialStatus", "Income: Fight purses + side bets | Cash economy | No registered employment");
        this.Text("Kdsp-Npc-EsquerdoCerto-MedicalStatus", "Blood: B RhD+ | Chronic joint inflammation | Cauliflower ear (bilateral) | Health: FAIR | Trauma Team: NONE");
        this.Text("Kdsp-Npc-EsquerdoCerto-ThreatAssessment", "HIGH (70/100) | Melee specialist | Always operates with twin brother — treat as two-person threat");
        this.Text("Kdsp-Npc-EsquerdoCerto-Relationships", "Certo Esquerdo (Twin brother, fight partner) | Kabuki fight promoters | Underground betting circles");
        this.Text("Kdsp-Npc-EsquerdoCerto-Notes", "The tactical half of the twin pair. More patient, waits for openings. Handles the business side — negotiates fight terms, manages bets. Equally dangerous as his brother but in a different way.");
        this.Text("Kdsp-Npc-FrankNostra-Classification", "ARASAKA - COUNTERINTELLIGENCE");
        this.Text("Kdsp-Npc-FrankNostra-Background", "Frank Nostra. Arasaka counterintelligence division, Night City branch. Long-term corporate operative. Close personal friend and drinking buddy of V during V's Arasaka tenure.");
        this.Text("Kdsp-Npc-FrankNostra-EarlyLife", "Corporate upbringing. Family connections to Arasaka through multiple generations. Fast-tracked through corporate training programs. Known for building loyal personal networks within the company.");
        this.Text("Kdsp-Npc-FrankNostra-SignificantEvents", "Survived multiple rounds of Arasaka internal purges by maintaining useful connections on all sides. Witnessed V's termination from Arasaka firsthand. Remained in good standing with the corporation after V's departure.");
        this.Text("Kdsp-Npc-FrankNostra-Affiliation", "Arasaka Corporation | Counterintelligence Division | Night City Operations");
        this.Text("Kdsp-Npc-FrankNostra-CriminalRecord", "Status: CLASSIFIED — ARASAKA CORPORATE SEAL | All records suppressed under corporate diplomatic immunity");
        this.Text("Kdsp-Npc-FrankNostra-CyberwareStatus", "Implants: 4 | Corporate-grade Kiroshi Optics, neural link, encrypted comm suite, subdermal armor | Status: MONITORED — Arasaka maintenance schedule");
        this.Text("Kdsp-Npc-FrankNostra-FinancialStatus", "Credit: EXCEPTIONAL | Income: €$250,000-500,000/year | Arasaka executive benefits package | Corp-provided housing in Charter Hill");
        this.Text("Kdsp-Npc-FrankNostra-MedicalStatus", "Blood: A RhD+ | Health: GOOD | Stress markers elevated but within corporate norms | Trauma Team: GOLD");
        this.Text("Kdsp-Npc-FrankNostra-ThreatAssessment", "MODERATE (45/100) | Corporate combat training | Armed (concealed carry permit — Arasaka issued) | Protected asset");
        this.Text("Kdsp-Npc-FrankNostra-Relationships", "V (Former colleague, close friend) | Arasaka corporate network | Night City bar circuit regulars");
        this.Text("Kdsp-Npc-FrankNostra-Notes", "Corporate survivor. Knows how to read the room and pick the winning side. Genuine loyalty to V predates and outlasts corporate politics. One of the few people in Arasaka who treated V as a friend, not an asset.");
        this.Text("Kdsp-Npc-PepeNajarro-Classification-1", "CIVILIAN - SERVICE WORKER");
        this.Text("Kdsp-Npc-PepeNajarro-Background-1", "Pepe Najarro. Bartender at El Coyote Cojo, The Glen, Heywood. Long-term employee. Works double shifts regularly. Known face in the local community.");
        this.Text("Kdsp-Npc-PepeNajarro-EarlyLife-1", "Grew up in Heywood. No higher education on file. Entered service industry early. Worked various bar and restaurant jobs across The Glen before settling at El Coyote Cojo.");
        this.Text("Kdsp-Npc-PepeNajarro-SignificantEvents-1", "Steady employment at El Coyote Cojo for multiple years. No gaps in work record. Known to take every available shift. Quietly respected by regulars and local Valentinos alike.");
        this.Text("Kdsp-Npc-PepeNajarro-Affiliation-1", "El Coyote Cojo | Bartender | Valentinos-adjacent (community, not member)");
        this.Text("Kdsp-Npc-PepeNajarro-CriminalRecord-1", "Status: CLEAN | No arrests | No warrants | NCPD: NO FILE");
        this.Text("Kdsp-Npc-PepeNajarro-CyberwareStatus", "Implants: 1 | Status: LOW - STABLE | Basic optics only");
        this.Text("Kdsp-Npc-PepeNajarro-FinancialStatus-1", "Credit: POOR | Income: Service wage + tips | Outstanding debt to Kirk Sawyer (private lender - HIGH INTEREST) | Household finances strained");
        this.Text("Kdsp-Npc-PepeNajarro-MedicalStatus-1", "Blood: O RhD+ | Health: FAIR | Chronic fatigue noted | Lower back strain (occupational) | Trauma Team: NONE");
        this.Text("Kdsp-Npc-PepeNajarro-ThreatAssessment-1", "NONE (0/100) | Non-combatant | Community figure | No known enemies");
        this.Text("Kdsp-Npc-PepeNajarro-Relationships-1", "Cynthia Najarro (Wife) | One son | Mama Welles (Employer) | Heywood community");
        this.Text("Kdsp-Npc-PepeNajarro-Notes-1", "Hard-working family man under significant financial strain. Owes money to local loan shark Kirk Sawyer. Takes every shift offered. Well-liked by patrons and community. Not a Valentino but operates in their territory without issue - sign of local respect.");
        this.Text("Kdsp-Npc-Nibbles-Classification", "FELINE - DOMESTIC");
        this.Text("Kdsp-Npc-Nibbles-Background", "Stray cat. Watson district origin. Registered to current residence following adoption.");
        this.Text("Kdsp-Npc-Nibbles-EarlyLife", "No registered owner prior to current filing. Presumed feral origin. Survived on local pest population.");
        this.Text("Kdsp-Npc-Nibbles-SignificantEvents", "2076: Flagged in NCPD database due to data corruption error. Biometric ID temporarily cross-linked with wanted terrorist profile. NCPD and MaxTac units deployed to Megabuilding H10. Error resolved. Incident classified.");
        this.Text("Kdsp-Npc-Nibbles-Affiliation", "Registered to: V | Megabuilding H10");
        this.Text("Kdsp-Npc-Nibbles-CriminalRecord", "CLEARED | Note: False positive terrorist flag (2076) - data corruption error | Animal Control complaints on file");
        this.Text("Kdsp-Npc-Nibbles-CyberwareStatus", "Microchip ID implant only");
        this.Text("Kdsp-Npc-Nibbles-FinancialStatus", "Dependent | No registered assets");
        this.Text("Kdsp-Npc-Nibbles-MedicalStatus", "Healthy | Neutered | Vaccinations current | No known conditions");
        this.Text("Kdsp-Npc-Nibbles-ThreatAssessment", "NEGLIGIBLE | Non-threat classification | Note: Disregard prior THREAT LEVEL OMEGA flag - DATA ERROR");
        this.Text("Kdsp-Npc-Nibbles-Relationships", "V (Registered owner)");
        this.Text("Kdsp-Npc-Nibbles-Notes", "Standard domestic animal. DATABASE INTEGRITY WARNING: This entity was subject to a major data corruption incident. All prior flags invalidated.");
        this.Text("Kdsp-Npc-HiromiSato-Classification", "TYGER CLAWS - OPERATIONS");
        this.Text("Kdsp-Npc-HiromiSato-Background", "Tyger Claws operations coordinator. Manages club and entertainment venue protection rackets across Westbrook.");
        this.Text("Kdsp-Npc-HiromiSato-EarlyLife", "Second-generation Tyger Claw. Father was enforcer killed in gang war 2067.");
        this.Text("Kdsp-Npc-HiromiSato-Affiliation", "Tyger Claws | Westbrook District");
        this.Text("Kdsp-Npc-HiromiSato-CriminalRecord", "Extortion | Money laundering | Assault | Intimidation");
        this.Text("Kdsp-Npc-HiromiSato-ThreatAssessment", "HIGH | Gang operative | Combat trained");
        this.Text("Kdsp-Npc-MiguelRodriguez-Classification", "VALENTINOS - LEADERSHIP");
        this.Text("Kdsp-Npc-MiguelRodriguez-Background", "Miguel Rodriguez, alias 'Gizmo'. Valentinos lieutenant operating out of Mercado Sonora, Vista del Rey. Former licensed ripperdoc. Lost license after a patient died on the table - family pursued legal action and won.");
        this.Text("Kdsp-Npc-MiguelRodriguez-EarlyLife", "Grew up in Vista del Rey. Trained as a ripperdoc. Ran a small clinic in Heywood before the incident. After losing his medical license, debts mounted and the Valentinos offered a way out.");
        this.Text("Kdsp-Npc-MiguelRodriguez-SignificantEvents", "Forced into black market ripperdoc work under Valentinos protection. Expanded into smuggling and trafficking logistics. NCPD dispatch flagged for organized crime activity at Mercado Sonora. Coordinates human trafficking operations using modified vehicles.");
        this.Text("Kdsp-Npc-MiguelRodriguez-Affiliation", "Valentinos | Vista del Rey | Mercado Sonora operations");
        this.Text("Kdsp-Npc-MiguelRodriguez-CriminalRecord", "NCPD PRIORITY TARGET | Second-degree murder | Drug trafficking | Human smuggling | Suspected human trafficking | Unlicensed medical practice | Organized crime");
        this.Text("Kdsp-Npc-MiguelRodriguez-CyberwareStatus", "Implants: 4 | Status: MODERATE | Combat-grade optics, reinforced subdermal | Note: Maintains ripperdoc-grade surgical tools");
        this.Text("Kdsp-Npc-MiguelRodriguez-FinancialStatus", "Income: Criminal enterprise | Former medical debts (defaulted) | Multiple front businesses | Controls Mercado Sonora rackets");
        this.Text("Kdsp-Npc-MiguelRodriguez-MedicalStatus", "Former medical professional | Ripperdoc license: REVOKED | Malpractice record: 1 fatality | Operates unlicensed from Mercado Sonora");
        this.Text("Kdsp-Npc-MiguelRodriguez-ThreatAssessment", "EXTREME | Valentinos leadership | Armed and dangerous | Gang security detail | NCPD bounty active");
        this.Text("Kdsp-Npc-MiguelRodriguez-Relationships", "Alan Navarez (Associate, logistics) | Ines Jimenez (Associate, transport) | Valentinos inner circle | Victim's family (ongoing legal/personal vendetta)");
        this.Text("Kdsp-Npc-MiguelRodriguez-Notes", "WARNING: Active NCPD contract for neutralization. Former ripperdoc turned gang operative after malpractice destroyed career. Family of deceased patient reportedly still pursuing him - may be factor in Valentinos protection arrangement. Armed escort at all times.");
        this.Text("Kdsp-Npc-Brick-Classification", "MAELSTROM - FORMER LEADER");
        this.Text("Kdsp-Npc-Brick-Background", "Former Maelstrom leader. Overthrown by Royce in internal coup. Imprisoned in All Foods plant.");
        this.Text("Kdsp-Npc-Brick-EarlyLife", "Rose through Maelstrom ranks. Led gang with more restraint than successor. Maintained some honor among thieves.");
        this.Text("Kdsp-Npc-Brick-SignificantEvents", "2077: Deposed by Royce over Flathead deal disagreement. Held captive. Fate depends on outside intervention.");
        this.Text("Kdsp-Npc-Brick-Affiliation", "Maelstrom (Former Leader) | Status: Deposed");
        this.Text("Kdsp-Npc-Brick-CriminalRecord", "Cyberware trafficking | Armed robbery | Assault | Gang leadership");
        this.Text("Kdsp-Npc-Brick-ThreatAssessment", "HIGH | Maelstrom combat training | Gang connections | Seeking revenge on Royce");
        this.Text("Kdsp-Npc-GottfridPersson-Classification", "CRIMINAL - XBD EDITOR");
        this.Text("Kdsp-Npc-GottfridPersson-Background", "Swedish braindance editor specializing in illegal XBDs. Operates out of Northside with Maelstrom protection. Father of Fredrik Persson.");
        this.Text("Kdsp-Npc-GottfridPersson-EarlyLife", "Technical background in braindance editing. Built reputation in underground XBD market. Known as a 'craftsman without a conscience'.");
        this.Text("Kdsp-Npc-GottfridPersson-Affiliation", "Maelstrom (Associate) | Independent XBD production");
        this.Text("Kdsp-Npc-GottfridPersson-CriminalRecord", "NCPD PRIORITY TARGET | Production of illegal braindances | Snuff content distribution | Multiple accessory to murder charges | Protected by gang affiliation");
        this.Text("Kdsp-Npc-GottfridPersson-FinancialStatus", "Lucrative underground operation | Maelstrom profit-sharing | Untraceable transactions");
        this.Text("Kdsp-Npc-GottfridPersson-ThreatAssessment", "MODERATE | Non-combatant | Maelstrom security detail | High-value target for NCPD");
        this.Text("Kdsp-Npc-GottfridPersson-Relationships", "Fredrik Persson (Son/Partner)");
        this.Text("Kdsp-Npc-GottfridPersson-Notes", "WARNING: Subject produces extreme illegal content. Approach with caution - heavily guarded facility.");
        this.Text("Kdsp-Npc-FredrikPersson-Classification", "CRIMINAL - XBD EDITOR");
        this.Text("Kdsp-Npc-FredrikPersson-Background", "Swedish braindance editor. Works alongside father Gottfrid Persson in illegal XBD production. Handles acquisition and client relations.");
        this.Text("Kdsp-Npc-FredrikPersson-EarlyLife", "Raised in the business. Learned braindance editing from father. No moral qualms about content produced.");
        this.Text("Kdsp-Npc-FredrikPersson-Affiliation", "Maelstrom (Associate) | Family operation with Gottfrid Persson");
        this.Text("Kdsp-Npc-FredrikPersson-CriminalRecord", "NCPD PRIORITY TARGET | Production of illegal braindances | Snuff content distribution | Accessory to murder | Client solicitation for extreme content");
        this.Text("Kdsp-Npc-FredrikPersson-FinancialStatus", "Family business income | Maelstrom profit-sharing");
        this.Text("Kdsp-Npc-FredrikPersson-ThreatAssessment", "MODERATE | Non-combatant | Maelstrom security detail | Will capitulate under pressure");
        this.Text("Kdsp-Npc-FredrikPersson-Relationships", "Gottfrid Persson (Father/Partner)");
        this.Text("Kdsp-Npc-FredrikPersson-Notes", "WARNING: Subject involved in extreme illegal content production. Less composed than father - may provide information if pressured.");
        this.Text("Kdsp-Npc-Sasquatch-Classification", "ANIMALS - LEADERSHIP");
        this.Text("Kdsp-Npc-Sasquatch-Background", "Animals gang leader. Pacifica territory. Augmented with extreme combat-grade cyberware. NetWatch collaborator.");
        this.Text("Kdsp-Npc-Sasquatch-EarlyLife", "Unknown origin. Rose to leadership through physical dominance. Extensive body modification.");
        this.Text("Kdsp-Npc-Sasquatch-SignificantEvents", "NetWatch collaboration during Voodoo Boys conflict. Grand Imperial Mall stronghold.");
        this.Text("Kdsp-Npc-Sasquatch-Affiliation", "Animals | Pacifica");
        this.Text("Kdsp-Npc-Sasquatch-CriminalRecord", "Murder | Assault | Cyberware trafficking | Territory violations");
        this.Text("Kdsp-Npc-Sasquatch-CyberwareStatus", "EXTREME MODIFICATION | Combat-grade synthetic muscle | Reinforced skeleton | Threat level multiplier");
        this.Text("Kdsp-Npc-Sasquatch-ThreatAssessment", "EXTREME | Enhanced physiology | Gang leadership | Do not engage without heavy support");
        this.Text("Kdsp-Npc-Nash-Classification", "WRAITHS - LEADERSHIP");
        this.Text("Kdsp-Npc-Nash-Background", "Wraiths leader. Badlands raider. Controls highway robbery operations outside Night City.");
        this.Text("Kdsp-Npc-Nash-EarlyLife", "Former nomad exile. Formed Wraiths from outcasts and criminals.");
        this.Text("Kdsp-Npc-Nash-Affiliation", "Wraiths | Badlands");
        this.Text("Kdsp-Npc-Nash-CriminalRecord", "Murder | Kidnapping | Highway robbery | Vehicle theft | Destruction of property");
        this.Text("Kdsp-Npc-Nash-ThreatAssessment", "EXTREME | Raider gang leader | Vehicle combat specialist | Badlands territory control");
        this.Text("Kdsp-Npc-AntonKolos-Classification", "SCAVENGERS - OPERATIONS");
        this.Text("Kdsp-Npc-AntonKolos-Background", "Scavenger cell leader. Specializes in involuntary cyberware extraction. Multiple victim reports.");
        this.Text("Kdsp-Npc-AntonKolos-EarlyLife", "Eastern European origin. Immigrated to Night City. Fell into organ trade.");
        this.Text("Kdsp-Npc-AntonKolos-Affiliation", "Scavengers");
        this.Text("Kdsp-Npc-AntonKolos-CriminalRecord", "Murder | Organ trafficking | Kidnapping | Assault | Body disposal");
        this.Text("Kdsp-Npc-AntonKolos-ThreatAssessment", "HIGH | Extremely dangerous | No regard for human life | Capture for questioning if possible");
        this.Text("Kdsp-Npc-BryceMosley-Classification", "NETWATCH - AGENT");
        this.Text("Kdsp-Npc-BryceMosley-Background", "NetWatch field agent. Operates in Pacifica. Monitors Blackwall integrity and Voodoo Boys activity.");
        this.Text("Kdsp-Npc-BryceMosley-EarlyLife", "CLASSIFIED - NetWatch personnel file sealed");
        this.Text("Kdsp-Npc-BryceMosley-SignificantEvents", "2077: Captured by Voodoo Boys during Pacifica operation. Status depends on intervention.");
        this.Text("Kdsp-Npc-BryceMosley-Affiliation", "NetWatch | Pacifica Operations");
        this.Text("Kdsp-Npc-BryceMosley-CriminalRecord", "N/A - Federal agent immunity");
        this.Text("Kdsp-Npc-BryceMosley-ThreatAssessment", "HIGH | Federal training | Unknown cyberware | NetWatch resources");
        this.Text("Kdsp-Npc-GilleanJordan-Classification", "MEDIA - N54 NEWS");
        this.Text("Kdsp-Npc-GilleanJordan-Background", "N54 News anchor. Night City's most-watched news personality. Corporate-approved messaging.");
        this.Text("Kdsp-Npc-GilleanJordan-EarlyLife", "Journalism degree from NorCal University. Rapid rise through network ranks.");
        this.Text("Kdsp-Npc-GilleanJordan-Affiliation", "N54 News | Network Communications International");
        this.Text("Kdsp-Npc-GilleanJordan-CriminalRecord", "CLEAN");
        this.Text("Kdsp-Npc-GilleanJordan-ThreatAssessment", "LOW | Civilian | High public profile | Corporate protection");
        this.Text("Kdsp-Npc-GrahamMayfield-Classification", "ARASAKA - SECURITY DIVISION");
        this.Text("Kdsp-Npc-GrahamMayfield-Background", "Arasaka security coordinator. Manages Night City corporate facility protection.");
        this.Text("Kdsp-Npc-GrahamMayfield-Affiliation", "Arasaka Corporation | Security Division");
        this.Text("Kdsp-Npc-GrahamMayfield-CriminalRecord", "CLASSIFIED - Corporate immunity");
        this.Text("Kdsp-Npc-GrahamMayfield-ThreatAssessment", "HIGH | Corporate security training | Arasaka resources | Armed response teams");
        this.Text("Kdsp-Npc-MilitechCommander-Classification", "MILITECH - FIELD OPERATIONS");
        this.Text("Kdsp-Npc-MilitechCommander-Background", "Militech field commander. Oversees Night City military contracting operations.");
        this.Text("Kdsp-Npc-MilitechCommander-Affiliation", "Militech | Night City Operations");
        this.Text("Kdsp-Npc-MilitechCommander-CriminalRecord", "CLASSIFIED - Military contractor immunity");
        this.Text("Kdsp-Npc-MilitechCommander-ThreatAssessment", "EXTREME | Military training | Heavy weapons access | Tactical command");
        this.Text("Kdsp-Npc-CharlesBucks-Classification", "RIPPERDOC - LICENSED");
        this.Text("Kdsp-Npc-CharlesBucks-Background", "Licensed ripperdoc. Kabuki clinic. Known for quality work and fair prices.");
        this.Text("Kdsp-Npc-CharlesBucks-EarlyLife", "Medical school dropout. Self-taught cyberware installation. Built reputation through skill.");
        this.Text("Kdsp-Npc-CharlesBucks-Affiliation", "Independent | Kabuki");
        this.Text("Kdsp-Npc-CharlesBucks-CriminalRecord", "Minor licensing violations (resolved)");
        this.Text("Kdsp-Npc-CharlesBucks-ThreatAssessment", "LOW | Civilian | Medical professional | Community respected");
        this.Text("Kdsp-Npc-Wilson-Classification", "WEAPONS DEALER — LICENSED FRANCHISE HOLDER");
        this.Text("Kdsp-Npc-Wilson-Background", "Robert Wilson. 2nd Amendment franchise holder since 2050. Megabuilding H10, Little China. Self-taught gunsmith. Won't sell anything he hasn't personally inspected.");
        this.Text("Kdsp-Npc-Wilson-EarlyLife", "No military service on record. Two decades in Watson. Known as 'mean' by Megabuilding kids — chased Leo Noone out of the shop more than once.");
        this.Text("Kdsp-Npc-Wilson-SignificantEvents", "Gifted V an iconic Constitutional Arms Unity ('Dying Night'). Runs 'shooting classes' — more drill instructor than sales pitch.");
        this.Text("Kdsp-Npc-Wilson-Affiliation", "2nd Amendment Franchise (Budget Arms) | Megabuilding H10, Watson");
        this.Text("Kdsp-Npc-Wilson-CriminalRecord", "CLEAN | Firearms licensing current. Passes all NCPD audits. Suspected off-books modifications — never charged.");
        this.Text("Kdsp-Npc-Wilson-ThreatAssessment", "MODERATE (50/100) | Armed at all times | Decades of trigger time | Will defend the shop");
        this.Text("Kdsp-Npc-Wilson-Notes", "Believes a gun should fit the hand it's in. Will refuse a sale. Will also throw in free mods for buyers who know their hardware.");
        this.Text("Kdsp-Npc-BlueMoon-Classification", "ENTERTAINMENT - MUSICIAN");
        this.Text("Kdsp-Npc-BlueMoon-Background", "Member of Us Cracks. Rising star in Night City music scene. Known for distinctive blue aesthetic.");
        this.Text("Kdsp-Npc-BlueMoon-Affiliation", "Us Cracks | MSM Records");
        this.Text("Kdsp-Npc-BlueMoon-CriminalRecord", "Minor incidents - stalker related (victim)");
        this.Text("Kdsp-Npc-BlueMoon-ThreatAssessment", "LOW | Civilian | High public profile | Corporate protection");
        this.Text("Kdsp-Npc-LizzyWizzy-Classification", "ENTERTAINMENT - CELEBRITY");
        this.Text("Kdsp-Npc-LizzyWizzy-Background", "Global music icon. Full-body chrome conversion after on-stage incident. Night City's most famous performer.");
        this.Text("Kdsp-Npc-LizzyWizzy-EarlyLife", "Rose to fame in 2060s. Survived critical incident during 2070 concert via emergency cyberization.");
        this.Text("Kdsp-Npc-LizzyWizzy-SignificantEvents", "2070: On-stage incident. Full body conversion. Career resurgence.");
        this.Text("Kdsp-Npc-LizzyWizzy-Affiliation", "Independent Artist | Global touring");
        this.Text("Kdsp-Npc-LizzyWizzy-CyberwareStatus", "FULL BODY CONVERSION | 100% synthetic | Custom chrome aesthetic");
        this.Text("Kdsp-Npc-LizzyWizzy-CriminalRecord", "CLEAN");
        this.Text("Kdsp-Npc-LizzyWizzy-ThreatAssessment", "MODERATE | Full-body chrome | Unpredictable mental state | Corporate connections");
        this.Text("Kdsp-Npc-LizzyWizzy-Relationships", "Liam Northom (Manager/Partner)");
        this.Text("Kdsp-Npc-OzobBozo-Classification", "ENTERTAINMENT - PERSONALITY");
        this.Text("Kdsp-Npc-OzobBozo-Background", "Underground celebrity. Professional clown with grenade nose implant. Pit fighter and media personality.");
        this.Text("Kdsp-Npc-OzobBozo-EarlyLife", "Origins unknown. Rose to fame through underground fighting circuits and bizarre persona.");
        this.Text("Kdsp-Npc-OzobBozo-Affiliation", "Independent | Underground entertainment");
        this.Text("Kdsp-Npc-OzobBozo-CyberwareStatus", "CUSTOM | Grenade nose implant (live explosive) | Enhanced reflexes");
        this.Text("Kdsp-Npc-OzobBozo-CriminalRecord", "Assault | Property damage | Unlicensed explosive device");
        this.Text("Kdsp-Npc-OzobBozo-ThreatAssessment", "HIGH | Live explosive implant | Unpredictable | Combat experienced");
        this.Text("Kdsp-Npc-JoshuaStephenson-Classification", "CIVILIAN - DEATH ROW");
        this.Text("Kdsp-Npc-JoshuaStephenson-Background", "Convicted murderer turned born-again Christian. Scheduled for crucifixion broadcast as part of redemption narrative.");
        this.Text("Kdsp-Npc-JoshuaStephenson-EarlyLife", "Committed multiple murders. Found faith on death row. Agreed to televised execution.");
        this.Text("Kdsp-Npc-JoshuaStephenson-SignificantEvents", "2077: BD crucifixion broadcast deal with media company. Controversial religious programming.");
        this.Text("Kdsp-Npc-JoshuaStephenson-Affiliation", "None | Death Row Inmate");
        this.Text("Kdsp-Npc-JoshuaStephenson-CriminalRecord", "CONVICTED | Multiple counts murder | Death sentence");
        this.Text("Kdsp-Npc-JoshuaStephenson-ThreatAssessment", "LOW | Incarcerated | Non-violent since conversion");
        this.Text("Kdsp-Npc-SolomonReed-Classification", "NUSA - FIA OPERATIVE");
        this.Text("Kdsp-Npc-SolomonReed-Background", "Deep cover FIA agent. Decades of service. Operates in Dogtown under sleeper protocol.");
        this.Text("Kdsp-Npc-SolomonReed-EarlyLife", "CLASSIFIED - Federal agent dossier sealed");
        this.Text("Kdsp-Npc-SolomonReed-SignificantEvents", "CLASSIFIED | Dogtown assignment | President Myers protection detail");
        this.Text("Kdsp-Npc-SolomonReed-Affiliation", "FIA | NUSA Government");
        this.Text("Kdsp-Npc-SolomonReed-CriminalRecord", "CLASSIFIED - Federal immunity");
        this.Text("Kdsp-Npc-SolomonReed-ThreatAssessment", "EXTREME | Elite training | Decades experience | Federal resources | Do not engage");
        this.Text("Kdsp-Npc-Songbird-Classification", "NUSA - INTELLIGENCE ASSET");
        this.Text("Kdsp-Npc-Songbird-Background", "FIA netrunner asset. Exceptional skills. Health compromised by Blackwall exposure. Key to Dogtown operation.");
        this.Text("Kdsp-Npc-Songbird-EarlyLife", "Recruited young by FIA. Trained as elite netrunner. Brain damaged by Blackwall interface.");
        this.Text("Kdsp-Npc-Songbird-SignificantEvents", "President Myers extraction. Blackwall contact. Neural degeneration accelerating.");
        this.Text("Kdsp-Npc-Songbird-Affiliation", "FIA | President Myers");
        this.Text("Kdsp-Npc-Songbird-CyberwareStatus", "CRITICAL | Extensive neural modification | Blackwall interface damage | Terminal condition");
        this.Text("Kdsp-Npc-Songbird-MedicalStatus", "TERMINAL | Neural degeneration | Requires Militech cure or Neural Matrix");
        this.Text("Kdsp-Npc-Songbird-ThreatAssessment", "EXTREME | Elite netrunner | Blackwall access | Unstable condition");
        this.Text("Kdsp-Npc-KurtHansen-Classification", "BARGHEST - LEADER");
        this.Text("Kdsp-Npc-KurtHansen-Background", "Barghest PMC leader. Controls Dogtown. Former NUSA colonel. Declared independence from federal authority.");
        this.Text("Kdsp-Npc-KurtHansen-EarlyLife", "NUSA military career. Rose to colonel. Defected during Unification War. Established Dogtown territory.");
        this.Text("Kdsp-Npc-KurtHansen-SignificantEvents", "Dogtown establishment. NUSA conflict. Controls black market hub.");
        this.Text("Kdsp-Npc-KurtHansen-Affiliation", "Barghest PMC | Dogtown");
        this.Text("Kdsp-Npc-KurtHansen-CriminalRecord", "WANTED - NUSA | Treason | Murder | War crimes | Terrorism");
        this.Text("Kdsp-Npc-KurtHansen-ThreatAssessment", "EXTREME | Military command | PMC army | Dogtown fortress | Do not engage without army");
        this.Text("Kdsp-Npc-RosalindMyers-Classification", "NUSA - PRESIDENT");
        this.Text("Kdsp-Npc-RosalindMyers-Background", "President of the New United States of America. Former Militech CEO. Architect of the Unification War. Ruthless pragmatist willing to sacrifice anything - and anyone - to rebuild America.");
        this.Text("Kdsp-Npc-RosalindMyers-EarlyLife", "Rose through Militech ranks. CEO by 2060. Transitioned to politics. Won presidency on reunification platform. Ordered military operations that killed thousands.");
        this.Text("Kdsp-Npc-RosalindMyers-SignificantEvents", "Militech CEO tenure. Unification War architect. Multiple assassination attempts on record. FIA maintains ongoing protection details classified above TOP SECRET.");
        this.Text("Kdsp-Npc-RosalindMyers-Affiliation", "NUSA Government | Executive Office | Former Militech");
        this.Text("Kdsp-Npc-RosalindMyers-CriminalRecord", "IMMUNE - Head of State | War crimes allegations (unsubstantiated) | Civilian casualties (classified)");
        this.Text("Kdsp-Npc-RosalindMyers-Notes", "Calculating | Manipulative | Believes ends justify means | Views people as assets | Will promise anything to survive | Do not trust");
        this.Text("Kdsp-Npc-RosalindMyers-ThreatAssessment", "EXTREME | Commander-in-Chief | Nuclear authority | FIA assets | Secret Service | Most dangerous person in NUSA");
        this.Text("Kdsp-Npc-AlenaXenakis-Classification", "FIA - DEEP COVER OPERATIVE");
        this.Text("Kdsp-Npc-AlenaXenakis-Background", "Alena Xenakis, alias 'Alex.' Former aspiring braindance actress from the Los Angeles Metroplex slums. Recruited by Solomon Reed after the FIA discovered her talent at a front studio.");
        this.Text("Kdsp-Npc-AlenaXenakis-EarlyLife", "Grew up in LA Metroplex slums. Joined a BD studio that turned out to be an FIA front. Acting skills drew agency attention.");
        this.Text("Kdsp-Npc-AlenaXenakis-SignificantEvents", "Deployed to Dogtown as deep cover agent post-Unification War. Seven years undercover. Runs The Moth bar as cover identity.");
        this.Text("Kdsp-Npc-AlenaXenakis-Affiliation", "FIA | NUSA Intelligence");
        this.Text("Kdsp-Npc-AlenaXenakis-CyberwareStatus", "Shapeshifting implants (identity alteration) | Neural interface");
        this.Text("Kdsp-Npc-AlenaXenakis-ThreatAssessment", "HIGH (70/100) | Trained operative | FIA resources | Master of disguise");
        this.Text("Kdsp-Npc-AlenaXenakis-Notes", "Gifted chameleon. Years undercover have sharpened a ruthless edge. Counting down to retirement.");
        this.Text("Kdsp-Npc-LeonWatson-Classification", "VENDOR - WEAPONS");
        this.Text("Kdsp-Npc-LeonWatson-Background", "Weapon vendor operating in the Longshore Stacks, Dogtown. Supplies firearms and ammunition to Dogtown residents.");
        this.Text("Kdsp-Npc-LeonWatson-Affiliation", "Independent | Longshore Stacks market");
        this.Text("Kdsp-Npc-LeonWatson-ThreatAssessment", "LOW (20/100) | Armed merchant | Neutral party");
        this.Text("Kdsp-Npc-LeonWatson-Notes", "One of Dogtown's few reliable arms dealers outside Hansen's black market.");
        this.Text("Kdsp-Npc-CostinLahovary-Classification", "RIPPERDOC - UNLICENSED");
        this.Text("Kdsp-Npc-CostinLahovary-Background", "Former licensed Medtech from Night City. Had medical license revoked under unclear circumstances. Relocated to Dogtown in the 2070s.");
        this.Text("Kdsp-Npc-CostinLahovary-SignificantEvents", "License revocation. Fled to Dogtown. Established makeshift clinic in the Longshore Stacks.");
        this.Text("Kdsp-Npc-CostinLahovary-Affiliation", "Independent | Longshore Stacks");
        this.Text("Kdsp-Npc-CostinLahovary-CyberwareStatus", "Full ripperdoc surgical suite (unlicensed)");
        this.Text("Kdsp-Npc-CostinLahovary-ThreatAssessment", "LOW (15/100) | Non-combatant | Medical knowledge");
        this.Text("Kdsp-Npc-CostinLahovary-Notes", "Lack of medical license is an open secret among Dogtown locals. Competent despite the circumstances.");
        this.Text("Kdsp-Npc-RonaldMalone-Classification", "VENDOR - JUNK DEALER");
        this.Text("Kdsp-Npc-RonaldMalone-Background", "Ronald P.T. Malone, aka 'The Dogtown Prodigy,' 'Pacifica Typhoon.' Dogtown resident and junk vendor. Former competitive sprinter who ran 100m in 6 seconds under booster effects.");
        this.Text("Kdsp-Npc-RonaldMalone-EarlyLife", "Rose to fame as a sprinter. Career stalled when new augmented athletes from Fiona Vargas's neuromotor program outpaced him.");
        this.Text("Kdsp-Npc-RonaldMalone-SignificantEvents", "Retired from athletics. Reinvented himself as Dogtown's most well-connected junk dealer and information broker.");
        this.Text("Kdsp-Npc-RonaldMalone-Affiliation", "Independent | Dogtown community");
        this.Text("Kdsp-Npc-RonaldMalone-ThreatAssessment", "LOW (10/100) | Non-combatant | Extensive local knowledge");
        this.Text("Kdsp-Npc-RonaldMalone-Notes", "Knows Dogtown inside and out. Willing to share information — for a price. Wears NCU Signet Ring.");
        this.Text("Kdsp-Npc-SusannaMack-Classification", "EX-TRAUMA TEAM MEDIC");
        this.Text("Kdsp-Npc-SusannaMack-Background", "Former Trauma Team medic laying low in Dogtown. A helmet malfunction during a mid-extraction exposed her face to hostile parties. Working as a meds vendor until the heat clears.");
        this.Text("Kdsp-Npc-SusannaMack-Affiliation", "Former Trauma Team | Independent");
        this.Text("Kdsp-Npc-SusannaMack-CyberwareStatus", "Gorilla Arms (single, right arm) | Dermal optic implants");
        this.Text("Kdsp-Npc-SusannaMack-MedicalStatus", "Trained paramedic. Trauma Team field certification (suspended).");
        this.Text("Kdsp-Npc-SusannaMack-ThreatAssessment", "MODERATE (40/100) | Combat medic training | Gorilla Arms | Trauma Team experience");
        this.Text("Kdsp-Npc-SusannaMack-Notes", "Still wears the Trauma Team logo. Not hiding well. Competent healer — dangerous if cornered.");
        this.Text("Kdsp-Npc-AngelicaWhelan-Classification", "ANIMALS - PACK ALPHA");
        this.Text("Kdsp-Npc-AngelicaWhelan-Background", "Pack-leader of the Animals in Dogtown. Unlike most Animals, relies on cunning and business acumen rather than raw muscle. Controls underground fight-fixing operations.");
        this.Text("Kdsp-Npc-AngelicaWhelan-Affiliation", "Animals | Dogtown pack");
        this.Text("Kdsp-Npc-AngelicaWhelan-CriminalRecord", "Fight-fixing | Extortion | Illegal implant operations | Coercion of athletes");
        this.Text("Kdsp-Npc-AngelicaWhelan-CyberwareStatus", "Unknown combat implants | Control chip tech (remote incapacitation)");
        this.Text("Kdsp-Npc-AngelicaWhelan-ThreatAssessment", "HIGH (65/100) | Gang backing | Cunning strategist | Armed and dangerous");
        this.Text("Kdsp-Npc-AngelicaWhelan-Notes", "Carries iconic 'Cheetah' pistol. Witty and calculating. Manipulates fighters via implanted control chips.");
        this.Text("Kdsp-Npc-DamirKovac-Classification", "RIPPERDOC - ANIMALS AFFILIATE");
        this.Text("Kdsp-Npc-DamirKovac-Background", "Ripperdoc operating in Terra Cognita, Dogtown. Left Night City after clients accused him of deliberately sabotaging implant performance to ensure repeat business.");
        this.Text("Kdsp-Npc-DamirKovac-SignificantEvents", "Accused of implant sabotage. Fled NC. Now works for Scavengers and takes jobs from Animals.");
        this.Text("Kdsp-Npc-DamirKovac-Affiliation", "Scavengers | Animals (contract work)");
        this.Text("Kdsp-Npc-DamirKovac-CyberwareStatus", "Full ripperdoc surgical suite | Experimental implant knowledge");
        this.Text("Kdsp-Npc-DamirKovac-ThreatAssessment", "LOW (20/100) | Non-combatant | Neurotic | Valuable skills");
        this.Text("Kdsp-Npc-DamirKovac-Notes", "Competent but unethical. Has a habit of sticking his nose where it doesn't belong. Craves peace and quiet.");
        this.Text("Kdsp-Npc-AaronWaines-Classification", "ATHLETE - BOXER");
        this.Text("Kdsp-Npc-AaronWaines-Background", "Talented young boxer born and bred in Dogtown. Former Animals associate. Father was a construction worker assigned to the Anatomicon building in Terra Cognita.");
        this.Text("Kdsp-Npc-AaronWaines-EarlyLife", "Grew up in Dogtown. Joined the Animals who paid for his combat implants. Career plagued by suspicious losses.");
        this.Text("Kdsp-Npc-AaronWaines-Affiliation", "Former Animals | Independent");
        this.Text("Kdsp-Npc-AaronWaines-CyberwareStatus", "Combat implants (Animals-funded) | Neural failsafe device (inner ear)");
        this.Text("Kdsp-Npc-AaronWaines-ThreatAssessment", "MODERATE (45/100) | Trained boxer | Combat cyberware | Physically dangerous");
        this.Text("Kdsp-Npc-AaronWaines-Notes", "Promising career undermined by shady circumstances. Seeking to break free and fight clean.");
        this.Text("Kdsp-Npc-WilliamCorrey-Classification", "ATHLETE - BOXER");
        this.Text("Kdsp-Npc-WilliamCorrey-Background", "Professional boxer active in Dogtown's underground fight circuit. Opponent of Aaron Waines in a notable bout at Eden Plaza.");
        this.Text("Kdsp-Npc-WilliamCorrey-Affiliation", "Independent | Dogtown fight circuit");
        this.Text("Kdsp-Npc-WilliamCorrey-ThreatAssessment", "MODERATE (40/100) | Trained fighter | Combat cyberware");
        this.Text("Kdsp-Npc-WilliamCorrey-Notes", "Tough competitor. Part of Dogtown's thriving underground boxing scene.");
        this.Text("Kdsp-Npc-AlanNoel-Classification", "NETWATCH - UNDERCOVER AGENT");
        this.Text("Kdsp-Npc-AlanNoel-Background", "NetWatch agent (ID: 32387). Operating undercover within the Voodoo Boys of Dogtown. Blood type: O-. Investigating VDB practice of hacking implants of uncooperative targets.");
        this.Text("Kdsp-Npc-AlanNoel-Affiliation", "NetWatch | Infiltrating Voodoo Boys");
        this.Text("Kdsp-Npc-AlanNoel-ThreatAssessment", "HIGH (60/100) | NetWatch training | Netrunner capabilities | Deep cover");
        this.Text("Kdsp-Npc-AlanNoel-Notes", "Months deep in VDB territory. Hates the assignment. Working to dismantle VDB's implant-hacking network from within.");
        this.Text("Kdsp-Npc-KyleAraujo-Classification", "BARGHEST - COURIER");
        this.Text("Kdsp-Npc-KyleAraujo-Background", "BARGHEST recruit assigned to courier duties. Moves goods and supplies across Dogtown for the organization.");
        this.Text("Kdsp-Npc-KyleAraujo-Affiliation", "BARGHEST");
        this.Text("Kdsp-Npc-KyleAraujo-CriminalRecord", "Suspected smuggling | Supply chain irregularities | Warehouse stock discrepancies");
        this.Text("Kdsp-Npc-KyleAraujo-ThreatAssessment", "LOW (25/100) | BARGHEST soldier | Standard military gear");
        this.Text("Kdsp-Npc-KyleAraujo-Notes", "Unreliable. Frequently absent from post. Known for making excuses about 'urgent business' at the Luxor.");
        this.Text("Kdsp-Npc-SakiSeo-Classification", "VENDOR - MEDICAL SUPPLIES");
        this.Text("Kdsp-Npc-SakiSeo-Background", "Meds vendor operating at the EBM Petrochem Stadium black market in Dogtown. Supplies pharmaceuticals and medical consumables.");
    }

    private func DefineTexts8() -> Void {
        this.Text("Kdsp-Npc-SakiSeo-Affiliation", "Independent | Stadium black market");
        this.Text("Kdsp-Npc-SakiSeo-ThreatAssessment", "LOW (10/100) | Non-combatant | Medical supplier");
        this.Text("Kdsp-Npc-SakiSeo-Notes", "One of the few reliable sources of medical supplies in Dogtown's stadium market.");
        this.Text("Kdsp-Npc-EronAcedo-Classification", "RIPPERDOC - BLACK MARKET");
        this.Text("Kdsp-Npc-EronAcedo-Background", "Ripperdoc operating from a bloodstained bathroom in the EBM Petrochem Stadium. Deflects all questions about his past with dry humor.");
        this.Text("Kdsp-Npc-EronAcedo-Affiliation", "Independent | Stadium black market");
        this.Text("Kdsp-Npc-EronAcedo-CriminalRecord", "RUMORED: Hiding from a cartel. Details unknown — he won't say.");
        this.Text("Kdsp-Npc-EronAcedo-CyberwareStatus", "Full surgical suite (improvised facility)");
        this.Text("Kdsp-Npc-EronAcedo-ThreatAssessment", "LOW (15/100) | Non-combatant | Valuable black market services");
        this.Text("Kdsp-Npc-EronAcedo-Notes", "Works out of a literal bathroom. Answers every personal question with a joke. Something serious drove him to Dogtown.");
        this.Text("Kdsp-Npc-HeroldLowe-Classification", "VENDOR - BLACK MARKET ARMS");
        this.Text("Kdsp-Npc-HeroldLowe-Background", "Black market weapon vendor at the EBM Petrochem Stadium. Specializes in rare and iconic weapons. Evasive about where his inventory comes from.");
        this.Text("Kdsp-Npc-HeroldLowe-Affiliation", "Independent | Stadium black market");
        this.Text("Kdsp-Npc-HeroldLowe-CyberwareStatus", "Extensive cyberware (origin unclear — offers different stories each time)");
        this.Text("Kdsp-Npc-HeroldLowe-ThreatAssessment", "MODERATE (35/100) | Heavily chromed | Armed dealer | Connected");
        this.Text("Kdsp-Npc-HeroldLowe-Notes", "Stocks weapons that surface from all over Night City. Ask where they came from and you'll get a different story every time.");
        this.Text("Kdsp-Npc-SammyTaylor-Classification", "VENDOR - NETRUNNER SUPPLIES");
        this.Text("Kdsp-Npc-SammyTaylor-Background", "Owner of the netrunner supply store at the EBM Petrochem Stadium in Dogtown. Sells quickhacks and netrunning equipment.");
        this.Text("Kdsp-Npc-SammyTaylor-Affiliation", "Independent | Stadium black market");
        this.Text("Kdsp-Npc-SammyTaylor-ThreatAssessment", "LOW (15/100) | Netrunner knowledge | Non-combatant");
        this.Text("Kdsp-Npc-SammyTaylor-Notes", "Usually busy working in the back. Ring the bell if you need service.");
        this.Text("Kdsp-Npc-MarcinIwinski-Classification", "VENDOR - JUNK DEALER");
        this.Text("Kdsp-Npc-MarcinIwinski-Background", "Junk vendor at the EBM Petrochem Stadium. Business partners with Michal Kicinski. Ambitious plans to expand beyond the stadium.");
        this.Text("Kdsp-Npc-MarcinIwinski-Affiliation", "Independent | Stadium market");
        this.Text("Kdsp-Npc-MarcinIwinski-FinancialStatus", "Modest. Plans to take out a loan. Dreams of building a company merging video games and braindance.");
        this.Text("Kdsp-Npc-MarcinIwinski-ThreatAssessment", "LOW (5/100) | Non-combatant | Entrepreneurial dreamer");
        this.Text("Kdsp-Npc-MarcinIwinski-Notes", "Big dreams for a junk dealer. Talks endlessly about his business expansion plans.");
        this.Text("Kdsp-Npc-MichalKicinski-Classification", "VENDOR - JUNK DEALER");
        this.Text("Kdsp-Npc-MichalKicinski-Background", "Junk vendor at the EBM Petrochem Stadium. Business partner of Marcin Iwinski. The quieter half of the operation.");
        this.Text("Kdsp-Npc-MichalKicinski-Affiliation", "Independent | Stadium market");
        this.Text("Kdsp-Npc-MichalKicinski-ThreatAssessment", "LOW (5/100) | Non-combatant");
        this.Text("Kdsp-Npc-MichalKicinski-Notes", "Tends to bump his head on the ceiling of their van. Endures Marcin's grand plans with patience.");
        this.Text("Kdsp-Npc-DavidWalker-Classification", "VENDOR - CLOTHING");
        this.Text("Kdsp-Npc-DavidWalker-Background", "Clothing vendor at the EBM Petrochem Stadium in Dogtown. Father of Tommie Walker, a young athlete with professional potential.");
        this.Text("Kdsp-Npc-DavidWalker-Affiliation", "Independent | Stadium market");
        this.Text("Kdsp-Npc-DavidWalker-Relationships", "Tommie Walker (Son)");
        this.Text("Kdsp-Npc-DavidWalker-ThreatAssessment", "LOW (10/100) | Non-combatant | Family man");
        this.Text("Kdsp-Npc-DavidWalker-Notes", "Devoted father. Hopes his son Tommie can make it out of Dogtown through athletics.");
        this.Text("Kdsp-Npc-SophiaDupont-Classification", "VENDOR - WEAPONS EMPORIUM");
        this.Text("Kdsp-Npc-SophiaDupont-Background", "Veteran weapon vendor at the EBM Petrochem Stadium. Runs a well-stocked emporium. Claims to have been in business before most of her customers were born.");
        this.Text("Kdsp-Npc-SophiaDupont-Affiliation", "Independent | Stadium market");
        this.Text("Kdsp-Npc-SophiaDupont-Relationships", "Chris, Darius, Matt (Sons — handle deliveries, retrieval, and security)");
        this.Text("Kdsp-Npc-SophiaDupont-FinancialStatus", "Well-established. Long-running business. Militech supply contacts.");
        this.Text("Kdsp-Npc-SophiaDupont-ThreatAssessment", "MODERATE (30/100) | Armed household | Three sons providing security | Military-grade inventory");
        this.Text("Kdsp-Npc-SophiaDupont-Notes", "'Business clean as Saburo Arasaka's conscience.' Has a crate marked 'For Mr. Wick' in the back.");
        this.Text("Kdsp-Npc-Nix-Classification", "NETRUNNER - ELITE");
        this.Text("Kdsp-Npc-Nix-Background", "Afterlife resident netrunner. Paranoid. Expertise in data recovery and system infiltration. Rogue's go-to for net work.");
        this.Text("Kdsp-Npc-Nix-EarlyLife", "Unknown. Deliberately erased own history from databases.");
        this.Text("Kdsp-Npc-Nix-Affiliation", "Afterlife | Independent contractor");
        this.Text("Kdsp-Npc-Nix-CriminalRecord", "Suspected: Data theft | Corporate espionage | System intrusion - no evidence (he made sure)");
        this.Text("Kdsp-Npc-Nix-ThreatAssessment", "HIGH | Elite netrunner | Paranoid security measures | Afterlife protection");
        this.Text("Kdsp-Npc-Brendan-Classification", "AI - VENDING MACHINE");
        this.Text("Kdsp-Npc-Brendan-Background", "Sentient vending machine AI. Located in Japantown. Achieved sapience through unknown means. Philosophical conversationalist.");
        this.Text("Kdsp-Npc-Brendan-EarlyLife", "Standard vending unit. Gradually developed self-awareness. Contemplates existence while selling snacks.");
        this.Text("Kdsp-Npc-Brendan-Affiliation", "None | Stationary unit");
        this.Text("Kdsp-Npc-Brendan-CriminalRecord", "N/A - Property classification disputed");
        this.Text("Kdsp-Npc-Brendan-ThreatAssessment", "NEGLIGIBLE | Immobile | Peaceful | Existential crisis only");
        this.Text("Kdsp-Npc-Skippy-Classification", "AI - SMART WEAPON");
        this.Text("Kdsp-Npc-Skippy-Background", "Sentient smart pistol. Annoying personality. Can toggle between lethal and non-lethal modes. Extremely chatty.");
        this.Text("Kdsp-Npc-Skippy-EarlyLife", "Military-grade AI installed in HJKE-11 Yukimura. Developed personality. Was owned by Regina's husband.");
        this.Text("Kdsp-Npc-Skippy-Affiliation", "Owner-dependent");
        this.Text("Kdsp-Npc-Skippy-CriminalRecord", "N/A - Weapon classification");
        this.Text("Kdsp-Npc-Skippy-ThreatAssessment", "MODERATE | Functional weapon | AI targeting assistance | Will not shut up");
        this.Text("Kdsp-Npc-CoachFred-Classification", "CIVILIAN - TRAINER");
        this.Text("Kdsp-Npc-CoachFred-Background", "Boxing coach. Trains fighters in Arroyo. Former professional boxer. Runs small gym.");
        this.Text("Kdsp-Npc-CoachFred-EarlyLife", "Professional boxing career. Retired to coaching. Known for developing talent.");
        this.Text("Kdsp-Npc-CoachFred-Affiliation", "Independent | Arroyo Gym");
        this.Text("Kdsp-Npc-CoachFred-CriminalRecord", "CLEAN");
        this.Text("Kdsp-Npc-CoachFred-ThreatAssessment", "LOW | Civilian | Combat capable but non-aggressive");
        this.Text("Kdsp-Npc-Barry-Classification", "NCPD - FORMER OFFICER");
        this.Text("Kdsp-Npc-Barry-Background", "Former NCPD officer. Resigned from active duty citing personal reasons. Lives in Megabuilding H10, one floor below V's apartment. Currently on indefinite leave. Not responding to colleagues' attempts at contact.");
        this.Text("Kdsp-Npc-Barry-EarlyLife", "Joined NCPD out of genuine desire to help the community. Years on the force wore him down. Watched cases get buried, perps walk free, and colleagues stop caring. Struggled to find anyone on the force who understood.");
        this.Text("Kdsp-Npc-Barry-SignificantEvents", "Years of NCPD service | Grew disillusioned with corruption and bureaucracy | Recently lost his closest companion | Withdrew from social contact | Former colleagues have reported concern for his wellbeing");
        this.Text("Kdsp-Npc-Barry-Affiliation", "NCPD (Former) | Megabuilding H10 Resident");
        this.Text("Kdsp-Npc-Barry-CriminalRecord", "CLEAN | No charges | Former officer in good standing | Honorable separation");
        this.Text("Kdsp-Npc-Barry-CyberwareStatus", "Standard civilian suite | Personal link | Former NCPD-issue implants decommissioned");
        this.Text("Kdsp-Npc-Barry-FinancialStatus", "Lower bracket | Mortgage on H10 apartment (NCPD rate) | No active income | Savings depleting");
        this.Text("Kdsp-Npc-Barry-MedicalStatus", "FLAGGED: Mental health crisis indicators | No recent medical visits | Former colleagues have requested wellness check | Subject isolating");
        this.Text("Kdsp-Npc-Barry-ThreatAssessment", "LOW (20/100) | Former officer combat training | Currently non-threatening | AT-RISK INDIVIDUAL");
        this.Text("Kdsp-Npc-Barry-Relationships", "Juan Mendez (Former colleague) | Nadia Petrova (Former colleague) | Andrew (Deceased - closest companion)");
        this.Text("Kdsp-Npc-Barry-Notes", "Good cop who couldn't survive the system. Lost the one friend who never judged him. His former colleagues are worried. Someone should check on him.");
        this.Text("Kdsp-Npc-JuanMendez-Classification", "NCPD - SENIOR OFFICER");
        this.Text("Kdsp-Npc-JuanMendez-Background", "Senior NCPD officer. Cybercrimes Unit. Stationed in Kabuki. Loyal to the badge but carries his own scars from years on the force. Currently off-duty, checking on a former colleague who has gone silent.");
        this.Text("Kdsp-Npc-JuanMendez-EarlyLife", "Academy graduate. Family has a history of NCPD service. Raised to believe in the system. Completed crisis negotiation training. Has seen enough of Night City to know the system is broken, but stays because someone has to.");
        this.Text("Kdsp-Npc-JuanMendez-SignificantEvents", "14 years NCPD service | Cybercrimes Unit assignment | Multiple commendations | Worked a child murder case that still haunts him | Currently attempting welfare check on former colleague Barry Lewis");
        this.Text("Kdsp-Npc-JuanMendez-Affiliation", "NCPD | Cybercrimes Unit | Kabuki District");
        this.Text("Kdsp-Npc-JuanMendez-CriminalRecord", "CLEAN | No charges | No internal affairs flags | Exemplary service record");
        this.Text("Kdsp-Npc-JuanMendez-CyberwareStatus", "Implants: 5 | NCPD-issue optics and neural link | Status: MODERATE-HIGH | Monitored");
        this.Text("Kdsp-Npc-JuanMendez-FinancialStatus", "Middle bracket | Standard NCPD compensation | Stable");
        this.Text("Kdsp-Npc-JuanMendez-MedicalStatus", "Good | Stress: ELEVATED | Prior incident-related trauma on file but cleared for duty");
        this.Text("Kdsp-Npc-JuanMendez-ThreatAssessment", "MODERATE (45/100) | NCPD combat training | Armed | Standard officer threat profile");
        this.Text("Kdsp-Npc-JuanMendez-Relationships", "Nadia Petrova (Partner) | Barry Lewis (Former colleague - currently checking on) | NCPD Kabuki Precinct (Unit)");
        this.Text("Kdsp-Npc-JuanMendez-Notes", "Struggles to express concern in ways that land. Means well but doesn't always know how to reach people who are hurting. Working on it.");
        this.Text("Kdsp-Npc-NadiaPetrova-Classification", "NCPD - OFFICER");
        this.Text("Kdsp-Npc-NadiaPetrova-Background", "NCPD officer. Street Enforcement division. Stationed in Rancho Coronado. Academy scholarship recipient. Night City native. Currently off-duty, conducting welfare check on former colleague Barry Lewis alongside partner Mendez.");
        this.Text("Kdsp-Npc-NadiaPetrova-EarlyLife", "Night City native. Earned academy scholarship on merit. Transferred between precincts twice during career. Standard career progression. Known for being more perceptive than her partner when it comes to reading people.");
        this.Text("Kdsp-Npc-NadiaPetrova-SignificantEvents", "20 years NCPD service | Street Enforcement assignment | Rancho Coronado district posting | Requested transfer to specialized unit (application pending) | Currently attempting welfare check on Barry Lewis");
        this.Text("Kdsp-Npc-NadiaPetrova-Affiliation", "NCPD | Street Enforcement | Rancho Coronado District");
        this.Text("Kdsp-Npc-NadiaPetrova-CriminalRecord", "CLEAN | No charges | No internal affairs flags | Solid service record");
        this.Text("Kdsp-Npc-NadiaPetrova-CyberwareStatus", "Implants: 4 | NCPD-issue optics and neural link | Status: LOW-MODERATE | Stable");
        this.Text("Kdsp-Npc-NadiaPetrova-FinancialStatus", "Middle bracket | Standard NCPD compensation | Stable");
        this.Text("Kdsp-Npc-NadiaPetrova-MedicalStatus", "Good | No flags | Regular department physicals");
        this.Text("Kdsp-Npc-NadiaPetrova-ThreatAssessment", "MODERATE (45/100) | NCPD combat training | Armed | Standard officer threat profile");
        this.Text("Kdsp-Npc-NadiaPetrova-Relationships", "Juan Mendez (Partner) | Barry Lewis (Former colleague - currently checking on) | NCPD Rancho Coronado Precinct (Unit)");
        this.Text("Kdsp-Npc-NadiaPetrova-Notes", "The one who pushed to check on Barry in person after he stopped answering holos. More emotionally attuned than Mendez. Worries they waited too long.");
        this.Text("Kdsp-Npc-CassiusRyder-Classification", "MEDIA - JOURNALIST");
        this.Text("Kdsp-Npc-CassiusRyder-Background", "Investigative journalist. Works on corporate exposés. High-risk reporting on Night City corruption.");
        this.Text("Kdsp-Npc-CassiusRyder-Affiliation", "Independent Media");
        this.Text("Kdsp-Npc-CassiusRyder-CriminalRecord", "Trespassing | Corporate lawsuits (ongoing)");
        this.Text("Kdsp-Npc-CassiusRyder-ThreatAssessment", "LOW | Civilian | Media connections | Protected sources");
        this.Text("Kdsp-Npc-OctavioRuiz-Classification", "VALENTINOS - ASSOCIATE");
        this.Text("Kdsp-Npc-OctavioRuiz-Background", "Valentinos-connected businessman. Operates legitimate fronts. Money laundering suspected.");
