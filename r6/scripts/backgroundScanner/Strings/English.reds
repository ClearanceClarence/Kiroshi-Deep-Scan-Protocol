        this.Text("Kdsp-BarghestProfil-S20", "Terra Cognita Border");
        this.Text("Kdsp-BarghestProfil-S21", "Growth District Patrol");
        this.Text("Kdsp-BarghestProfil-S22", "Hansen's HQ Security");
        this.Text("Kdsp-BarghestProfil-S23", "Mobile Response Unit");
        this.Text("Kdsp-BarghestProfil-S24", "Supply Depot Guard");
        this.Text("Kdsp-BarghestProfil-S25", "Deserted during the Unification War. Found purpose in Hansen's vision for Dogtown.");
        this.Text("Kdsp-BarghestProfil-S26", "Went AWOL after refusing illegal orders. NUSA wants them back - dead or alive.");
        this.Text("Kdsp-BarghestProfil-S27", "Fled unit after friendly fire incident. Haunted but effective.");
        this.Text("Kdsp-BarghestProfil-S28", "Dishonorably discharged for excessive force. Hansen appreciates the aggression.");
        this.Text("Kdsp-BarghestProfil-S29", "Medical discharge after severe injuries. Cyberware got them back in the fight.");
        this.Text("Kdsp-BarghestProfil-S30", "Discharged for insubordination. Follows Hansen's orders without question now.");
        this.Text("Kdsp-BarghestProfil-S31", "Professional soldier for hire. Hansen pays well and on time.");
        this.Text("Kdsp-BarghestProfil-S32", "Former PMC operator. Tired of corpo politics, prefers Hansen's direct approach.");
        this.Text("Kdsp-BarghestProfil-S33", "Freelance military contractor. Dogtown offers steady work and no questions.");
        this.Text("Kdsp-BarghestProfil-S34", "True believer in Hansen's free Dogtown. Would die for the cause.");
        this.Text("Kdsp-BarghestProfil-S35", "Hates NUSA government. Sees Barghest as freedom fighters.");
        this.Text("Kdsp-BarghestProfil-S36", "Believes corporations are the enemy. Hansen offers a different path.");
        this.Text("Kdsp-BarghestProfil-S37", "Fled war-torn region. Found new home and purpose with Barghest.");
        this.Text("Kdsp-BarghestProfil-S38", "Family killed in corporate conflict. Barghest is their only family now.");
        this.Text("Kdsp-BarghestProfil-S39", "Escaped corpo black site. Hansen gave them shelter and a gun.");
        this.Text("Kdsp-BarghestProfil-S40", "Wanted in multiple jurisdictions. Dogtown offers sanctuary.");
        this.Text("Kdsp-BarghestProfil-S41", "Former gang soldier. Barghest offered legitimacy and better pay.");
        this.Text("Kdsp-BarghestProfil-S42", "Escaped convict. Hansen doesn't care about the past, only loyalty.");
        this.Text("Kdsp-BarghestProfil-S43", "Couldn't find work after military service. Barghest was the only option.");
        this.Text("Kdsp-BarghestProfil-S44", "Family needed money for medical care. Barghest pays well for combat skills.");
        this.Text("Kdsp-BarghestProfil-S45", "Debt drove them to mercenary work. Hansen cleared the debt for service.");
        this.Text("Kdsp-BarghestProfil-S46", "Recruited directly by Barghest scouts. Skills speak for themselves.");
        this.Text("Kdsp-BarghestProfil-S47", "Impressed Hansen during a firefight. Got an offer they couldn't refuse.");
        this.Text("Kdsp-BarghestProfil-S48", "Recommended by another Barghest veteran. Loyalty vouched for.");
        this.Text("Kdsp-BarghestProfil-S49", "Former NUSA soldier who saw too much corruption. Hansen's truth resonated.");
        this.Text("Kdsp-BarghestProfil-S50", "Ex-Militech operative. Left after being treated as expendable. Hansen values soldiers.");
        this.Text("Kdsp-BarghestProfil-S51", "Former Arasaka security. Tower attack changed everything. Found new purpose.");
