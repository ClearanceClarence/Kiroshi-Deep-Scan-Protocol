        this.Text("Kdsp-Npc-ZariaHughes-ThreatAssessment", "EXTREME | Mantis Blades | Thermal damage | Teleportation capability | Shoot on sight");
        this.Text("Kdsp-Npc-EllisCarter-Classification", "CYBERPSYCHO - ACTIVE");
        this.Text("Kdsp-Npc-EllisCarter-Background", "Former Maelstrom member from old regime. Targeted in internal purge by current leadership. Snapped under pressure.");
        this.Text("Kdsp-Npc-EllisCarter-EarlyLife", "Previously connected to Brick's faction. Survived gang power transition.");
        this.Text("Kdsp-Npc-EllisCarter-Affiliation", "Maelstrom (Former)");
