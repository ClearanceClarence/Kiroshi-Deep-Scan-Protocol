        this.Text("Kdsp-Npc-AsaRisu-Classification", "ARASAKA - ACQUISITIONS");
        this.Text("Kdsp-Npc-AsaRisu-Background", "Arasaka corporate agent specializing in high-value asset acquisition. Handles sensitive negotiations for special projects division.");
