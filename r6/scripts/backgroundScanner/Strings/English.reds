        this.Text("Kdsp-Npc-R3n0-Classification", "NETRUNNER - CORPORATE");
        this.Text("Kdsp-Npc-R3n0-Background", "Corporate netrunner working for Hard Wire Ltd. Sidelines in selling recovered tech on the black market under the alias 'R3n0'.");
        this.Text("Kdsp-Npc-R3n0-EarlyLife", "Technical background. Rose through corporate IT ranks. Developed skills beyond her official job description.");
