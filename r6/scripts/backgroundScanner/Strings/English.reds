        this.Text("Kdsp-FinancialProfi-S375", "Corporate Employee Bank");
        this.Text("Kdsp-FinancialProfi-S376", "Petrochem Financial Services");
        this.Text("Kdsp-FinancialProfi-S377", "Executive Banking Services");
        this.Text("Kdsp-FinancialProfi-S378", "No Bank Account (Cash Only)");
        this.Text("Kdsp-FinancialProfi-S379", "Account Closed - Collections");
        this.Text("Kdsp-FinancialProfi-S380", "Prepaid Card Only");
        this.Text("Kdsp-FinancialProfi-S381", "Check Cashing Services Only");
        this.Text("Kdsp-FinancialProfi-S382", "Night City Savings");
        this.Text("Kdsp-FinancialProfi-S383", "Crypto Wallet Only");
        this.Text("Kdsp-FinancialProfi-S384", "Cash Only - No Records");
        this.Text("Kdsp-FinancialProfi-S385", "Digital First Bank");
        this.Text("Kdsp-FinancialProfi-S386", "Heywood Savings & Loan");
        this.Text("Kdsp-FinancialProfi-S387", "Santo Domingo Credit Union");
        this.Text("Kdsp-FinancialProfi-S388", "NC Municipal Bank");
        this.Text("Kdsp-FinancialProfi-S389", "People's Bank of NC");
        this.Text("Kdsp-FinancialProfi-S390", "Online Bank (App Only)");
        this.Text("Kdsp-FinancialProfi-S391", "Crypto Exchange Account");
        this.Text("Kdsp-FinancialProfi-S392", "Immigrant Services Bank");
        this.Text("Kdsp-FinancialProfi-S393", "Veterans Credit Union");
        this.Text("Kdsp-FinancialProfi-S394", "Workers Solidarity Bank");
        this.Text("Kdsp-FinancialProfi-S395", "Prepaid Card Account");
        this.Text("Kdsp-FinancialProfi-S396", "Check Cashing Services");
        this.Text("Kdsp-FinancialProfi-S397", "Family Member's Account");
        this.Text("Kdsp-FinancialProfi-S398", "Basic Checking Only");
        this.Text("Kdsp-FinancialProfi-S399", "Savings Account Only");
        this.Text("Kdsp-AldecaldosProf-S0", "Solar Tech Maintenance");
        this.Text("Kdsp-AldecaldosProf-S1", "Rocky Ridge Camp");
        this.Text("Kdsp-AldecaldosProf-S2", "Aldecaldo clan tattoo");
        this.Text("Kdsp-AldecaldosProf-S3", "Family memorial marks");
        this.Text("Kdsp-AldecaldosProf-S4", "Calloused mechanic hands");
        this.Text("Kdsp-AldecaldosProf-S5", "Desert sun tan lines");
        this.Text("Kdsp-AldecaldosProf-S6", "Clan beadwork jewelry");
        this.Text("Kdsp-AldecaldosProf-S7", "Born on the road. Aldecaldo blood. The clan is home, wherever the wheels take us.");
        this.Text("Kdsp-AldecaldosProf-S8", "Left Night City's poison. Found family in the Badlands. Nomad life isn't easy, but it's free.");
        this.Text("Kdsp-AldecaldosProf-S9", "Third generation Aldecaldo. Grandparents founded this clan. Legacy means something.");
        this.Text("Kdsp-AldecaldosProf-S10", "Outsider taken in when no one else would. Clan doesn't judge where you're from, only who you become.");
        this.Text("Kdsp-AldecaldosProf-S11", "Former corpo who woke up. Everything they said about nomads was lies. Found truth on the road.");
        this.Text("Kdsp-AldecaldosProf-S12", "Married into the clan. Took time to earn trust. Now would die for familia without hesitation.");
        this.Text("Kdsp-AldecaldosProf-S13", "Orphaned by a Wraith raid. Aldecaldos found the wreckage and a scared kid. Raised as their own.");
        this.Text("Kdsp-AldecaldosProf-S14", "Mechanic who kept a convoy alive through a three-day sandstorm. Earned a permanent spot that night.");
        this.Text("Kdsp-AldecaldosProf-S15", "Ran from a corpo contract on my life. Aldecaldos don't ask questions when someone needs shelter.");
        this.Text("Kdsp-AldecaldosProf-S16", "Grew up fixing solar panels at Rocky Ridge. Every watt of power is a small victory against the wasteland.");
        this.Text("Kdsp-AldecaldosProf-S17", "Former street kid from Heywood. City was eating me alive. The open road healed what concrete broke.");
        this.Text("Kdsp-AldecaldosProf-S18", "Voted into the clan by council after smuggling medical supplies through Militech checkpoints. Actions earned the name.");
        this.Text("Kdsp-AldecaldosProf-S19", "Supply run to Night City. Trade goods for essentials.");
        this.Text("Kdsp-AldecaldosProf-S20", "Camp maintenance. Keeping home in working order.");
        this.Text("Kdsp-AldecaldosProf-S21", "Convoy escort. Getting goods through Wraith territory.");
        this.Text("Kdsp-AldecaldosProf-S22", "Tech salvage in the wastes. One person's trash is our survival.");
        this.Text("Kdsp-AldecaldosProf-S23", "Clan gathering. Family comes first, always.");
        this.Text("Kdsp-AldecaldosProf-S24", "Solar array expansion at Rocky Ridge. More power means more independence.");
        this.Text("Kdsp-AldecaldosProf-S25", "Water purification rig repair. Can't afford downtime in the desert.");
        this.Text("Kdsp-AldecaldosProf-S26", "Negotiating trade deal with a Night City fixer. Fair terms or no deal.");
        this.Text("Kdsp-AldecaldosProf-S27", "Scouting new camp locations. Need to stay ahead of the Wraith patrols.");
        this.Text("Kdsp-AldecaldosProf-S28", "Teaching younger members to drive and shoot. Survival skills are a birthright.");
        this.Text("Kdsp-AnimalsProfile-S0", "Muscle for Hire");
        this.Text("Kdsp-AnimalsProfile-S1", "Fight Pit Champion");
        this.Text("Kdsp-AnimalsProfile-S2", "Cage Match Promoter");
        this.Text("Kdsp-AnimalsProfile-S3", "Street Brawl Enforcer");
        this.Text("Kdsp-AnimalsProfile-S4", "Grand Imperial Mall");
        this.Text("Kdsp-AnimalsProfile-S5", "Pacifica Gym District");
        this.Text("Kdsp-AnimalsProfile-S6", "West Wind Estate");
        this.Text("Kdsp-AnimalsProfile-S7", "Extreme muscle mass");
        this.Text("Kdsp-AnimalsProfile-S8", "Animal brand tattoo");
        this.Text("Kdsp-AnimalsProfile-S9", "Broken nose (multiple times)");
        this.Text("Kdsp-AnimalsProfile-S10", "Gorilla Arms implants");
        this.Text("Kdsp-AnimalsProfile-S11", "Weak once. The juice changed everything. Pack made a beast out of nothing. Strength is all that matters now.");
        this.Text("Kdsp-AnimalsProfile-S12", "Former athlete - career ended by injury. Animals showed how to become stronger than ever. Beyond human limits.");
        this.Text("Kdsp-AnimalsProfile-S13", "Grew up in Pacifica. Only the strong survive. Earned place in the pack through blood and broken bones.");
        this.Text("Kdsp-AnimalsProfile-S14", "Was prey once. Someone else's victim. Never again. The pack protects its own, and destroys everything else.");
        this.Text("Kdsp-AnimalsProfile-S15", "Fighting is the only language that matters. Found family in the pits. Win or die - simple philosophy.");
        this.Text("Kdsp-AnimalsProfile-S16", "Bouncer turned soldier. Security work pays, but the real rush is in the ring. Pack respects winners.");
        this.Text("Kdsp-AnimalsProfile-S17", "Got hooked on the juice working construction. When the site closed, the pack was the only place left.");
        this.Text("Kdsp-AnimalsProfile-S18", "Underground boxing circuit burned out. Animals offered real fights - no refs, no rules, no limits.");
        this.Text("Kdsp-AnimalsProfile-S19", "Sasquatch personally tested during initiation. Survived three rounds. Most don't last one.");
        this.Text("Kdsp-AnimalsProfile-S20", "Corpo gym rat who got bored lifting for vanity. Animals lift for war. Real purpose behind the iron.");
        this.Text("Kdsp-AnimalsProfile-S21", "Pacifica kid who watched VDBs hide behind screens. Wanted to solve problems with fists, not code.");
        this.Text("Kdsp-AnimalsProfile-S22", "Spent two years in a NUSA prison. Came out bigger than when going in. Pack recognized the hunger.");
        this.Text("Kdsp-AnimalsProfile-S23", "Working security at the Grand Imperial Mall. Nobody causes trouble twice.");
        this.Text("Kdsp-AnimalsProfile-S24", "Training for upcoming pit fight. Victory or death - either way, glory.");
        this.Text("Kdsp-AnimalsProfile-S25", "Muscle contract in Pacifica. Client wanted intimidation. Delivered.");
        this.Text("Kdsp-AnimalsProfile-S26", "Juice distribution run. Keeping the pack supplied with the good stuff.");
        this.Text("Kdsp-AnimalsProfile-S27", "Collecting debts. Most people pay when they see us coming. Smart.");
        this.Text("Kdsp-AnimalsProfile-S28", "Cage match tonight in West Wind. Betting pool is already deep.");
        this.Text("Kdsp-AnimalsProfile-S29", "Escorting a fixer through VDB territory. They looked but didn't touch.");
        this.Text("Kdsp-AnimalsProfile-S30", "New juice formula testing. Volunteer batch. Results are promising.");
        this.Text("Kdsp-AnimalsProfile-S31", "Clearing squatters from a building the pack wants. Didn't take long.");
        this.Text("Kdsp-AnimalsProfile-S32", "Recruitment tryouts. Line of wannabes outside the gym. Most won't last.");
        this.Text("Kdsp-GangManager-S0", "Military Equipment Trade");
        this.Text("Kdsp-GangManager-S1", "Sex Worker Protection");
        this.Text("Kdsp-GangManager-S2", "Black Market Surgery");
        this.Text("Kdsp-GangManager-S3", "Local Heywood Community");
        this.Text("Kdsp-GangManager-S4", "Lizzie's Bar Patrons");
        this.Text("Kdsp-GangManager-S5", "Other Nomad Clans");
        this.Text("Kdsp-GangManager-S6", "Luminous tiger stripes (back/arms)");
        this.Text("Kdsp-GangManager-S7", "Japanese kanji (neck)");
        this.Text("Kdsp-GangManager-S8", "Santa Muerte imagery");
        this.Text("Kdsp-GangManager-S9", "Golden heart with thorns");
        this.Text("Kdsp-GangManager-S10", "American flag imagery");
        this.Text("Kdsp-GangManager-S11", "Military unit insignia");
        this.Text("Kdsp-GangManager-S12", "Gang identification marks (various)");
        this.Text("Kdsp-GangManager-S13", "Dark Matter Club");
        this.Text("Kdsp-GangManager-S14", "Japantown Pachinko Parlors");
        this.Text("Kdsp-GangManager-S15", "El Coyote Cojo");
        this.Text("Kdsp-GangManager-S16", "Vista del Rey Streets");
        this.Text("Kdsp-GangManager-S17", "All Foods Plant");
        this.Text("Kdsp-GangManager-S18", "Red Dirt Bar");
        this.Text("Kdsp-GangManager-S19", "Arroyo Gun Ranges");
        this.Text("Kdsp-GangManager-S20", "Veterans Meeting Halls");
        this.Text("Kdsp-GangManager-S21", "Recruited from Japantown youth. Trained in traditional yakuza codes. ");
        this.Text("Kdsp-GangManager-S22", "Former Arasaka security, found better opportunities with the Claws. ");
        this.Text("Kdsp-GangManager-S23", "Born into a family with Tyger Claw ties. Expected to join. ");
        this.Text("Kdsp-GangManager-S24", "Grew up in Heywood, joined for family protection. Devotee of Santa Muerte. ");
        this.Text("Kdsp-GangManager-S25", "Third-generation Valentino. The gang is everything. ");
        this.Text("Kdsp-GangManager-S26", "Sought belonging after losing family. Found it with the Valentinos. ");
        this.Text("Kdsp-GangManager-S27", "Cyberpsychosis survivor. Found acceptance among the similarly augmented. ");
        this.Text("Kdsp-GangManager-S28", "Former corpo techie gone rogue. Now installs illegal chrome. ");
        this.Text("Kdsp-GangManager-S29", "Obsessed with transcending flesh. Maelstrom offered the path. ");
        this.Text("Kdsp-GangManager-S30", "Veteran of the Unification War. Couldn't adjust to civilian life. ");
        this.Text("Kdsp-GangManager-S31", "Believes in protecting the community from corp exploitation. ");
        this.Text("Kdsp-GangManager-S32", "Lost family to gang violence. Joined 6th Street for revenge and order. ");
        this.Text("Kdsp-GangManager-S33", "Former athlete turned muscle. The juice keeps flowing. ");
        this.Text("Kdsp-GangManager-S34", "Respects only strength. Animals offer the ultimate test. ");
        this.Text("Kdsp-GangManager-S35", "Haitian descent, grew up in Pacifica. The Net is the only way forward. ");
        this.Text("Kdsp-GangManager-S36", "Netrunner seeking answers beyond the Blackwall. ");
        this.Text("Kdsp-GangManager-S37", "Gang member with standard recruitment background. ");
        this.Text("Kdsp-GangProfileGen-S0", "Gang member with standard criminal background.");
        this.Text("Kdsp-GangProfileGen-S1", "Active in local operations.");
        this.Text("Kdsp-MaelstromProfi-S0", "Sensory Override Tech");
        this.Text("Kdsp-MaelstromProfi-S1", "Pain Editor Tuning");
        this.Text("Kdsp-MaelstromProfi-S2", "Combat Stimulant Brewing");
        this.Text("Kdsp-MaelstromProfi-S3", "% cybernetic replacement");
        this.Text("Kdsp-MaelstromProfi-S4", "Optical replacements (multiple)");
        this.Text("Kdsp-MaelstromProfi-S5", "Facial chrome plating");
        this.Text("Kdsp-MaelstromProfi-S6", "Full limb conversions");
        this.Text("Kdsp-MaelstromProfi-S7", "Exposed wiring along jawline");
        this.Text("Kdsp-MaelstromProfi-S8", "Vocal modulator distortion");
        this.Text("Kdsp-MaelstromProfi-S9", "Subdermal LED arrays");
        this.Text("Kdsp-MaelstromProfi-S10", "Flesh is weakness. Found truth in chrome and circuitry. The collective showed the way to transcendence.");
        this.Text("Kdsp-MaelstromProfi-S11", "Cyberpsychosis survivor. Others feared the edge - Maelstrom embraced it. Here, the madness is understood.");
        this.Text("Kdsp-MaelstromProfi-S12", "Former corpo techie. Saw what chrome could really do when corps weren't limiting the potential.");
        this.Text("Kdsp-MaelstromProfi-S13", "Born defective. Meat body was failing. Maelstrom offered replacement - piece by piece, becoming perfect.");
        this.Text("Kdsp-MaelstromProfi-S14", "Street doc gone too far. Lost license, found family. Now installs chrome for those worthy of ascension.");
        this.Text("Kdsp-MaelstromProfi-S15", "They took everything in a raid. Rebuilt from scrap and rage. More machine than meat now. Stronger.");
        this.Text("Kdsp-MaelstromProfi-S16", "Flatlined on the operating table. Came back wrong - or came back right. Depends who's asking. Chrome remembers.");
        this.Text("Kdsp-MaelstromProfi-S17", "Worked the All Foods Plant before Brick's time. Watched the collective evolve. Every upgrade brings clarity.");
        this.Text("Kdsp-MaelstromProfi-S18", "Military cyberware went haywire after discharge. Every clinic turned away. Maelstrom said come as you are.");
        this.Text("Kdsp-MaelstromProfi-S19", "Ran with Scavs first. Realized they waste what they take. Maelstrom uses every piece. Efficiency over butchery.");
        this.Text("Kdsp-MaelstromProfi-S20", "Used to hear the machines whispering. Therapists called it psychosis. Maelstrom called it a gift.");
        this.Text("Kdsp-MaelstromProfi-S21", "Totentanz regular turned true believer. The bass broke something open. Chrome filled the cracks.");
        this.Text("Kdsp-MaelstromProfi-S22", "Chrome harvesting operations in Watson. Fresh meat needed.");
        this.Text("Kdsp-MaelstromProfi-S23", "Protecting Totentanz. The bass drops, the bodies drop.");
        this.Text("Kdsp-MaelstromProfi-S24", "Running cyberware through Northside. Military grade.");
        this.Text("Kdsp-MaelstromProfi-S25", "Recruitment drive. Finding those ready for conversion.");
        this.Text("Kdsp-MaelstromProfi-S26", "Territory dispute with Scavs. They take organs. We take everything.");
        this.Text("Kdsp-MaelstromProfi-S27", "Testing prototype optics ripped from an Arasaka shipment. Promising results.");
        this.Text("Kdsp-MaelstromProfi-S28", "Borg conversion ceremony at the plant. Another brother ascends tonight.");
        this.Text("Kdsp-MaelstromProfi-S29", "Raiding a ripperdoc clinic for surgical tools. Ours broke during last install.");
        this.Text("Kdsp-MaelstromProfi-S30", "Flathead recon sweep of Watson tunnels. Mapping new expansion routes.");
        this.Text("Kdsp-MaelstromProfi-S31", "Intercepting Militech chrome transport. Driver was persuaded to cooperate.");
        this.Text("Kdsp-MoxesProfile-S0", "Safe House Ops");
        this.Text("Kdsp-MoxesProfile-S1", "Legal Aid Coordination");
        this.Text("Kdsp-MoxesProfile-S2", "Kabuki Safe Zones");
        this.Text("Kdsp-MoxesProfile-S3", "Watson Worker Districts");
        this.Text("Kdsp-MoxesProfile-S4", "Mox signature style");
        this.Text("Kdsp-MoxesProfile-S5", "Protective sigil tattoos");
        this.Text("Kdsp-MoxesProfile-S6", "Lizzie memorial mark");
        this.Text("Kdsp-MoxesProfile-S7", "Neon hair coloring");
        this.Text("Kdsp-MoxesProfile-S8", "Customized baseball bat");
        this.Text("Kdsp-MoxesProfile-S9", "Survived the streets. Moxes offered protection without price. Now protecting others the same way.");
        this.Text("Kdsp-MoxesProfile-S10", "Worked the clubs before Lizzie's. Saw what happens without protection. Never again - for anyone.");
        this.Text("Kdsp-MoxesProfile-S11", "Lost someone to traffickers. Joined Moxes to make sure it doesn't happen to others.");
        this.Text("Kdsp-MoxesProfile-S12", "Former joytoy who fought back. Moxes welcomed and trained. Now a guardian instead of prey.");
        this.Text("Kdsp-MoxesProfile-S13", "Believed in Lizzie's mission. Her death made it stronger. The cause continues.");
        this.Text("Kdsp-MoxesProfile-S14", "Outsider who proved dedication. Moxes judge by actions, not background. Found family.");
        this.Text("Kdsp-MoxesProfile-S15", "Escaped a Tyger Claw operation. Moxes took in, patched up, and gave a bat. Repaying that debt every day.");
        this.Text("Kdsp-MoxesProfile-S16", "BD editor who saw too many snuff scrolls. Decided to fight the source. Moxes were the only ones who cared.");
        this.Text("Kdsp-MoxesProfile-S17", "Grew up watching friends disappear into trafficking networks. Moxes were the first to actually do something about it.");
        this.Text("Kdsp-MoxesProfile-S18", "Former NCPD who quit when brass buried trafficking cases. Found the Moxes actually enforce justice.");
        this.Text("Kdsp-MoxesProfile-S19", "Transitioned on the streets with no support. Moxes provided safety, medical contacts, and belonging.");
        this.Text("Kdsp-MoxesProfile-S20", "Bartender at Lizzie's who picked up a weapon when Claws came knocking. Never put it back down.");
        this.Text("Kdsp-MoxesProfile-S21", "Running security at Lizzie's. Safe space maintained.");
        this.Text("Kdsp-MoxesProfile-S22", "Escort detail for workers. Getting home safe matters.");
        this.Text("Kdsp-MoxesProfile-S23", "Investigating trafficking reports. Predators don't operate in our territory.");
        this.Text("Kdsp-MoxesProfile-S24", "Community self-defense class. Everyone deserves to feel safe.");
        this.Text("Kdsp-MoxesProfile-S25", "BD production oversight. Ethical content, fair compensation.");
        this.Text("Kdsp-MoxesProfile-S26", "Raided a Scav den near Kabuki. Three workers recovered alive.");
        this.Text("Kdsp-MoxesProfile-S27", "Setting up a new safe house. Location classified, need-to-know only.");
        this.Text("Kdsp-MoxesProfile-S28", "Gathering intel on a Tyger Claw trafficking pipeline. Planning intervention.");
        this.Text("Kdsp-MoxesProfile-S29", "Medical supply run for workers without clinic access. No questions asked.");
        this.Text("Kdsp-MoxesProfile-S30", "Coordinating with a fixer on a client who roughed up a joytoy. Justice pending.");
        this.Text("Kdsp-ScavengersProf-S0", "Black Market Sales");
        this.Text("Kdsp-ScavengersProf-S1", "Cold Storage Management");
        this.Text("Kdsp-ScavengersProf-S2", "Kabuki Back Alleys");
        this.Text("Kdsp-ScavengersProf-S3", "Eastern European prison tattoos");
        this.Text("Kdsp-ScavengersProf-S4", "Chemical staining on hands");
        this.Text("Kdsp-ScavengersProf-S5", "Faint antiseptic smell");
        this.Text("Kdsp-ScavengersProf-S6", "Mismatched salvaged optics");
        this.Text("Kdsp-ScavengersProf-S7", "Came from the old country with nothing. Learned that in Night City, everything has a price - including people.");
        this.Text("Kdsp-ScavengersProf-S8", "Former medical student. Couldn't afford to finish. Found that organs pay better than degrees anyway.");
        this.Text("Kdsp-ScavengersProf-S9", "Survived by being useful to the cell. Morality is a luxury for people with options.");
        this.Text("Kdsp-ScavengersProf-S10", "Debt to the wrong people. Only way out was through. Now too deep to ever leave.");
        this.Text("Kdsp-ScavengersProf-S11", "Sociopath by diagnosis. Found the one job where that's an asset. Cutting comes naturally.");
        this.Text("Kdsp-ScavengersProf-S12", "Family back home needs money. Don't ask where it comes from. Just send it.");
        this.Text("Kdsp-ScavengersProf-S13", "Worked in a corpo organ farm. Laid off. Took the skills freelance. Market's always hungry.");
        this.Text("Kdsp-ScavengersProf-S14", "Human trafficking victim who turned the tables. Learned the business from the inside out.");
        this.Text("Kdsp-ScavengersProf-S15", "Ex-paramedic who realized saving lives paid nothing. Taking them apart pays everything.");
        this.Text("Kdsp-ScavengersProf-S16", "Grew up in the Watson sewers. Nobody notices what happens underground. Perfect for the trade.");
        this.Text("Kdsp-ScavengersProf-S17", "Former Maelstrom who wasn't crazy enough for the chrome cult. Scavs just want product. Simpler.");
        this.Text("Kdsp-ScavengersProf-S18", "Immigrated on a shipping container. The smugglers offered a job on arrival. Didn't have the luxury of saying no.");
        this.Text("Kdsp-ScavengersProf-S19", "Acquisition run in Watson. Fresh inventory needed.");
        this.Text("Kdsp-ScavengersProf-S20", "Processing at the chop shop. Quota to meet.");
        this.Text("Kdsp-ScavengersProf-S21", "Black market delivery. Premium chrome, no questions.");
        this.Text("Kdsp-ScavengersProf-S22", "Site relocation. NCPD got too close to the old spot.");
        this.Text("Kdsp-ScavengersProf-S23", "Scouting new hunting grounds. Supply and demand.");
        this.Text("Kdsp-ScavengersProf-S24", "Cleaning a crime scene. Bleach and patience. No traces left.");
        this.Text("Kdsp-ScavengersProf-S25", "Negotiating with a ripperdoc buyer. Wants specific blood types.");
        this.Text("Kdsp-ScavengersProf-S26", "Baiting a trap in Kabuki. Tourist district - easy pickings.");
        this.Text("Kdsp-ScavengersProf-S27", "Cold storage maintenance. Product spoils if temp fluctuates.");
        this.Text("Kdsp-ScavengersProf-S28", "Disposing of a problem. Someone talked. Someone won't anymore.");
        this.Text("Kdsp-SixthStreetPro-S0", "Santo Domingo Industrial");
        this.Text("Kdsp-SixthStreetPro-S1", "Gun Range District");
        this.Text("Kdsp-SixthStreetPro-S2", "NUSA Army - Unification War");
        this.Text("Kdsp-SixthStreetPro-S3", "NUSA Marines - Border Ops");
        this.Text("Kdsp-SixthStreetPro-S4", "Militech PMC - Corporate Conflicts");
        this.Text("Kdsp-SixthStreetPro-S5", "National Guard - Domestic");
        this.Text("Kdsp-SixthStreetPro-S6", "Private Security - Corp Wars");
        this.Text("Kdsp-SixthStreetPro-S7", "No prior service - Community trained");
        this.Text("Kdsp-SixthStreetPro-S8", "6th Street stars");
        this.Text("Kdsp-SixthStreetPro-S9", "Memorial names - fallen brothers");
        this.Text("Kdsp-SixthStreetPro-S10", "Dog tags (original or replica)");
        this.Text("Kdsp-SixthStreetPro-S11", "Combat action scars");
        this.Text("Kdsp-SixthStreetPro-S12", "Bald eagle chest piece");
        this.Text("Kdsp-SixthStreetPro-S13", "Served in the Unification War. Came home to nothing. 6th Street gave purpose to soldiers forgotten by NUSA.");
        this.Text("Kdsp-SixthStreetPro-S14", "Community was being torn apart by gangs. 6th Street offered protection and asked for loyalty. Fair trade.");
        this.Text("Kdsp-SixthStreetPro-S15", "Father was 6th Street. His father before him. Patriotism and protection run in the family.");
        this.Text("Kdsp-SixthStreetPro-S16", "Lost squad overseas to corpo orders. Found new brothers in Santo Domingo. Fighting for something real now.");
        this.Text("Kdsp-SixthStreetPro-S17", "Ex-Militech. Got tired of corporate wars. 6th Street fights for the neighborhood, not shareholders.");
        this.Text("Kdsp-SixthStreetPro-S18", "Never served, but trained by vets. Earned respect through dedication. Community over everything.");
        this.Text("Kdsp-SixthStreetPro-S19", "Discharged after refusing an unlawful order. Military didn't want heroes. 6th Street does.");
        this.Text("Kdsp-SixthStreetPro-S20", "Grew up watching veterans drink at Red Dirt. Their stories shaped everything. Enlisted at sixteen.");
        this.Text("Kdsp-SixthStreetPro-S21", "Border patrol went sideways. Three friends didn't come home. Came back to Santo Domingo with a purpose.");
        this.Text("Kdsp-SixthStreetPro-S22", "Ran with gangs as a kid. 6th Street pulled out of that life. Gave discipline instead of chaos.");
        this.Text("Kdsp-SixthStreetPro-S23", "Weapons instructor with nowhere to teach. 6th Street needed trainers. Perfect fit for a patriot.");
        this.Text("Kdsp-SixthStreetPro-S24", "Wife was killed in a Valentino crossfire. Picked up a rifle and never put it down. This neighborhood will be safe.");
        this.Text("Kdsp-SixthStreetPro-S25", "Neighborhood watch in Arroyo. Keeping streets safe from predators.");
        this.Text("Kdsp-SixthStreetPro-S26", "Arms deal in progress. Quality military hardware, fair prices.");
        this.Text("Kdsp-SixthStreetPro-S27", "Training new recruits. Standards matter. Discipline saves lives.");
        this.Text("Kdsp-SixthStreetPro-S28", "Territory patrol. Rancho Coronado stays American.");
        this.Text("Kdsp-SixthStreetPro-S29", "Community cookout security. Protecting our people, our way.");
        this.Text("Kdsp-SixthStreetPro-S30", "Weapons maintenance day. Every rifle cleaned, every scope zeroed.");
        this.Text("Kdsp-SixthStreetPro-S31", "Intercepted Valentino scouts in Arroyo. Sent them home with a message.");
        this.Text("Kdsp-SixthStreetPro-S32", "Running a shooting competition at the range. Winner gets a new piece.");
        this.Text("Kdsp-SixthStreetPro-S33", "Escorting a supply truck through contested territory. No incidents.");
        this.Text("Kdsp-SixthStreetPro-S34", "Meeting with city council rep. Negotiating community funding. Politely.");
        this.Text("Kdsp-TygerClawsProf-S0", "Street Racing Circuit");
        this.Text("Kdsp-TygerClawsProf-S1", "Luminous tiger stripes");
        this.Text("Kdsp-TygerClawsProf-S2", "Kanji loyalty marks");
        this.Text("Kdsp-TygerClawsProf-S3", "Full irezumi back piece");
        this.Text("Kdsp-TygerClawsProf-S4", "Neon dragon sleeve");
        this.Text("Kdsp-TygerClawsProf-S5", "Missing finger tip (yubitsume)");
        this.Text("Kdsp-TygerClawsProf-S6", "Subdermal luminous ink (face)");
        this.Text("Kdsp-TygerClawsProf-S7", "Born into Tyger family. The code is everything. Learned to kill before learning to read.");
        this.Text("Kdsp-TygerClawsProf-S8", "Former Arasaka security who found the corporate life too restrictive. The Claws offered freedom and power.");
        this.Text("Kdsp-TygerClawsProf-S9", "Immigrated from Tokyo with nothing. Tyger Claws gave purpose, family, and a future worth fighting for.");
        this.Text("Kdsp-TygerClawsProf-S10", "Street kid from Kabuki. Joined young, rose fast. The neon runs through these veins now.");
        this.Text("Kdsp-TygerClawsProf-S11", "Recruited from Japantown youth. Proved loyalty through blood. Never looked back.");
        this.Text("Kdsp-TygerClawsProf-S12", "Debt to the Claws could only be paid one way - service. Now the debt is someone else's problem.");
        this.Text("Kdsp-TygerClawsProf-S13", "Ran a pachinko parlor that was already Claw territory. Paying protection became joining the family.");
        this.Text("Kdsp-TygerClawsProf-S14", "Father was Shatei, grandfather was Kyodai. Blood obligation. Refusing was never an option.");
        this.Text("Kdsp-TygerClawsProf-S15", "Won a street race in Japantown. Claws noticed. Driving skills got a foot in the door - blade skills kept it open.");
        this.Text("Kdsp-TygerClawsProf-S16", "Former joytoy at Clouds. Saw too much. The Claws offered a new role - one where nobody touches you uninvited.");
        this.Text("Kdsp-TygerClawsProf-S17", "Dishonored a rival gang boss in a card game. Needed protection fast. Tyger Claws respect a good gambler.");
        this.Text("Kdsp-TygerClawsProf-S18", "Served time in a NUSA federal prison. Met Claw brothers inside. Came out with a new family and new purpose.");
        this.Text("Kdsp-TygerClawsProf-S19", "Overseeing BD studio operations in Japantown.");
        this.Text("Kdsp-TygerClawsProf-S20", "Collection runs in Kabuki. Business as usual.");
        this.Text("Kdsp-TygerClawsProf-S21", "Enforcing Arasaka interests in Westbrook.");
        this.Text("Kdsp-TygerClawsProf-S22", "Running security at the clubs. Eyes everywhere.");
        this.Text("Kdsp-TygerClawsProf-S23", "Managing joytoy operations. Premium clientele only.");
        this.Text("Kdsp-TygerClawsProf-S24", "Laundering eddies through pachinko parlors. Clean money, dirty work.");
        this.Text("Kdsp-TygerClawsProf-S25", "Street racing circuit enforcement. House always wins.");
        this.Text("Kdsp-TygerClawsProf-S26", "Meeting with Arasaka contact. New shipment arrangements.");
        this.Text("Kdsp-TygerClawsProf-S27", "Disciplining a member who skimmed off collections. Yubitsume pending.");
        this.Text("Kdsp-TygerClawsProf-S28", "Expanding influence into Charter Hill. New restaurant fronts opening.");
        this.Text("Kdsp-ValentinosProf-S0", "Fencing Stolen Goods");
        this.Text("Kdsp-ValentinosProf-S1", "Vista del Rey");
        this.Text("Kdsp-ValentinosProf-S2", "Heywood territorial markers");
        this.Text("Kdsp-ValentinosProf-S3", "Gold tooth implants");
        this.Text("Kdsp-ValentinosProf-S4", "Rosary bead wrist tattoo");
        this.Text("Kdsp-ValentinosProf-S5", "Valentino cross on neck");
        this.Text("Kdsp-ValentinosProf-S6", "Third generation Valentino. The gold runs in the blood. Heywood is home, familia is everything.");
        this.Text("Kdsp-ValentinosProf-S7", "Grew up on these streets. Valentinos protected the neighborhood when no one else would. Loyalty repaid.");
        this.Text("Kdsp-ValentinosProf-S8", "Lost family to corpo greed. Found new family in the Valentinos. Santa Muerte guides now.");
        this.Text("Kdsp-ValentinosProf-S9", "Started boosting cars young. Valentinos saw potential. Now handling bigger jobs for the familia.");
        this.Text("Kdsp-ValentinosProf-S10", "Came from nothing. Valentinos offered respect, purpose, brotherhood. Would die for these streets.");
        this.Text("Kdsp-ValentinosProf-S11", "Ex-military, returned to Heywood. Skills serve the community now. La familia needed soldiers.");
        this.Text("Kdsp-ValentinosProf-S12", "Crossed the border with nothing but a prayer. Valentinos were the first to offer a hand. Owe them everything.");
        this.Text("Kdsp-ValentinosProf-S13", "Mother lit candles at the Santa Muerte shrine every night. When she died, the Valentinos paid for everything. Blood debt.");
        this.Text("Kdsp-ValentinosProf-S14", "Was a boxer in The Glen. Lost a fixed fight, owed the wrong people. Valentinos settled the debt. Now settling theirs.");
        this.Text("Kdsp-ValentinosProf-S15", "Sicario from way back. Other gangs wanted muscle. Valentinos wanted loyalty. Only one of those earns respect.");
        this.Text("Kdsp-ValentinosProf-S16", "Grew up watching lowriders cruise Vista del Rey. Always knew which crew to ride with. Gold forever.");
        this.Text("Kdsp-ValentinosProf-S17", "Abuela was one of the originals. Her stories built this. Carrying the legacy forward - with honor.");
        this.Text("Kdsp-ValentinosProf-S18", "Holding down Vista del Rey. Nobody moves without paying respects.");
        this.Text("Kdsp-ValentinosProf-S19", "Running product through Heywood. Clean supply, loyal customers.");
        this.Text("Kdsp-ValentinosProf-S20", "Community protection detail. Valentinos watch over their own.");
        this.Text("Kdsp-ValentinosProf-S21", "Enforcing honor debts. Some lessons taught with gold, others with lead.");
        this.Text("Kdsp-ValentinosProf-S22", "Car acquisition specialist. High-end vehicles for high-end clients.");
        this.Text("Kdsp-ValentinosProf-S23", "Organizing the Santa Muerte procession. The dead walk with us tonight.");
        this.Text("Kdsp-ValentinosProf-S24", "Lowrider meet in The Glen. Business and pleasure. Mostly business.");
        this.Text("Kdsp-ValentinosProf-S25", "Settling a blood feud between two Valentino families. Delicate work.");
        this.Text("Kdsp-ValentinosProf-S26", "Expanding into Wellsprings. New territory means new revenue.");
        this.Text("Kdsp-ValentinosProf-S27", "Weapons cache resupply from a Militech contact. Premium iron at family prices.");
        this.Text("Kdsp-VoodooBoysProf-S0", "Deep Net Diving");
        this.Text("Kdsp-VoodooBoysProf-S1", "Dead Drop Networks");
        this.Text("Kdsp-VoodooBoysProf-S2", "Rogue AI Containment");
        this.Text("Kdsp-VoodooBoysProf-S3", "Community Net Access");
        this.Text("Kdsp-VoodooBoysProf-S4", "Net Cafe Row");
        this.Text("Kdsp-VoodooBoysProf-S5", "Veve ritual scarification");
        this.Text("Kdsp-VoodooBoysProf-S6", "Netrunning interface ports");
        this.Text("Kdsp-VoodooBoysProf-S7", "Haitian spiritual symbols");
        this.Text("Kdsp-VoodooBoysProf-S8", "Bloodshot eyes from deep dives");
        this.Text("Kdsp-VoodooBoysProf-S9", "Neural burn scarring at temples");
        this.Text("Kdsp-VoodooBoysProf-S10", "Protective gris-gris charms");
        this.Text("Kdsp-VoodooBoysProf-S11", "Born in Pacifica to Haitian parents. The Net is the loa now - spirits in the machine. Seeking truth beyond the Blackwall.");
        this.Text("Kdsp-VoodooBoysProf-S12", "Refugee from the islands. Found community in Pacifica. The Voodoo Boys protect their own - in meat and in Net.");
        this.Text("Kdsp-VoodooBoysProf-S13", "Touched the other side during a deep dive. Something spoke back. Now searching for answers only VDBs understand.");
        this.Text("Kdsp-VoodooBoysProf-S14", "Grew up with a deck in hand. Natural talent caught Brigitte's attention. Trained in ways outsiders never see.");
        this.Text("Kdsp-VoodooBoysProf-S15", "Outsider who proved loyalty. Rare for non-Haitians. The spirits accepted - that's what matters.");
        this.Text("Kdsp-VoodooBoysProf-S16", "Lost family to corpo data theft. Learned to fight back in the Net. VDBs gave purpose to the rage.");
        this.Text("Kdsp-VoodooBoysProf-S17", "Grandmother was a real mambo back in Haiti. Said the loa would find new homes. She was right - they live in the Net.");
        this.Text("Kdsp-VoodooBoysProf-S18", "NetWatch killed a friend during a raid. Pacifica doesn't forget. The Blackwall is their weapon - it will be ours.");
        this.Text("Kdsp-VoodooBoysProf-S19", "Grew up in the ruins when Pacifica was abandoned. No corps came to help. VDBs built something from nothing.");
        this.Text("Kdsp-VoodooBoysProf-S20", "Flatlined during a deep dive and saw what waits beyond. Came back different. The others understand.");
        this.Text("Kdsp-VoodooBoysProf-S21", "Former corpo netrunner who discovered what NetWatch really guards. Defected to the only people seeking real answers.");
        this.Text("Kdsp-VoodooBoysProf-S22", "Second generation Pacifica. Parents built this community with bare hands. Protecting it with code and will.");
        this.Text("Kdsp-VoodooBoysProf-S23", "Deep Net reconnaissance. Mapping pathways to the Blackwall.");
        this.Text("Kdsp-VoodooBoysProf-S24", "Information extraction contract. Client pays well, asks no questions.");
        this.Text("Kdsp-VoodooBoysProf-S25", "Protecting Pacifica servers. Outsiders keep probing. Keep failing.");
        this.Text("Kdsp-VoodooBoysProf-S26", "Ritual dive scheduled. Contacting the other side requires preparation.");
        this.Text("Kdsp-VoodooBoysProf-S27", "Training new runners. Knowledge passes to the worthy.");
        this.Text("Kdsp-VoodooBoysProf-S28", "Intercepted NetWatch probe near Coastview. Traced and neutralized.");
        this.Text("Kdsp-VoodooBoysProf-S29", "Daemon deployment across Night City infrastructure. Sleeper protocol.");
        this.Text("Kdsp-VoodooBoysProf-S30", "Community network maintenance. Pacifica stays connected on our terms.");
        this.Text("Kdsp-VoodooBoysProf-S31", "Encrypted data auction. Corpo secrets fetch premium prices.");
        this.Text("Kdsp-VoodooBoysProf-S32", "Blackwall fluctuation detected. Council convened. Something is changing.");
        this.Text("Kdsp-WraithsProfile-S0", "Fuel Depot Raids");
        this.Text("Kdsp-WraithsProfile-S1", "Fuel Station Network");
        this.Text("Kdsp-WraithsProfile-S2", "Wraith skull brand");
        this.Text("Kdsp-WraithsProfile-S3", "Road rash scarring");
        this.Text("Kdsp-WraithsProfile-S4", "Teeth filed to points");
        this.Text("Kdsp-WraithsProfile-S5", "Born in the wastes. Civilization is a lie the corps tell. Out here, only strength matters.");
        this.Text("Kdsp-WraithsProfile-S6", "Former nomad who got a taste for blood. Clan kicked out. Wraiths welcomed.");
        this.Text("Kdsp-WraithsProfile-S7", "Escaped from somewhere bad. Found freedom on the highway. Take what you need, burn the rest.");
        this.Text("Kdsp-WraithsProfile-S8", "NUSA deserter. Military training serves a better purpose now - raiding convoys.");
        this.Text("Kdsp-WraithsProfile-S9", "Grew up in the camps. Raiding is life. The soft city folk are just prey.");
        this.Text("Kdsp-WraithsProfile-S10", "Lost everything to corps. Found purpose in making them bleed, one convoy at a time.");
        this.Text("Kdsp-WraithsProfile-S11", "Aldecaldos exile. Broke the clan code. Only Raffen Shiv take in the truly damned.");
        this.Text("Kdsp-WraithsProfile-S12", "Survived a Wraith raid as a kid. Figured the winning side was the right side. Joined the pack.");
        this.Text("Kdsp-WraithsProfile-S13", "Ran a fuel station in the Badlands. Wraiths taxed it dry. Joined because fighting them was suicide.");
        this.Text("Kdsp-WraithsProfile-S14", "Prison transport got ambushed by Wraiths. They opened the cage and offered a choice. Easy decision.");
        this.Text("Kdsp-WraithsProfile-S15", "Mechanic who keeps the war rigs running. They don't raid without working wheels. That makes this role essential.");
        this.Text("Kdsp-WraithsProfile-S16", "Crossed the border alone on foot. Wraiths found the body count left behind. Impressed enough to recruit.");
        this.Text("Kdsp-WraithsProfile-S17", "Convoy interception on I-9. Good haul, no survivors.");
        this.Text("Kdsp-WraithsProfile-S18", "Camp fortification. NCPD getting bold lately.");
        this.Text("Kdsp-WraithsProfile-S19", "Hostage situation. Ransom negotiations ongoing.");
        this.Text("Kdsp-WraithsProfile-S20", "Vehicle raid. Need more wheels for the pack.");
        this.Text("Kdsp-WraithsProfile-S21", "Scouting nomad routes. Fresh targets incoming.");
        this.Text("Kdsp-WraithsProfile-S22", "Fuel depot seizure. Controlling supply means controlling the Badlands.");
        this.Text("Kdsp-WraithsProfile-S23", "Setting spike strips on Highway 9. Corpo transport expected at dawn.");
        this.Text("Kdsp-WraithsProfile-S24", "Stripping a captured Militech AV for parts. Worth a fortune.");
        this.Text("Kdsp-WraithsProfile-S25", "Raiding an abandoned settlement. Supplies and potential recruits.");
        this.Text("Kdsp-WraithsProfile-S26", "War rig maintenance. The fleet needs to be ready for the next big score.");
        this.Text("Kdsp-MedicalHistory-S0", "Liver damage (alcohol-related)");
        this.Text("Kdsp-MedicalHistory-S1", "Cirrhosis - early stage");
        this.Text("Kdsp-MedicalHistory-S2", "Wernicke-Korsakoff syndrome (early)");
        this.Text("Kdsp-MedicalHistory-S3", "Fatty liver disease");
        this.Text("Kdsp-MedicalHistory-S4", "Cardiac arrhythmia (stimulant abuse)");
        this.Text("Kdsp-MedicalHistory-S5", "Nasal septum damage");
        this.Text("Kdsp-MedicalHistory-S6", "Stimulant-induced anxiety disorder");
        this.Text("Kdsp-MedicalHistory-S7", "Stimulant psychosis (recurring)");
        this.Text("Kdsp-MedicalHistory-S8", "Bruxism (teeth grinding)");
        this.Text("Kdsp-MedicalHistory-S9", "Malnutrition (appetite suppression)");
    }

