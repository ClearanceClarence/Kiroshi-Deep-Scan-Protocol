        this.Text("Kdsp-Npc-JesseSabara-Classification", "CRIMINAL - NCPD TARGET");
        this.Text("Kdsp-Npc-JesseSabara-Background", "NCPD target with active warrants. Known to operate in Night City criminal circles.");
        this.Text("Kdsp-Npc-JesseSabara-CriminalRecord", "NCPD WARRANT | Multiple offenses");
        this.Text("Kdsp-Npc-JesseSabara-ThreatAssessment", "MODERATE | Armed suspect | May have backup");
        this.Text("Kdsp-Npc-StanislausZbyszko-Classification", "CRIMINAL - SCAVENGER CAPTAIN");
        this.Text("Kdsp-Npc-StanislausZbyszko-Background", "Known captain amongst scavengers. Multiple smuggling priors. Eastern European origin.");
        this.Text("Kdsp-Npc-StanislausZbyszko-Affiliation", "Scavengers (Leadership)");
        this.Text("Kdsp-Npc-StanislausZbyszko-CriminalRecord", "NCPD PRIORITY | Scavenger captain | Smuggling | Cyberware trafficking | Kidnapping");
