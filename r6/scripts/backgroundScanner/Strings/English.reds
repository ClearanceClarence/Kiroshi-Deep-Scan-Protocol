        this.Text("Kdsp-Npc-LtMower-Classification", "CYBERPSYCHO - MILITECH");
        this.Text("Kdsp-Npc-LtMower-Background", "Militech Lieutenant. Suffered cyberpsychosis after military-grade cyberware installation. Contacted Dr. Sypura for help but Militech sent termination squad instead.");
