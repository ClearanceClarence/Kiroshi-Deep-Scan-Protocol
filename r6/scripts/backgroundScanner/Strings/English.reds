        this.Text("Kdsp-Npc-JermaineNorton-Classification", "SECURITY - CIVILIAN");
        this.Text("Kdsp-Npc-JermaineNorton-Background", "Head bouncer at The Riot nightclub. Former amateur boxer. Controls door access and maintains order. Respects street cred.");
