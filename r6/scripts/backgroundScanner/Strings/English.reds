        this.Text("Kdsp-Npc-RalphLogan-Classification", "CIVILIAN - SERVICE");
        this.Text("Kdsp-Npc-RalphLogan-Background", "Head bartender at The Riot nightclub in Little China. Well-connected within the club scene. Known for discretion - for the right price.");
        this.Text("Kdsp-Npc-RalphLogan-EarlyLife", "Worked various bars across Watson. Rose to head bartender at Riot through reliability and ability to keep secrets.");
