        this.Text("Kdsp-BackstoryManag-S145", "⊘ FLAGGED: Badge credentials do not match NCPD central registry. Suspected impersonation of law enforcement.");
        this.Text("Kdsp-BackstoryManag-S146", "⊘ FLAGGED: Officer ID returns INVALID on NCPD verification. Criminal record found under alternate identity.");
        this.Text("Kdsp-BackstoryManag-S147", "⊘ FLAGGED: NCPD Internal Affairs alert. Badge number registered to deceased officer. Identity theft suspected.");
        this.Text("Kdsp-BackstoryManag-S148", "⊘ FLAGGED: Uniform and equipment traced to black market sale. No academy graduation record on file.");
        this.Text("Kdsp-BackstoryManag-S149", "⊘ FLAGGED: Cross-referencing biometrics with NCPD personnel database — ZERO MATCH. This individual is not NCPD.");
        this.Text("Kdsp-BackstoryManag-S150", "⊘ FLAGGED: Credentials forged. Badge serial reported stolen 3 months ago. Armed and operating under false authority.");
        this.Text("Kdsp-BackstoryManag-S151", "Prior arrests for fraud, impersonation, and identity theft. Known associate of fixers operating in Watson and Santo Domingo.");
        this.Text("Kdsp-BackstoryManag-S152", "Former security contractor. Dismissed for misconduct. Multiple identity fraud convictions on record.");
        this.Text("Kdsp-BackstoryManag-S153", "No legitimate law enforcement background. Street-level criminal with access to stolen NCPD equipment.");
        this.Text("Kdsp-BackstoryManag-S154", "Washed out of NCPD academy. Failed psych evaluation. Obtained badge and uniform through black market contacts.");
        this.Text("Kdsp-BackstoryManag-S155", "Currently operating as fake officer. Suspected involvement in shakedowns, illegal searches, and evidence planting.");
        this.Text("Kdsp-BackstoryManag-S156", "Using stolen credentials to conduct unauthorized stops. Multiple civilian complaints filed against badge number.");
        this.Text("Kdsp-BackstoryManag-S157", "Suspected of running protection racket under NCPD cover. Internal Affairs has open investigation.");
        this.Text("Kdsp-BackstoryManag-S158", "Operating in gang territory with forged credentials. Possibly collecting intel for a fixer or running extortion.");
        this.Text("Kdsp-BackstoryManag-S159", "⊘ CREDENTIALS INVALID | Badge: STOLEN/FORGED | NCPD Central Registry: NO MATCH | Status: IMPERSONATING OFFICER");
        this.Text("Kdsp-BackstoryManag-S160", "Status: WANTED | Impersonation of law enforcement, Armed fraud, Identity theft");
